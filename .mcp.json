{
  "mcpServers": {
    "opal-agent-comms": {
      "command": "python",
      "args": ["org/mcp/server.py"]
    },
    "deck-generation": {
      "command": "python",
      "args": ["deck_generation/mcp_server/server.py"]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.75",
        "--headless",
        "--config",
        ".tools/playwright-mcp-config.json"
      ]
    }
  }
}
