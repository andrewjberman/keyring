#!/usr/bin/env bash
# comp-dispatch -- the gold-dispatch ORCHESTRATION-DAG tool (NFRA_COMPROUTE Stage-1 #1).
#
# The CHAIN/orchestration-grain sibling to comp-pipescript's per-SCRIPT grain (CTO ruling
# 2026-07-01: distinct one-home node -- different grain + concern -> sibling, not a subcommand).
# Parses gold_dispatch.sh's declared blocks (CATALOG heredoc + CHAIN_*/GROUP_* ordered-ID vars +
# named gates) -- read-only, never executes the bash. Tracked impl: org/modules/graph/comp_dispatch.py
# (.tools/ is gitignored, the comp-tool convention).
#
# Usage:
#   comp-dispatch <firm>                 # full dispatch map (chains/groups/catalog/gates/undispatched)
#   comp-dispatch <firm> --chain <name>  # one chain expanded to its ordered script list
#   comp-dispatch <firm> --script <ID>   # which chains/groups include a script
#   comp-dispatch <firm> --gates         # the conditional skips + overrides
#   comp-dispatch <firm> --undispatched  # gold-dir scripts NOT in any chain (standalone diagnostics)
#   comp-dispatch --list [--json]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if git_top="$(git -C "${SCRIPT_DIR}" rev-parse --show-toplevel 2>/dev/null)"; then
    WORKSPACE_ROOT="${git_top}"
else
    WORKSPACE_ROOT="/c/Users/AndrewBerman/Desktop/ajb_workspace"
fi

exec "${COMP_PYTHON:-python}" "${WORKSPACE_ROOT}/org/modules/graph/comp_dispatch.py" "$@"
