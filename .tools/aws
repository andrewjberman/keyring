#!/usr/bin/env bash
# aws -- MSYS path-mangling guard shim (Andrew-direct 2026-07-13, 0.8.0_AE_CloudComp).
#
# THE CLASS THIS KILLS: Git Bash (MSYS) rewrites leading-/ arguments at the bash->native-exe
# boundary, silently corrupting AWS NAMESPACE args -- /ecs/... log groups, /aws/lambda/...,
# SSM /param/paths -- into C:/Program Files/Git/... paths. The call then errors (or worse,
# returns empty and reads as "resource absent"). Months of recurring cost; CLAUDE.md's prose
# remedy ("use PowerShell for leading-/ aws args") taxes every session and is forgotten.
#
# THE MECHANISM: MSYS mangles only when bash invokes a NATIVE exe. This shim is a BASH script,
# so it receives argv UNMANGLED (bash->bash crossing converts nothing). It then:
#   1. converts ONLY genuine local paths itself (drive-letter POSIX form /c/... or a path that
#      exists on disk), preserving the old behavior where it was actually wanted;
#   2. passes every other leading-/ arg LITERAL (the AWS namespace args -- the fix);
#   3. execs the real AWS entry with MSYS_NO_PATHCONV=1 so MSYS converts NOTHING further.
#      The launcher-breakage CLAUDE.md warns about (bare MSYS_NO_PATHCONV=1 aws) is sidestepped
#      by invoking the real entry with a WINDOWS-FORM script path via python.exe directly.
#
# SCOPE: Git Bash only. PowerShell never resolves this file (extensionless, no PATHEXT match)
# and keeps resolving Scripts\aws.cmd -- PowerShell was never broken and stays untouched.
#
# DEBUG: AWS_SHIM_DEBUG=1 aws <args...>  -> prints the resolved argv, does NOT execute.
# ROLLBACK: delete this file; bash falls back to the Python Scripts launcher (pre-shim state).
#
# Tracked implementation + design brief:
#   org/tier2_senior/0.8.0_AE_CloudComp/deliverables/AWS_SHIM_MSYS_MANGLING_20260713.md
# CORRECTED 2026-07-25 (NFRA_TOOLARCH.PATHFIX): this file and aws.cmd ARE git-tracked (confirmed
# via `git ls-files`) -- the prior line here claiming "gitignored" was stale/false, superseded by
# CLAUDE.md's own record that both were made tracked at 789c291ba specifically because being
# untracked/invisible-to-git is how a prior version of this exact shim broke silently.
set -uo pipefail

# ---- resolve the REAL aws entry (first `aws` on PATH that is not this shim) ----------------
# NFRA_TOOLARCH.PATHFIX regression (CVO~Z, 2026-07-25, verifying b519fb1c2e): ~/bin holds this
# workspace's own bootstrap forwarder (.tools/provision-path-shims.sh), a BASH script that
# re-invokes `aws` by name after stripping ~/bin from ITS OWN search path (to stop the exact
# loop this file's search could otherwise create). That guard only covers ~/bin -> .tools/aws --
# invoking THIS file directly (the explicit-prefix convention CLAUDE.md documents as the interim
# PATH fallback) never goes through the forwarder, so ~/bin was still on PATH here, the search
# below could pick ~/bin/aws as "the real aws," and dispatch a BASH script to python (SyntaxError,
# diagnosis landing on the wrong file). Mirrored fix: strip ~/bin from THIS search too, in both
# directions of the pair, not just the direction that happened to get tested first.
_self="${BASH_SOURCE[0]}"
_search_path="$(printf '%s' "$PATH" | tr ':' '\n' | grep -Fxv "$HOME/bin" | paste -sd: -)"
REAL=""
while IFS= read -r c; do
    [ "$c" = "$_self" ] && continue
    case "$c" in */.tools/aws) continue ;; esac
    REAL="$c"; break
done < <(PATH="$_search_path" which -a aws 2>/dev/null)
if [ -z "$REAL" ]; then
    echo "aws-shim ERROR: no real aws launcher found on PATH beyond the shim" >&2
    exit 127
fi

# ---- selective arg conversion: local paths convert, AWS namespace args pass literal ---------
_convert_if_local() {
    # $1 = a leading-/ path candidate. Convert iff drive-letter POSIX form (/c/...) or it exists
    # locally in the MSYS view. Everything else (e.g. /ecs/globgrph, /aws/lambda/x) is LITERAL.
    local p="$1"
    if [[ "$p" =~ ^/[A-Za-z]/ ]] || [ -e "$p" ]; then
        cygpath -w "$p" 2>/dev/null || printf '%s' "$p"
    else
        printf '%s' "$p"
    fi
}

args=()
for a in "$@"; do
    case "$a" in
        file:///*|fileb:///*)
            scheme="${a%%//*}//"
            p="${a#*//}"
            args+=("${scheme}$(_convert_if_local "$p")")
            ;;
        /)
            # A LONE "/" is an argument VALUE (e.g. `--delimiter /` for S3 key grouping),
            # never a local path -- no aws call takes the MSYS root as an argument. Without
            # this branch, [ -e / ] is true and the root converts to C:\Program Files\Git\,
            # so the CLI groups on a delimiter matching nothing: CommonPrefixes=[] at rc=0,
            # a silent-absence result (exercised by 0.5.0_AE, 2026-07-22).
            args+=("/")
            ;;
        /*)
            args+=("$(_convert_if_local "$a")")
            ;;
        *)
            args+=("$a")
            ;;
    esac
done

if [ "${AWS_SHIM_DEBUG:-0}" = "1" ]; then
    printf 'aws-shim real-entry: %s\n' "$REAL"
    printf 'aws-shim argv: '
    printf '[%s] ' "${args[@]}"
    printf '\n'
    exit 0
fi

# ---- exec: NOTHING further converts (MSYS_NO_PATHCONV=1); launcher gets a Windows-form path --
#
# DISPATCH ON WHAT THE FILE *IS*, NOT WHAT IT IS *CALLED* (fixed 2026-07-29; found and
# post-fix-confirmed by 0.0.0_AB_MSTR~Z, amb-z-0006 / amb-z-0007).
#
# THE BUG: this used to branch on the `*.exe` FILENAME SUFFIX. On a box with AWS CLI v2,
# `which -a aws` returns TWO entries and the EXTENSIONLESS ALIAS COMES FIRST
# (.../AWSCLIV2/aws, then .../AWSCLIV2/aws.exe). The resolver above breaks on the first
# hit, so $REAL carried no .exe, the *.exe arm did not match, and the fallback ran
# `python` against a NATIVE PE BINARY:
#     SyntaxError: Non-UTF-8 code starting with '\x90' in file ...\AWSCLIV2\aws.exe
# The \x90 is the PE header -- python being handed a compiled launcher as SOURCE. The
# AWSCLIV2 directory contains ONLY aws.exe; the extensionless name is a PATHEXT-resolved
# alias that `which` reports for a file that does not exist under that name.
#
# WHY IT IS THE SAME CLASS AS THE PATH BUGS (~Z's framing, and it is the better one): the
# launchers baked WHERE THEY WERE at write time; this baked WHAT SOMETHING IS. `*.exe` is a
# write-time TEXTUAL property standing in for "is this a native binary?", which is a
# RUN-TIME property of the file's CONTENT. A path-flavor audit could never find it, because
# the defect contains no path literal.
#
# THE FIX: read the first two bytes. `MZ` is the DOS/PE magic -- every Windows native
# executable starts with it, whatever it is named. Falls back to the suffix test only when
# the file cannot be read, so behaviour on an unreadable path is unchanged.
_is_native_pe() {
    [ -r "$1" ] || return 1
    [ "$(head -c 2 "$1" 2>/dev/null)" = "MZ" ]
}

if _is_native_pe "$REAL" || [ "${REAL%.exe}" != "$REAL" ]; then
    MSYS_NO_PATHCONV=1 exec "$REAL" "${args[@]}"
else
    # pip-installed python-script entry: invoke via python with the WINDOWS-FORM script path
    # (this is exactly why bare `MSYS_NO_PATHCONV=1 aws` breaks -- the shebang hop hands
    # python an unconverted POSIX path; we hand it a Windows one).
    MSYS_NO_PATHCONV=1 exec python "$(cygpath -w "$REAL")" "${args[@]}"
fi
