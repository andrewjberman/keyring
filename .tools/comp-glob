#!/usr/bin/env python3
"""comp-glob -- RETIRED NAME, now a forwarder onto `comp-find --name` (Andrew-direct 2026-08-28,
"how it ties into comp-grep/glob as a forwarder"; brief docs/architecture/COMP_FIND_MECHANICS.md).

comp-find --name is the graded, paged, corpus-aware file finder (same enumerator, printed
denominator, HEAD band for filename hits). This forwarder maps the 2026-06-22 comp-glob surface onto
it and prints ONE WARN line so the habit corrects itself. The original body is in git history
(`git show a13f7445a5:.tools/comp-glob`).

Flag map:  <glob> [pathspec ...] -> --name '<glob>' [pathspec ...]
           --glob P -> --name P   |   --max N -> --limit N   |   --include-held -> passthrough
           no pattern, one existing path -> --name '*' <path>   (list everything under it)
"""
from __future__ import annotations

import os
import subprocess
import sys


def _looks_like_glob(s: str) -> bool:
    return any(c in s for c in "*?[")


def main() -> int:
    argv = sys.argv[1:]
    here = os.path.dirname(os.path.abspath(__file__))
    target = os.path.join(here, "comp-find")
    ws = os.path.dirname(here)
    if argv and argv[0] in ("-h", "--help"):
        print("comp-glob is RETIRED -> forwards to comp-find --name. Use: comp-find --name '<glob>' [pathspec ...]")
        print("  (comp-find --help for the graded/paged/corpus flags)")
        return 0
    pattern = None
    passthrough: list[str] = []
    positional: list[str] = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--glob":
            i += 1
            pattern = argv[i] if i < len(argv) else None
        elif a == "--max":
            i += 1
            passthrough.extend(["--limit", argv[i] if i < len(argv) else "25"])
        elif a.startswith("-"):
            passthrough.append(a)
        else:
            positional.append(a)
        i += 1
    if pattern is None and positional:
        first = positional[0]
        if _looks_like_glob(first) or not os.path.exists(os.path.join(ws, first)):
            pattern = positional.pop(0)      # native-Glob ergonomics: first glob-looking positional = the pattern
    if pattern is None:
        pattern = "*"                         # no pattern = list everything under the pathspec(s)
    out = ["--name", pattern, *positional, *passthrough]
    print("WARN: comp-glob is retired (2026-08-28); forwarding to: comp-find " + " ".join(out), file=sys.stderr)
    try:
        return subprocess.call([sys.executable, target, *out])
    except OSError as e:
        print(f"ERROR: could not run comp-find at {target}: {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
