#!/usr/bin/env python3
"""
comp-heat -- estate OBJECT write-freshness + hygiene surface (NFRA_HEATMAP_OBJECT).

The canonical comp-tool over the heat_map engine (org/modules/heatmap/, NFRA_EXPAND Strand-C):
answers the estate-cognition questions -- "what's stale / safe to archive?", "what have I
written that isn't committed?", "how hot is this item?" -- that Rule 21 routes through a
relationship-aware tool rather than raw `git status` / `git log --name-only` / `find -mtime`
(text-local, connection-blind).

ADVISORY-ONLY + READ-ONLY: comp-heat SCORES / CLUSTERS / FLAGS. It never recommends-to-delete
(that is O3, separately guardrailed) and never writes to the repo or any store -- the snapshot is
derived-on-demand from git (git IS the write-history), not a persisted time-series. Inherits the
NFRA_DEBTSCAN never-auto-delete + blast-radius verify-before-recommend doctrine.

NAME NOTE -- distinct from `comp-freshness`:
  comp-freshness = DATA-PIPELINE freshness (S3/DDB artifact + chain staleness for gold runs).
  comp-heat      = REPO/ESTATE OBJECT write-freshness + hygiene (this tool).
The two are complementary; both help texts cross-link.

Usage:
  comp-heat freshness [path] [--half-life N] [--top N] [--json [OUT]]
        per-path hot/warm/cold + ranked COLD SUBTREES (archive candidates). [O1 build]
        path = subtree to scope to (default: the repo root / whole estate).
  comp-heat drift [--top N] [--json [OUT]]
        WRITES NOT IN A COMMIT (untracked + modified working-tree, freshest first) -- the
        LOCAL->GIT layer. "what have I written that isn't committed?" [O1 uncommitted_writes]
  comp-heat score <id> --age-days N [--half-life N] [--json]
        ad-hoc S0 heat score for one item (diagnostic). [S0 score_item]
  comp-heat --help

Composition (do NOT duplicate): `comp-heat drift` is LOCAL->GIT only. The GIT->DEPLOY hop --
committed code whose served artifact is older = undeployed -- is `comp-pipescript deployed`
(MATCH/STALE/MISSING) + `comp-freshness`. Chain them for the full local->git->deploy view.

Author: 1.0.0_SA_CTO (comp-tool registry). Spec: 0.4.0_DS (docs/briefs/comp-heat-tool-spec-for-cto-20260625.md).
Engine: org/modules/heatmap/{heat_map.py (S0), object_freshness.py (O1)} (0.4.0_DS, dac519c88).
"""

from __future__ import annotations

import argparse
import datetime as _dt
import json
import os
import sys

_HERE = os.path.dirname(os.path.abspath(__file__))
REPO_ROOT = os.path.dirname(_HERE)                       # .tools/ -> repo root
HEATMAP_DIR = os.environ.get("COMP_HEATMAP_DIR", os.path.join(REPO_ROOT, "org", "modules", "heatmap"))

STATE_ABSENT = "SUBJECT_ABSENT_FROM_CORPUS"
STATE_ZERO = "PRESENT_WITH_ZERO_RESULTS"
STATE_PARTIAL = "PARTIAL_OR_BLIND"
STATE_NA = "NOT_APPLICABLE"
RC_BY_STATE = {STATE_ABSENT: 2, STATE_ZERO: 0, STATE_PARTIAL: 3, STATE_NA: 1}


def _vintage():
    """The JSON carrier's measurement time; consumers need not infer it from a file mtime."""
    return {"measured_at_utc": _dt.datetime.now(_dt.timezone.utc).isoformat().replace("+00:00", "Z"),
            "source": "git-history-derived heatmap"}


def _write_json(a, payload):
    text = json.dumps(payload, indent=2)
    if a.json is True or a.json == "":
        print(text)
    else:
        with open(a.json, "w", encoding="utf-8") as fh:
            fh.write(text)
        print(f"OK: wrote freshness snapshot -> {a.json}")


def _state_result(a, state, message):
    """One machine-readable exceptional answer, never an empty structure read as clean."""
    payload = {"answer_state": state, "vintage": _vintage(), "message": message}
    json_value = getattr(a, "json", None)
    if json_value is True or isinstance(json_value, str):
        _write_json(a, payload)
    else:
        print(f"ANSWER-STATE: {state}")
        if state == STATE_PARTIAL:
            print("STATE: NOT-DECIDABLE (rc=3; distinct from a clean answer)")
        print(message)
    return RC_BY_STATE[state]


def cmd_freshness(a) -> int:
    # The O1 engine scores the WHOLE repo (git history is repo-root-relative, so its --root must
    # BE the repo root). Subtree scoping is therefore a wrapper-side PREFIX FILTER over the engine's
    # pure analytic (build/summarize/cluster) -- reused, not re-implemented.
    if not os.path.isdir(HEATMAP_DIR):
        return _state_result(a, STATE_PARTIAL,
                             f"comp-heat: heatmap source unavailable at {HEATMAP_DIR}; no heat answer is claimed")
    sys.path.insert(0, HEATMAP_DIR)
    try:
        import time
        from heat_map import HeatParams, cluster_by_locality, summarize  # noqa: E402
        from object_freshness import build                                # noqa: E402
    except Exception as e:                                                 # noqa: BLE001
        return _state_result(a, STATE_PARTIAL,
                             f"comp-heat: heatmap source unreadable: {e}; no heat answer is claimed")

    rel = a.path.replace("\\", "/").strip("/") if a.path else ""
    if rel and not os.path.exists(os.path.join(REPO_ROOT, rel)):
        return _state_result(a, STATE_ABSENT,
                             f"comp-heat freshness: subject '{rel}' is absent from the repository corpus")

    p = HeatParams(half_life_days=a.half_life)
    scores, src = build(REPO_ROOT, p, time.time())

    if rel:
        scores = [s for s in scores if s.item_id == rel or s.item_id.startswith(rel + "/")]
        if not scores:
            return _state_result(a, STATE_ZERO,
                                 f"comp-heat freshness: subject '{rel}' exists but has zero scored files")

    summ = summarize(scores)
    clusters = cluster_by_locality(scores, lambda path: os.path.dirname(path) or ".")
    cold_dirs = sorted(((k, v) for k, v in clusters.items() if v["n"] >= 3 and v["cold_frac"] >= 0.8),
                       key=lambda kv: (-kv[1]["n_cold"], -kv[1]["oldest_age_days"]))
    if a.json != "":                                      # human render (skip when JSON->stdout)
        scope = f"{rel}/" if rel else "(whole estate)"
        print(f"=== comp-heat freshness  scope={scope}  files={summ['n']}  half_life={a.half_life}d ===")
        # BASIS-IN-OUTPUT (Andrew-ratified CH-3 elevation, 2026-08-04): a band NEVER prints
        # without the numbers that produced it -- the barrier definition rides every output.
        print(f"  basis: band = age vs barriers [hot<={p.hot_days:.0f}d, warm<={p.warm_days:.0f}d, "
              f"cold>{p.warm_days:.0f}d]; score = exp(-ln2*age/{p.half_life_days:.0f}d half-life)"
              + (f" + {p.freq_weight}*log1p(freq)" if p.freq_weight else ""))
        print(f"  bands: hot={summ['bands']['hot']} warm={summ['bands']['warm']} "
              f"cold={summ['bands']['cold']} (cold_frac={summ['cold_frac']:.2f})")
        print(f"  coldest {min(a.top, len(scores))} paths (age / score / band):")
        for s in sorted(scores, key=lambda s: s.age_days, reverse=True)[:a.top]:
            print(f"    {s.age_days:7.0f}d  score={s.score:.4f}  {s.band:4s}  "
                  f"[{src.get(s.item_id, '?'):5s}]  {s.item_id}")
        print(f"  cold SUBTREES (n>=3, cold_frac>=0.8) -- archive candidates (ADVISORY): {len(cold_dirs)}")
        for k, v in cold_dirs[:a.top]:
            print(f"    {v['n_cold']:4d}/{v['n']:<4d} cold  oldest={v['oldest_age_days']:.0f}d  {k}/")

    if a.json is not None:
        snap = {"scope": rel or None, "half_life_days": a.half_life,
                "basis": {"half_life_days": p.half_life_days,
                          "barriers": {"hot_days": p.hot_days, "warm_days": p.warm_days},
                          "freq_weight": p.freq_weight},
                "summary": summ,
                "paths": [{"path": s.item_id, "age_days": round(s.age_days, 2),
                           "score": round(s.score, 6), "band": s.band,
                           "source": src.get(s.item_id, "?")} for s in scores],
                "cold_subtrees": [{"dir": k, **v} for k, v in cold_dirs],
                "answer_state": None, "vintage": _vintage()}
        _write_json(a, snap)
    return 0


def cmd_drift(a) -> int:
    if not os.path.isdir(HEATMAP_DIR):
        sys.stderr.write(f"comp-heat: heatmap module missing at {HEATMAP_DIR}\n")
        return 3
    sys.path.insert(0, HEATMAP_DIR)
    try:
        import time
        from object_freshness import uncommitted_writes    # noqa: E402
    except Exception as e:                                  # noqa: BLE001
        sys.stderr.write(f"comp-heat: cannot import the heat_map engine: {e}\n")
        return 3
    rows = uncommitted_writes(REPO_ROOT, time.time())
    n_un = sum(1 for r in rows if r["class"] == "untracked")
    n_mod = sum(1 for r in rows if r["class"] == "modified")

    if a.json != "":                                        # human render (skip when JSON->stdout)
        print(f"=== comp-heat drift: writes NOT in a commit  ({len(rows)}: "
              f"{n_mod} modified + {n_un} untracked, freshest first) ===")
        for r in rows[:a.top]:
            age = f"{r['mtime_age_days']:.2f}d" if r["mtime_age_days"] is not None else "  -  "
            print(f"    {age:>9}  {r['class']:9s} [{r['status'] or ' '}]  {r['path']}")
        print("  (LOCAL->GIT layer; the GIT->DEPLOY hop = `comp-pipescript deployed` + `comp-freshness`)")

    if a.json is not None:
        import json
        snap = {"n": len(rows), "n_modified": n_mod, "n_untracked": n_un, "uncommitted": rows}
        text = json.dumps(snap, indent=2)
        if a.json == "":
            print(text)
        else:
            with open(a.json, "w", encoding="utf-8") as fh:
                fh.write(text)
            print(f"OK: wrote drift snapshot -> {a.json}")
    return 0


def cmd_score(a) -> int:
    if not os.path.isdir(HEATMAP_DIR):
        sys.stderr.write(f"comp-heat: heatmap module missing at {HEATMAP_DIR}\n")
        return 3
    sys.path.insert(0, HEATMAP_DIR)
    try:
        from heat_map import HeatParams, score_item       # noqa: E402
    except Exception as e:                                 # noqa: BLE001
        sys.stderr.write(f"comp-heat: cannot import S0 heat_map: {e}\n")
        return 3
    p = HeatParams(half_life_days=a.half_life)
    s = score_item(a.id, a.age_days, p=p)
    if a.json:
        import json
        print(json.dumps({"item_id": s.item_id, "age_days": round(s.age_days, 2),
                          "recency_score": round(s.recency_score, 6),
                          "score": round(s.score, 6), "band": s.band,
                          "basis": {"half_life_days": p.half_life_days,
                                    "barriers": {"hot_days": p.hot_days,
                                                 "warm_days": p.warm_days}}}))
    else:
        # BASIS-IN-OUTPUT: the band verdict prints WITH every number that produced it.
        print(f"=== comp-heat score: {s.item_id} ===")
        print(f"  band={s.band.upper()}  <- age={s.age_days:.2f}d vs barriers "
              f"[hot<={p.hot_days:.0f}d, warm<={p.warm_days:.0f}d, cold>{p.warm_days:.0f}d]")
        print(f"  score={s.score:.4f}  recency={s.recency_score:.4f}  "
              f"(= exp(-ln2*{s.age_days:.2f}/{p.half_life_days:.0f}d half-life))")
    return 0


def cmd_compare(a) -> int:
    """Item-2 COMPARE mode (Andrew rounds 2-3, 2026-08-04): heat divergence/convergence
    of TWO named resources -- the comp-blast-overlap analog on the TIME axis. Per-window
    git-history series per side (ONE `git log` per side, windows derived in-memory --
    extends the heat engine's own git helper, no new walker); output = current heat delta
    (absolute + bands + basis) + a CONVERGING/DIVERGING/PARALLEL verdict + denominators
    (windows, commits per side, shared commits)."""
    if a.a == a.b:
        return _state_result(a, STATE_NA,
                             "comp-heat compare: one path cannot form a two-resource comparison")
    if not os.path.isdir(HEATMAP_DIR):
        sys.stderr.write(f"comp-heat: heatmap module missing at {HEATMAP_DIR}\n")
        return 3
    sys.path.insert(0, HEATMAP_DIR)
    try:
        import time
        from heat_map import HeatParams, recency_score, classify_band   # noqa: E402
        from object_freshness import _git                                # noqa: E402
    except Exception as e:                                               # noqa: BLE001
        sys.stderr.write(f"comp-heat: cannot import the heat_map engine: {e}\n")
        return 3

    p = HeatParams(half_life_days=a.half_life)
    now = time.time()
    D, W = a.window_days, a.windows
    span_start = now - W * D * 86400

    def side(path):
        raw = _git(REPO_ROOT, "log", "--format=%H|%at", "--", path)
        commits = []
        for line in raw.splitlines():
            if "|" in line:
                sha, ts = line.rsplit("|", 1)
                try:
                    commits.append((sha, int(ts)))
                except ValueError:
                    continue
        if not commits:
            return None
        series = []
        for i in range(W):                      # i=0 = the MOST RECENT window
            end = now - i * D * 86400
            in_win = sum(1 for _, ts in commits if end - D * 86400 <= ts < end)
            prior = [ts for _, ts in commits if ts < end]
            if prior:
                age_d = (end - max(prior)) / 86400.0
                heat = recency_score(age_d, p.half_life_days)
            else:
                age_d, heat = None, 0.0         # predates history: heat floor, labeled
            series.append({"window": i, "commits": in_win,
                           "age_days_at_end": round(age_d, 1) if age_d is not None else None,
                           "heat": round(heat, 4)})
        in_span = {sha for sha, ts in commits if ts >= span_start}
        cur_age = (now - max(ts for _, ts in commits)) / 86400.0
        return {"series": series, "shas_in_span": in_span,
                "commits_in_span": len(in_span),
                "current": {"age_days": round(cur_age, 2),
                            "heat": round(recency_score(cur_age, p.half_life_days), 4),
                            "band": classify_band(cur_age, p)}}

    A, B = side(a.a), side(a.b)
    for name, s in ((a.a, A), (a.b, B)):
        if s is None:
            print(f"comp-heat compare: NO git history for {name!r} "
                  f"(path must be repo-root-relative and tracked) -- refusing a "
                  f"one-sided comparison")
            return 2

    deltas = [abs(x["heat"] - y["heat"]) for x, y in zip(A["series"], B["series"])]
    half = max(1, W // 2)
    newer, older = deltas[:half], deltas[half:] or deltas[:1]
    m_new, m_old = sum(newer) / len(newer), sum(older) / len(older)
    if m_new < m_old * 0.8:
        verdict = "CONVERGING"
    elif m_new > m_old * 1.25:
        verdict = "DIVERGING"
    else:
        verdict = "PARALLEL"
    shared = len(A["shas_in_span"] & B["shas_in_span"])
    cur_delta = round(abs(A["current"]["heat"] - B["current"]["heat"]), 4)

    out = {"a": a.a, "b": a.b, "verdict": verdict,
           "verdict_rule": "mean |heat delta| of the newer half of windows vs the older "
                           "half: <0.8x=CONVERGING, >1.25x=DIVERGING, else PARALLEL",
           "current_delta": cur_delta,
           "current": {a.a: A["current"], a.b: B["current"]},
           "series": [{"window": i,
                       a.a: A["series"][i], a.b: B["series"][i],
                       "abs_delta": round(deltas[i], 4)} for i in range(W)],
           "basis": {"half_life_days": p.half_life_days,
                     "barriers": {"hot_days": p.hot_days, "warm_days": p.warm_days}},
           "denominators": {"windows": W, "window_days": D,
                            "commits_a_in_span": A["commits_in_span"],
                            "commits_b_in_span": B["commits_in_span"],
                            "shared_commits_in_span": shared}}
    if a.json:
        import json
        print(json.dumps(out, indent=2))
        return 0
    print(f"=== comp-heat compare: {a.a}  vs  {a.b} ===")
    print(f"  VERDICT: {verdict}  ({out['verdict_rule']})")
    print(f"  current heat delta: {cur_delta}")
    for name, s in ((a.a, A), (a.b, B)):
        c = s["current"]
        print(f"    {name}: band={c['band'].upper()} <- age={c['age_days']}d vs barriers "
              f"[hot<={p.hot_days:.0f}d, warm<={p.warm_days:.0f}d]; heat={c['heat']} "
              f"(exp(-ln2*age/{p.half_life_days:.0f}d))")
    print(f"  per-window series (window 0 = most recent {D}d):")
    for i in range(W):
        ra, rb = A["series"][i], B["series"][i]
        print(f"    w{i}: A commits={ra['commits']:<3} heat={ra['heat']:<7} | "
              f"B commits={rb['commits']:<3} heat={rb['heat']:<7} | |delta|={deltas[i]:.4f}")
    d = out["denominators"]
    print(f"  DENOMINATORS: windows={d['windows']}x{d['window_days']}d; commits in span: "
          f"A={d['commits_a_in_span']} B={d['commits_b_in_span']}; shared={d['shared_commits_in_span']}")
    return 0


def _add_json(sp, with_value=True):
    if with_value:
        sp.add_argument("--json", nargs="?", const="", default=None,
                        help="emit JSON; bare --json -> stdout, --json OUT -> write to OUT")
    else:
        sp.add_argument("--json", action="store_true", help="emit JSON to stdout")


def cmd_federated(a) -> int:
    # comp-heat federated = the LIVE-Trino graph x code-heat view (the federation's net-new over
    # the git-local freshness/drift engines). Engine: .tools/_trino_fed.py (0.8.0_AE, S5; transport
    # = in-VPC run-task->Trino-REST->CloudWatch, zero new attack surface; the persistent endpoint is
    # SCTY-gated/HELD). Shares the substrate comp-diff's lakehouse axis will reuse.
    sys.path.insert(0, _HERE)            # .tools/ -- for _trino_fed
    from _trino_fed import (run_federated_query, render_table,
                            Q_CODE_BANDS, Q_CODE_COLDEST)
    qs = [a.sql] if a.sql else [Q_CODE_BANDS] + ([Q_CODE_COLDEST.format(top=a.top)] if a.top else [])
    for res in run_federated_query(qs):
        print(f"\n# {res['sql'][:90]}")
        print(render_table(res))
    return 0


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(
        prog="comp-heat",
        description="Estate OBJECT write-freshness + hygiene (NFRA_HEATMAP_OBJECT). "
                    "ADVISORY-ONLY, read-only. Distinct from comp-freshness (data-pipeline S3/DDB).",
        epilog="compose: `comp-heat drift` is LOCAL->GIT; the GIT->DEPLOY hop is "
               "`comp-pipescript deployed` + `comp-freshness`.")
    sub = ap.add_subparsers(dest="cmd")

    f = sub.add_parser("freshness", help="per-path hot/warm/cold + cold SUBTREES (archive candidates)")
    f.add_argument("path", nargs="?", default="", help="subtree to scope to (default: repo root)")
    f.add_argument("--half-life", type=float, default=30.0, help="decay half-life in days (default 30)")
    f.add_argument("--top", type=int, default=25, help="show N coldest (default 25)")
    _add_json(f)
    f.set_defaults(fn=cmd_freshness)

    d = sub.add_parser("drift", help="writes NOT in a commit (untracked + modified, freshest first)")
    d.add_argument("--top", type=int, default=25, help="show N (default 25)")
    _add_json(d)
    d.set_defaults(fn=cmd_drift)

    s = sub.add_parser("score", help="ad-hoc S0 heat score for one item")
    s.add_argument("id", help="item id / label")
    s.add_argument("--age-days", type=float, required=True, help="days since last write/activity")
    s.add_argument("--half-life", type=float, default=30.0, help="decay half-life in days (default 30)")
    _add_json(s, with_value=False)
    s.set_defaults(fn=cmd_score)

    fed = sub.add_parser("federated",
        help="hot/cold across estate ASSETS x their git code-heat (LIVE Trino federation; graph-joined)")
    fed.add_argument("--top", type=int, default=0, help="also show the N coldest files")
    fed.add_argument("--sql", help="run an arbitrary federated Trino query instead")
    fed.set_defaults(fn=cmd_federated)

    cp = sub.add_parser("compare",
        help="heat CONVERGING/DIVERGING/PARALLEL between two resources (per-window series + delta + denominators)")
    cp.add_argument("a", help="first repo-root-relative path")
    cp.add_argument("b", help="second repo-root-relative path")
    cp.add_argument("--windows", type=int, default=6, help="number of windows (default 6)")
    cp.add_argument("--window-days", type=int, default=14, help="days per window (default 14)")
    cp.add_argument("--half-life", type=float, default=30.0, help="decay half-life in days (default 30)")
    _add_json(cp, with_value=False)
    cp.set_defaults(fn=cmd_compare)

    args = ap.parse_args(argv)
    if not getattr(args, "cmd", None):
        ap.print_help()
        return 0
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
