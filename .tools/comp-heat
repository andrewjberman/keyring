STATE_ABSENT = "SUBJECT_ABSENT_FROM_CORPUS"
STATE_ZERO = "PRESENT_WITH_ZERO_RESULTS"
STATE_PARTIAL = "PARTIAL_OR_BLIND"
STATE_NA = "NOT_APPLICABLE"
RC_BY_STATE = {STATE_ABSENT: 2, STATE_ZERO: 0, STATE_PARTIAL: 3, STATE_NA: 1}


def _vintage():
    """The JSON carrier's measurement time; consumers need not infer it from a file mtime."""
    return {"measured_at_utc": _dt.datetime.now(_dt.timezone.utc).isoformat().replace("+00:00", "Z"),
            "source": "git-history-derived heatmap"}


def _write_json(a, payload):
    text = json.dumps(payload, indent=2)
    if a.json is True or a.json == "":
        print(text)
    else:
        with open(a.json, "w", encoding="utf-8") as fh:
            fh.write(text)
        print(f"OK: wrote freshness snapshot -> {a.json}")


def _state_result(a, state, message):
    """One machine-readable exceptional answer, never an empty structure read as clean."""
    payload = {"answer_state": state, "vintage": _vintage(), "message": message}
    json_value = getattr(a, "json", None)
    if json_value is True or isinstance(json_value, str):
        _write_json(a, payload)
    else:
        print(f"ANSWER-STATE: {state}")
        if state == STATE_PARTIAL:
            print("STATE: NOT-DECIDABLE (rc=3; distinct from a clean answer)")
        print(message)
    return RC_BY_STATE[state]


def _budget_unavailable(a) -> int:
    return _state_result(a, STATE_PARTIAL,
                         "comp-heat: Rule T budget carrier .tools/_compbudget.py unavailable: "
                         f"{_BUDGET_ERROR_NAME}; no heat answer is claimed")


def _resolve_clock(a):
    """THE CARRIER: flag > env COMP_BUDGET_S > default 90s. Raises ValueError on a bad flag
    value -- the caller reports that as a usage error, never a silent fall-through."""
    budget_s, budget_source = _compbudget.resolve_budget(getattr(a, "budget", None))
    return _compbudget.Clock(budget_s), budget_s, budget_source


def _spent(clock) -> bool:
    """True iff the caller's remaining budget has hit zero -- the fast-path pre-check every
    subcommand consults before starting a phase of bounded work. NAMED, NOT OVERCLAIMED: for
    freshness/drift/compare, the DEEPER and load-bearing enforcement is the subprocess-level
    `timeout=remaining()` on each git call (object_freshness.py's `_git_bounded`) -- a cut still
    lands even if THIS pre-check were skipped, because the subprocess itself refuses to outlive
    its own timeout. `_spent()` is the SOLE guard only where there is no bounded subprocess to
    fall back on: score's O(1) work and federated's refuse-before-dispatch. The one thing every
    path shares is `_compbudget.resolve_budget()` -- a caller's --budget genuinely has nowhere
    else to be ignored from, which is why the battery's RED mutant targets THAT, not this line."""
    r = clock.remaining()
    return r is not None and r <= 0


def _reached_line(budget_s, budget_source, n, total, unit, resume_args, cursor):
    """Same wording as _compbudget.budget_reached_line(), widened for the one case that module's
    int-typed `total` cannot carry: a cut before enumeration even finished, when N genuinely is
    not yet known (comp-schedule's own printed convention: 'UNKNOWN (enumeration itself hit
    budget)') -- never a fabricated 0, which would misreport a stopped census as an empty one."""
    total_text = str(total) if total is not None else "UNKNOWN (enumeration itself hit budget)"
    return ("BUDGET REACHED: %s s (%s); scanned %d of %s %s; results are a PREFIX, not the "
            "answer; resume: %s --cursor %s"
            % (_compbudget.fmt(budget_s), budget_source, n, total_text, unit, resume_args, cursor))


def _add_budget(sp):
    sp.add_argument("--budget", type=float, default=None,
                    help="Rule T: flag > env COMP_BUDGET_S > default 90s; 0 = unbounded")
    sp.add_argument("--cursor", default=None,
                    help="Rule T resume cursor from a prior BUDGET REACHED line")


def _scoped_git_call(rel: str) -> str:
    """The git call the answer's denominator actually came from -- printed, not implied, so a
    reader can re-run it. OS-s-2: the scoped form names its pathspec."""
    if rel:
        return f"git log --format=%ct --name-only --no-renames --full-history -- {rel}"
    return "git log --format=%ct --name-only --no-renames"


def _denominator_line(rel: str, scanned, total, dropped: int = 0, cut: bool = False) -> str:
    """OS-s-2's own disclosure: WHICH POPULATION the number beside this answer counts.

    Before OS-s-2 a caller naming one corner was answered with the WHOLE REPO's `scanned n of N`
    beside that corner's per-path rows -- two grains in one output, neither labelled. This line
    labels the grain, prints the pathspec that produced it, and states the prefix filter's residue
    (0 on a correct scoped run: the engine, not the filter, did the scoping).
    """
    total_s = "UNKNOWN" if total is None else str(total)
    if rel:
        head = (f"  denominator: {scanned} of {total_s} files under {rel}/ -- PATH-SCOPED to this "
                f"corner, NOT the whole repository")
    else:
        head = (f"  denominator: {scanned} of {total_s} files -- WHOLE-ESTATE (the no-path form "
                f"scores the whole repository, by design)")
    tail = f"; git call: `{_scoped_git_call(rel)}`"
    if cut:
        return head + tail + "; PREFIX ONLY (budget reached before this population was finished)"
    if rel:
        tail += f"; wrapper prefix-filter dropped {dropped} row(s) (0 = the engine scoped it)"
    return head + tail


def cmd_freshness(a) -> int:
    if _compbudget is None:
        return _budget_unavailable(a)
    try:
        clock, budget_s, budget_source = _resolve_clock(a)
    except ValueError as e:
        sys.stderr.write(f"comp-heat: {e}\n")
        return 2
    disclosure = _compbudget.disclosure_line(budget_s, budget_source)

    # The O1 engine's --root must BE the repo root (git history is repo-root-relative), but as of
    # OS-s-2 the SCOPE travels into the engine and every git call it makes is PATH-SCOPED to the
    # named corner (`build_budgeted(..., scope=rel)`). A caller naming one corner therefore pays
    # that corner's cost and is answered with THAT CORNER'S DENOMINATOR -- `scanned n of N` counts
    # the corner, not the estate. Before OS-s-2 the scoping was a wrapper-side PREFIX FILTER over a
    # whole-repo scan, so every scoped call paid the full history walk and then disclosed the
    # repo's denominator beside a corner's answer. The prefix filter below is RETAINED as a no-op
    # safety net (it must find nothing left to drop on a scoped run), never as the scoping.
    if not os.path.isdir(HEATMAP_DIR):
        return _state_result(a, STATE_PARTIAL,
                             f"comp-heat: heatmap source unavailable at {HEATMAP_DIR}; no heat answer is claimed")
    sys.path.insert(0, HEATMAP_DIR)
    try:
        import time
        from heat_map import HeatParams, cluster_by_locality, summarize  # noqa: E402
        from object_freshness import build_budgeted                       # noqa: E402
    except Exception as e:                                                 # noqa: BLE001
        return _state_result(a, STATE_PARTIAL,
                             f"comp-heat: heatmap source unreadable: {e}; no heat answer is claimed")

    rel = a.path.replace("\\", "/").strip("/") if a.path else ""
    if rel and not os.path.exists(os.path.join(REPO_ROOT, rel)):
        return _state_result(a, STATE_ABSENT,
                             f"comp-heat freshness: subject '{rel}' is absent from the repository corpus")

    p = HeatParams(half_life_days=a.half_life)
    result = build_budgeted(REPO_ROOT, p, time.time(), clock, cursor=getattr(a, "cursor", None),
                            scope=rel or None)
    scores, src = result["scores"], result["src"]

    if result["cut"]:
        # VERDICT-BEARING (PRD s.4.4): freshness's rc already distinguishes answer states
        # (RC_BY_STATE) -- a BUDGET REACHED run returns the SAME non-clean rc as a genuine
        # PARTIAL_OR_BLIND answer (3), never the clean 0, so a caller checking rc alone cannot
        # mistake a cut run for a complete one.
        resume_args = "comp-heat freshness" + (f" {rel}" if rel else "")
        total_for_line = result["total"] if result["total"] is not None else 0
        terminal = _reached_line(budget_s, budget_source, result["scanned"], result["total"],
                                 "files", resume_args, result["phase"])
        if a.json is not None:
            payload = {"answer_state": STATE_PARTIAL, "vintage": _vintage(),
                       "budget": {"seconds": budget_s, "source": budget_source},
                       "rule_t": {"terminal": terminal, "phase_reached": result["phase"],
                                  "scanned": result["scanned"], "total": result["total"],
                                  "deferred": result["deferred"]},
                       "message": "comp-heat freshness: BUDGET REACHED -- results are a PREFIX, "
                                  "not the answer"}
            _write_json(a, payload)
        else:
            print(disclosure)
            print(terminal)
            print(_denominator_line(rel, result["scanned"], result["total"], cut=True))
            for line in _compbudget.deferred_bucket(len(result["deferred"]), total_for_line,
                                                     "files", result["deferred"]):
                print(line)
            print(f"ANSWER-STATE: {STATE_PARTIAL}")
        return RC_BY_STATE[STATE_PARTIAL]

    # SAFETY NET, NOT THE SCOPING (OS-s-2): the engine's git calls are already path-scoped, so on a
    # scoped run this filter must have NOTHING to drop. `dropped` is carried into the denominator
    # disclosure so a future regression (the engine silently returning unscoped rows again) shows
    # up as a non-zero number in the output rather than being quietly absorbed here.
    dropped = 0
    if rel:
        kept = [s for s in scores if s.item_id == rel or s.item_id.startswith(rel + "/")]
        dropped = len(scores) - len(kept)
        scores = kept
        if not scores:
            return _state_result(a, STATE_ZERO,
                                 f"comp-heat freshness: subject '{rel}' exists but has zero scored files")

    summ = summarize(scores)
    clusters = cluster_by_locality(scores, lambda path: os.path.dirname(path) or ".")
    cold_dirs = sorted(((k, v) for k, v in clusters.items() if v["n"] >= 3 and v["cold_frac"] >= 0.8),
                       key=lambda kv: (-kv[1]["n_cold"], -kv[1]["oldest_age_days"]))
    terminal = _compbudget.within_budget_line(result["scanned"], result["total"], "files",
                                              budget_s, budget_source, round(clock.elapsed(), 3))
    if a.json != "":                                      # human render (skip when JSON->stdout)
        scope = f"{rel}/" if rel else "(whole estate)"
        print(f"=== comp-heat freshness  scope={scope}  files={summ['n']}  half_life={a.half_life}d ===")
        print(disclosure)
        print(terminal)
        print(_denominator_line(rel, result["scanned"], result["total"], dropped=dropped))
        # BASIS-IN-OUTPUT (Andrew-ratified CH-3 elevation, 2026-08-04): a band NEVER prints
        # without the numbers that produced it -- the barrier definition rides every output.
        print(f"  basis: band = age vs barriers [hot<={p.hot_days:.0f}d, warm<={p.warm_days:.0f}d, "
              f"cold>{p.warm_days:.0f}d]; score = exp(-ln2*age/{p.half_life_days:.0f}d half-life)"
              + (f" + {p.freq_weight}*log1p(freq)" if p.freq_weight else ""))
        print(f"  bands: hot={summ['bands']['hot']} warm={summ['bands']['warm']} "
              f"cold={summ['bands']['cold']} (cold_frac={summ['cold_frac']:.2f})")
        print(f"  coldest {min(a.top, len(scores))} paths (age / score / band):")
        for s in sorted(scores, key=lambda s: s.age_days, reverse=True)[:a.top]:
            print(f"    {s.age_days:7.0f}d  score={s.score:.4f}  {s.band:4s}  "
                  f"[{src.get(s.item_id, '?'):5s}]  {s.item_id}")
        print(f"  cold SUBTREES (n>=3, cold_frac>=0.8) -- archive candidates (ADVISORY): {len(cold_dirs)}")
        for k, v in cold_dirs[:a.top]:
            print(f"    {v['n_cold']:4d}/{v['n']:<4d} cold  oldest={v['oldest_age_days']:.0f}d  {k}/")

    if a.json is not None:
        snap = {"scope": rel or None, "half_life_days": a.half_life,
                "denominator": {"grain": "PATH-SCOPED" if rel else "WHOLE-ESTATE",
                                "counts": rel or "(whole estate)",
                                "scanned": result["scanned"], "total": result["total"],
                                "scored": summ["n"],
                                "git_call": _scoped_git_call(rel),
                                "prefix_filter_dropped": dropped,
                                "claim": "measured"},
                "basis": {"half_life_days": p.half_life_days,
                          "barriers": {"hot_days": p.hot_days, "warm_days": p.warm_days},
                          "freq_weight": p.freq_weight},
                "summary": summ,
                "paths": [{"path": s.item_id, "age_days": round(s.age_days, 2),
                           "score": round(s.score, 6), "band": s.band,
                           "source": src.get(s.item_id, "?")} for s in scores],
                "cold_subtrees": [{"dir": k, **v} for k, v in cold_dirs],
                "answer_state": None, "vintage": _vintage(),
                "budget": {"seconds": budget_s, "source": budget_source, "terminal": terminal}}
        _write_json(a, snap)
    return 0


def cmd_drift(a) -> int:
    if _compbudget is None:
        return _budget_unavailable(a)
    try:
        clock, budget_s, budget_source = _resolve_clock(a)
    except ValueError as e:
        sys.stderr.write(f"comp-heat: {e}\n")
        return 2
    disclosure = _compbudget.disclosure_line(budget_s, budget_source)

    if not os.path.isdir(HEATMAP_DIR):
        sys.stderr.write(f"comp-heat: heatmap module missing at {HEATMAP_DIR}\n")
        return 3
    sys.path.insert(0, HEATMAP_DIR)
    try:
        import time
        from object_freshness import uncommitted_writes_budgeted   # noqa: E402
    except Exception as e:                                  # noqa: BLE001
        sys.stderr.write(f"comp-heat: cannot import the heat_map engine: {e}\n")
        return 3
    result = uncommitted_writes_budgeted(REPO_ROOT, time.time(), clock)

    # NON-VERDICT (PRD s.4.4): drift's rc is 0 whether it finds 0 or 500 uncommitted writes --
    # never a verdict a caller branches on -- so rc STAYS 0 at BUDGET REACHED too; the terminal
    # LINE (not the rc) is the rejectable state, exactly the FORM's default clause.
    if result["cut"]:
        total_for_line = result["total"] if result["total"] is not None else 0
        terminal = _reached_line(budget_s, budget_source, result["scanned"], result["total"],
                                 "files", "comp-heat drift", "START")
        if a.json is not None:
            import json
            payload = {"n": 0, "cut": True, "rule_t": {"terminal": terminal,
                       "scanned": result["scanned"], "total": result["total"],
                       "deferred": result["deferred"]}}
            text = json.dumps(payload, indent=2)
            if a.json == "":
                print(text)
            else:
                with open(a.json, "w", encoding="utf-8") as fh:
                    fh.write(text)
                print(f"OK: wrote drift snapshot -> {a.json}")
        else:
            print(disclosure)
            print(terminal)
            for line in _compbudget.deferred_bucket(len(result["deferred"]), total_for_line,
                                                     "files", result["deferred"]):
                print(line)
        return 0

    rows = result["rows"]
    n_un = sum(1 for r in rows if r["class"] == "untracked")
    n_mod = sum(1 for r in rows if r["class"] == "modified")
    terminal = _compbudget.within_budget_line(result["scanned"], result["total"], "files",
                                              budget_s, budget_source, round(clock.elapsed(), 3))

    if a.json != "":                                        # human render (skip when JSON->stdout)
        print(f"=== comp-heat drift: writes NOT in a commit  ({len(rows)}: "
              f"{n_mod} modified + {n_un} untracked, freshest first) ===")
        print(disclosure)
        print(terminal)
        for r in rows[:a.top]:
            age = f"{r['mtime_age_days']:.2f}d" if r["mtime_age_days"] is not None else "  -  "
            print(f"    {age:>9}  {r['class']:9s} [{r['status'] or ' '}]  {r['path']}")
        print("  (LOCAL->GIT layer; the GIT->DEPLOY hop = `comp-pipescript deployed` + `comp-freshness`)")

    if a.json is not None:
        import json
        snap = {"n": len(rows), "n_modified": n_mod, "n_untracked": n_un, "uncommitted": rows,
                "budget": {"seconds": budget_s, "source": budget_source, "terminal": terminal}}
        text = json.dumps(snap, indent=2)
        if a.json == "":
            print(text)
        else:
            with open(a.json, "w", encoding="utf-8") as fh:
                fh.write(text)
            print(f"OK: wrote drift snapshot -> {a.json}")
    return 0


def cmd_score(a) -> int:
    if _compbudget is None:
        return _budget_unavailable(a)
    try:
        clock, budget_s, budget_source = _resolve_clock(a)
    except ValueError as e:
        sys.stderr.write(f"comp-heat: {e}\n")
        return 2
    disclosure = _compbudget.disclosure_line(budget_s, budget_source)

    if not os.path.isdir(HEATMAP_DIR):
        sys.stderr.write(f"comp-heat: heatmap module missing at {HEATMAP_DIR}\n")
        return 3
    sys.path.insert(0, HEATMAP_DIR)
    try:
        from heat_map import HeatParams, score_item       # noqa: E402
    except Exception as e:                                 # noqa: BLE001
        sys.stderr.write(f"comp-heat: cannot import S0 heat_map: {e}\n")
        return 3

    # RULE T NON-APPLICATION (PRD s.4.4, named not silent): score_item is O(1) -- no loop whose
    # iteration count depends on corpus width, no subprocess. It cannot be usefully CUT; the
    # carrier still runs so --budget/--cursor are uniform across all five subcommands and the
    # disclosure line still prints (Rule P's own baseline), but a BUDGET REACHED here would only
    # ever fire if the clock is already spent before this line runs (astronomically unlikely).
    if _spent(clock):
        terminal = _compbudget.budget_reached_line(budget_s, budget_source, 0, 1, "items",
                                                    f"comp-heat score {a.id} --age-days {a.age_days}",
                                                    "START")
        print(disclosure)
        print(terminal)
        return 0

    p = HeatParams(half_life_days=a.half_life)
    s = score_item(a.id, a.age_days, p=p)
    terminal = _compbudget.within_budget_line(1, 1, "items", budget_s, budget_source,
                                              round(clock.elapsed(), 3))
    if a.json:
        import json
        print(json.dumps({"item_id": s.item_id, "age_days": round(s.age_days, 2),
                          "recency_score": round(s.recency_score, 6),
                          "score": round(s.score, 6), "band": s.band,
                          "basis": {"half_life_days": p.half_life_days,
                                    "barriers": {"hot_days": p.hot_days,
                                                 "warm_days": p.warm_days}},
                          "budget": {"seconds": budget_s, "source": budget_source,
                                     "terminal": terminal}}))
    else:
        # BASIS-IN-OUTPUT: the band verdict prints WITH every number that produced it.
        print(f"=== comp-heat score: {s.item_id} ===")
        print(disclosure)
        print(terminal)
        print(f"  band={s.band.upper()}  <- age={s.age_days:.2f}d vs barriers "
              f"[hot<={p.hot_days:.0f}d, warm<={p.warm_days:.0f}d, cold>{p.warm_days:.0f}d]")
        print(f"  score={s.score:.4f}  recency={s.recency_score:.4f}  "
              f"(= exp(-ln2*{s.age_days:.2f}/{p.half_life_days:.0f}d half-life))")
    return 0


def cmd_compare(a) -> int:
    """Item-2 COMPARE mode (Andrew rounds 2-3, 2026-08-04): heat divergence/convergence
    of TWO named resources -- the comp-blast-overlap analog on the TIME axis. Per-window
    git-history series per side (ONE `git log` per side, windows derived in-memory --
    extends the heat engine's own git helper, no new walker); output = current heat delta
    (absolute + bands + basis) + a CONVERGING/DIVERGING/PARALLEL verdict + denominators
    (windows, commits per side, shared commits)."""
    if a.a == a.b:
        return _state_result(a, STATE_NA,
                             "comp-heat compare: one path cannot form a two-resource comparison")
    if _compbudget is None:
        return _budget_unavailable(a)
    try:
        clock, budget_s, budget_source = _resolve_clock(a)
    except ValueError as e:
        sys.stderr.write(f"comp-heat: {e}\n")
        return 2
    disclosure = _compbudget.disclosure_line(budget_s, budget_source)

    if not os.path.isdir(HEATMAP_DIR):
        sys.stderr.write(f"comp-heat: heatmap module missing at {HEATMAP_DIR}\n")
        return 3
    sys.path.insert(0, HEATMAP_DIR)
    try:
        import time
        from heat_map import HeatParams, recency_score, classify_band   # noqa: E402
        from object_freshness import _git_bounded                        # noqa: E402
    except Exception as e:                                               # noqa: BLE001
        sys.stderr.write(f"comp-heat: cannot import the heat_map engine: {e}\n")
        return 3

    p = HeatParams(half_life_days=a.half_life)
    now = time.time()
    D, W = a.window_days, a.windows
    span_start = now - W * D * 86400

    def side(path, timeout):
        raw, timed_out = _git_bounded(REPO_ROOT, "log", "--format=%H|%at", "--", path,
                                      timeout=timeout)
        if timed_out:
            return "TIMEOUT"
        commits = []
        for line in raw.splitlines():
            if "|" in line:
                sha, ts = line.rsplit("|", 1)
                try:
                    commits.append((sha, int(ts)))
                except ValueError:
                    continue
        if not commits:
            return None
        series = []
        for i in range(W):                      # i=0 = the MOST RECENT window
            end = now - i * D * 86400
            in_win = sum(1 for _, ts in commits if end - D * 86400 <= ts < end)
            prior = [ts for _, ts in commits if ts < end]
            if prior:
                age_d = (end - max(prior)) / 86400.0
                heat = recency_score(age_d, p.half_life_days)
            else:
                age_d, heat = None, 0.0         # predates history: heat floor, labeled
            series.append({"window": i, "commits": in_win,
                           "age_days_at_end": round(age_d, 1) if age_d is not None else None,
                           "heat": round(heat, 4)})
        in_span = {sha for sha, ts in commits if ts >= span_start}
        cur_age = (now - max(ts for _, ts in commits)) / 86400.0
        return {"series": series, "shas_in_span": in_span,
                "commits_in_span": len(in_span),
                "current": {"age_days": round(cur_age, 2),
                            "heat": round(recency_score(cur_age, p.half_life_days), 4),
                            "band": classify_band(cur_age, p)}}

    # The two sides ('a' then 'b') are the tool's DETERMINISTIC scan order/resume unit; each
    # fetch's `git log` is bounded by clock.remaining() (Rule T: "every timeout= derives from
    # remaining()"). HONEST NON-APPLICATION: like freshness's phases, the FINAL verdict needs
    # BOTH sides, so a --cursor naming a completed side cannot skip real work without a
    # persistence layer this order does not add -- it is accepted and echoed, not a real skip.
    results = {}
    for label, path in (("a", a.a), ("b", a.b)):
        if _spent(clock):
            break
        r = side(path, clock.remaining())
        if r == "TIMEOUT":
            break
        results[label] = r

    if len(results) < 2:
        cursor_val = "a" if "a" in results else "START"
        terminal = _compbudget.budget_reached_line(
            budget_s, budget_source, len(results), 2, "resources",
            f"comp-heat compare {a.a} {a.b}", cursor_val)
        print(disclosure)
        print(terminal)
        print(f"ANSWER-STATE: {STATE_PARTIAL}")
        return RC_BY_STATE[STATE_PARTIAL]

    A, B = results["a"], results["b"]
    for name, s in ((a.a, A), (a.b, B)):
        if s is None:
            print(f"comp-heat compare: NO git history for {name!r} "
                  f"(path must be repo-root-relative and tracked) -- refusing a "
                  f"one-sided comparison")
            return 2

    deltas = [abs(x["heat"] - y["heat"]) for x, y in zip(A["series"], B["series"])]
    half = max(1, W // 2)
    newer, older = deltas[:half], deltas[half:] or deltas[:1]
    m_new, m_old = sum(newer) / len(newer), sum(older) / len(older)
    if m_new < m_old * 0.8:
        verdict = "CONVERGING"
    elif m_new > m_old * 1.25:
        verdict = "DIVERGING"
    else:
        verdict = "PARALLEL"
    shared = len(A["shas_in_span"] & B["shas_in_span"])
    cur_delta = round(abs(A["current"]["heat"] - B["current"]["heat"]), 4)

    out = {"a": a.a, "b": a.b, "verdict": verdict,
           "verdict_rule": "mean |heat delta| of the newer half of windows vs the older "
                           "half: <0.8x=CONVERGING, >1.25x=DIVERGING, else PARALLEL",
           "current_delta": cur_delta,
           "current": {a.a: A["current"], a.b: B["current"]},
           "series": [{"window": i,
                       a.a: A["series"][i], a.b: B["series"][i],
                       "abs_delta": round(deltas[i], 4)} for i in range(W)],
           "basis": {"half_life_days": p.half_life_days,
                     "barriers": {"hot_days": p.hot_days, "warm_days": p.warm_days}},
           "denominators": {"windows": W, "window_days": D,
                            "commits_a_in_span": A["commits_in_span"],
                            "commits_b_in_span": B["commits_in_span"],
                            "shared_commits_in_span": shared}}
    terminal = _compbudget.within_budget_line(2, 2, "resources", budget_s, budget_source,
                                              round(clock.elapsed(), 3))
    out["budget"] = {"seconds": budget_s, "source": budget_source, "terminal": terminal}
    if a.json:
        import json
        print(json.dumps(out, indent=2))
        return 0
    print(f"=== comp-heat compare: {a.a}  vs  {a.b} ===")
    print(disclosure)
    print(terminal)
    print(f"  VERDICT: {verdict}  ({out['verdict_rule']})")
    print(f"  current heat delta: {cur_delta}")
    for name, s in ((a.a, A), (a.b, B)):
        c = s["current"]
        print(f"    {name}: band={c['band'].upper()} <- age={c['age_days']}d vs barriers "
              f"[hot<={p.hot_days:.0f}d, warm<={p.warm_days:.0f}d]; heat={c['heat']} "
              f"(exp(-ln2*age/{p.half_life_days:.0f}d))")
    print(f"  per-window series (window 0 = most recent {D}d):")
    for i in range(W):
        ra, rb = A["series"][i], B["series"][i]
        print(f"    w{i}: A commits={ra['commits']:<3} heat={ra['heat']:<7} | "
              f"B commits={rb['commits']:<3} heat={rb['heat']:<7} | |delta|={deltas[i]:.4f}")
    d = out["denominators"]
    print(f"  DENOMINATORS: windows={d['windows']}x{d['window_days']}d; commits in span: "
          f"A={d['commits_a_in_span']} B={d['commits_b_in_span']}; shared={d['shared_commits_in_span']}")
    return 0


def _add_json(sp, with_value=True):
    if with_value:
        sp.add_argument("--json", nargs="?", const="", default=None,
                        help="emit JSON; bare --json -> stdout, --json OUT -> write to OUT")
    else:
        sp.add_argument("--json", action="store_true", help="emit JSON to stdout")


FEDERATED_LIVE_FLOOR_S = 200.0   # _trino_fed.py's own docstring: "~3-4 min/call" (180-240s)

# OS-s-5. The transport's OWN bounding parameters, which the caller had never been passing.
# `_trino_fed.run_federated_query(sqls, *, delay=15, max_attempts=40)` bounds the ECS
# `tasks_stopped` waiter at delay*max_attempts seconds. Called with neither -- as this wrapper did
# until OS-s-5 -- that is 15 x 40 = 600 s of waiting, fixed, and COMPLETELY INDEPENDENT of the
# caller's --budget. Deriving both from clock.remaining() is what carries Rule T's own clause
# ("every timeout= derives from remaining()") ACROSS THE MODULE BOUNDARY without editing
# .tools/_trino_fed.py, which is outside this order's <paths>. Build ladder rung 4: the transport
# already had the parameter; nothing new is implemented here.
FEDERATED_WAITER_DELAY_S = 5
# Wall-clock the dispatch needs for everything that is NOT the waiter: boto3 client construction,
# ecs:RunTask, and the logs:GetLogEvents read afterwards. Held back so the waiter's own ceiling
# cannot consume the whole budget and leave the log read to run past it.
FEDERATED_NON_WAIT_RESERVE_S = 25.0


def _federated_waiter_bound(remaining):
    """(delay, max_attempts, ceiling_s, basis) for _trino_fed.run_federated_query.

    `remaining is None` means the CALLER asked for unbounded (`--budget 0`); this returns the
    transport's own defaults and says so, rather than inventing a ceiling the caller declined.
    """
    if remaining is None:
        return 15, 40, 600.0, "caller asked for unbounded (--budget 0); transport defaults"
    usable = max(float(remaining) - FEDERATED_NON_WAIT_RESERVE_S, float(FEDERATED_WAITER_DELAY_S))
    attempts = max(1, int(usable // FEDERATED_WAITER_DELAY_S))
    ceiling = float(FEDERATED_WAITER_DELAY_S * attempts)
    return (FEDERATED_WAITER_DELAY_S, attempts, ceiling,
            f"derived from clock.remaining()={float(remaining):.1f}s minus a "
            f"{FEDERATED_NON_WAIT_RESERVE_S:.0f}s non-wait reserve")


def _federated_dispatch_bound_line(delay, attempts, ceiling, basis) -> str:
    """WHAT THE BOUND DOES AND WHAT IT DOES NOT DO, printed together so neither can be read alone.

    It bounds THIS PROCESS'S WAIT. It does NOT cancel the remote work: `run_federated_query` never
    returns the ECS task ARN, so there is nothing for this wrapper to call `ecs:StopTask` on, and
    .tools/_trino_fed.py is outside this order's <paths>. A caller that reads "bounded" as "the
    Fargate task stopped" would be wrong, so the line says which one it is.
    """
    return ("comp-heat federated: dispatch BOUNDED -- ECS tasks_stopped waiter capped at "
            "%ds x %d attempts = %.0fs (%s). THIS BOUNDS THIS PROCESS'S WAIT, NOT THE REMOTE TASK: "
            "the task ARN is not returned across .tools/_trino_fed.py's boundary, so no StopTask "
            "is issued and the in-VPC task runs to its own completion (OS-s-5 residue, row "
            "NFRA_OUTSET-W1-S2)" % (delay, attempts, ceiling, basis))


def _federated_sqls(a):
    """The SQL this invocation WOULD run, resolved once and used for BOTH the vintage block and the
    dispatch -- so the catalogs disclosed are provably the catalogs joined, and not a second list
    that could drift away from the first."""
    from _trino_fed import Q_CODE_BANDS, Q_CODE_COLDEST                    # noqa: E402
    if a.sql:
        return [a.sql]
    return [Q_CODE_BANDS] + ([Q_CODE_COLDEST.format(top=a.top)] if a.top else [])


def _print_federated_vintage(sqls, clock) -> int:
    """OS-s-4: print the VINTAGE block for the artifacts these SQL statements join.

    PRINTED ON EVERY PATH, INCLUDING REFUSE-BEFORE-DISPATCH. An artifact's build time is a property
    of the artifact, not of whether this process got as far as querying it -- so a caller told
    "refusing to dispatch" is still told what it would have been reading and how old it is. That is
    also the only path a sub-floor budget (anything under FEDERATED_LIVE_FLOOR_S) can ever reach,
    so putting the vintage only on the dispatch path would hide it from every bounded caller.

    Returns the number of tables that could NOT report a build time (0 = all measured).
    """
    if not os.path.isdir(HEATMAP_DIR):
        print("VINTAGE: UNREAD -- claim=absent")
        print(f"      reason: heatmap engine directory unavailable at {HEATMAP_DIR}; no vintage "
              "is claimed")
        return 1
    sys.path.insert(0, HEATMAP_DIR)
    try:
        import federated_vintage                                           # noqa: E402
    except Exception as e:                                                 # noqa: BLE001
        print("VINTAGE: UNREAD -- claim=absent")
        print(f"      reason: federated_vintage engine unreadable: {type(e).__name__}: {e}; "
              "no vintage is claimed")
        return 1
    rows = federated_vintage.vintage_rows(sqls, budget_remaining=clock.remaining())
    for line in federated_vintage.render_vintage(rows):
        print(line)
    return sum(1 for r in rows if r["claim"] != federated_vintage.CLAIM_MEASURED)


def cmd_federated(a) -> int:
    # comp-heat federated = the LIVE-Trino graph x code-heat view (the federation's net-new over
    # the git-local freshness/drift engines). Engine: .tools/_trino_fed.py (0.8.0_AE, S5; transport
    # = in-VPC run-task->Trino-REST->CloudWatch, zero new attack surface; the persistent endpoint is
    # SCTY-gated/HELD). Shares the substrate comp-diff's lakehouse axis will reuse.
    #
    # RULE T, CUT DEFECT NAMED (not silently missing): _trino_fed.run_federated_query() takes NO
    # timeout/deadline parameter and .tools/_trino_fed.py is OUTSIDE this order's <paths> write
    # grant, so the LIVE call's OWN internal duration (~3-4 min/call, its own docstring) cannot be
    # bounded from here -- that is OS-s-5's row ("comp-heat federated --sql -- the unbounded
    # arbitrary-query path", depends_on OS-s-1). What THIS wrapper can and does do without touching
    # the transport: resolve the carrier, disclose it, and REFUSE to dispatch to the live plane
    # whenever the resolved budget could not possibly cover one call. A clock-elapsed check ALONE
    # is a race here (there is no bounded subprocess between resolving the budget and dispatching,
    # unlike every other subcommand -- nothing burns wall-clock to make a near-zero budget register
    # as spent before the live call fires), so this is the one subcommand that ALSO gates on the
    # NOMINAL budget against the transport's own known floor, not on elapsed time alone.
    if _compbudget is None:
        return _budget_unavailable(a)
    try:
        clock, budget_s, budget_source = _resolve_clock(a)
    except ValueError as e:
        sys.stderr.write(f"comp-heat: {e}\n")
        return 2
    disclosure = _compbudget.disclosure_line(budget_s, budget_source)

    sys.path.insert(0, _HERE)            # .tools/ -- for _trino_fed
    qs = _federated_sqls(a)

    insufficient = budget_s != 0 and budget_s < FEDERATED_LIVE_FLOOR_S
    if _spent(clock) or insufficient:
        terminal = _reached_line(
            budget_s, budget_source, 0, None, "queries",
            "comp-heat federated" + (f" --sql {a.sql!r}" if a.sql else ""), "START")
        print(disclosure)
        print(terminal)
        reason = (f"budget below the transport's own known floor (~{FEDERATED_LIVE_FLOOR_S:.0f}s; "
                  "_trino_fed.py: '~3-4 min/call')" if insufficient
                  else "an already-spent budget")
        print(f"comp-heat federated: refusing to dispatch to the LIVE Trino plane -- {reason} "
              "(the transport starts a remote task this wrapper cannot cancel, so a budget that "
              "could not cover one call is refused BEFORE dispatch rather than cut after it "
              "-- .tools/_trino_fed.py, OS-s-5)")
        # The vintage of what this call WOULD have joined is still the caller's business, and this
        # is the only path a sub-floor budget can reach -- see _print_federated_vintage().
        _print_federated_vintage(qs, clock)
        return 0

    from _trino_fed import run_federated_query, render_table                # noqa: E402
    print(disclosure)
    _print_federated_vintage(qs, clock)

    # OS-s-5: the caller's ceiling now reaches the transport's own waiter parameters. Before this,
    # `run_federated_query(qs)` was called with neither, i.e. a fixed 600 s wait no --budget could
    # shorten -- which is what made `--sql` an unbounded remote query rather than a bounded one.
    delay, attempts, ceiling, basis = _federated_waiter_bound(clock.remaining())
    print(_federated_dispatch_bound_line(delay, attempts, ceiling, basis))
    try:
        results = run_federated_query(qs, delay=delay, max_attempts=attempts)
    except Exception as e:                                                  # noqa: BLE001
        # A waiter that ran out of attempts is a BUDGET event, not a crash, and it is reported in
        # the Rule T vocabulary with a NON-CLEAN rc: unlike refuse-before-dispatch (a complete and
        # correct answer to "should I run this?", rc 0), a cut AFTER dispatch leaves the caller
        # with NO answer at all, so rc 0 there would say "fine" about nothing.
        if type(e).__name__ != "WaiterError":
            raise
        print(_reached_line(budget_s, budget_source, 0, len(qs), "queries",
                            "comp-heat federated" + (f" --sql {a.sql!r}" if a.sql else ""),
                            "DISPATCHED"))
        print("comp-heat federated: the in-VPC task did not stop within this caller's derived "
              f"ceiling ({ceiling:.0f}s); results are NOT claimed. The remote task was NOT "
              "cancelled -- see the dispatch bound line above.")
        print(f"ANSWER-STATE: {STATE_PARTIAL}")
        return RC_BY_STATE[STATE_PARTIAL]
    for res in results:
        print(f"\n# {res['sql'][:90]}")
        print(render_table(res))
    print(_compbudget.within_budget_line(len(qs), len(qs), "queries", budget_s, budget_source,
                                         round(clock.elapsed(), 3)))
    return 0


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(
        prog="comp-heat",
        description="Estate OBJECT write-freshness + hygiene (NFRA_HEATMAP_OBJECT). "
                    "ADVISORY-ONLY, read-only. Distinct from comp-freshness (data-pipeline S3/DDB).",
        epilog="compose: `comp-heat drift` is LOCAL->GIT; the GIT->DEPLOY hop is "
               "`comp-pipescript deployed` + `comp-freshness`. "
               "RULE T (NFRA_COMPEFFICACY PRD s.4.4): every subcommand accepts "
               "--budget <seconds> (flag > env COMP_BUDGET_S > default 90s; 0 = unbounded) and a "
               "--cursor resume hint; a cut run prints BUDGET REACHED with its scanned-of-total "
               "denominator instead of running past the caller's ceiling -- see `comp-heat "
               "<subcommand> --help`.")
    sub = ap.add_subparsers(dest="cmd")

    f = sub.add_parser("freshness", help="per-path hot/warm/cold + cold SUBTREES (archive candidates)")
    f.add_argument("path", nargs="?", default="",
                   help="subtree (or single file) to scope to (default: repo root). A named path "
                        "is PATH-SCOPED at the git call, so the printed denominator counts THAT "
                        "corner; the no-path form scores the whole repository.")
    f.add_argument("--half-life", type=float, default=30.0, help="decay half-life in days (default 30)")
    f.add_argument("--top", type=int, default=25, help="show N coldest (default 25)")
    _add_json(f)
    _add_budget(f)
    f.set_defaults(fn=cmd_freshness)

    d = sub.add_parser("drift", help="writes NOT in a commit (untracked + modified, freshest first)")
    d.add_argument("--top", type=int, default=25, help="show N (default 25)")
    _add_json(d)
    _add_budget(d)
    d.set_defaults(fn=cmd_drift)

    s = sub.add_parser("score", help="ad-hoc S0 heat score for one item")
    s.add_argument("id", help="item id / label")
    s.add_argument("--age-days", type=float, required=True, help="days since last write/activity")
    s.add_argument("--half-life", type=float, default=30.0, help="decay half-life in days (default 30)")
    _add_json(s, with_value=False)
    _add_budget(s)
    s.set_defaults(fn=cmd_score)

    fed = sub.add_parser("federated",
        help="hot/cold across estate ASSETS x their git code-heat (LIVE Trino federation; graph-joined)")
    fed.add_argument("--top", type=int, default=0, help="also show the N coldest files")
    fed.add_argument("--sql",
                     help="run an arbitrary federated Trino query instead. BOUNDED like every "
                          "other subcommand: a budget below the transport's own ~200s floor is "
                          "REFUSED before dispatch, and once dispatched the ECS waiter is capped "
                          "from --budget (the remote task is not cancelled -- the bound is on "
                          "this process's wait, and the output says so)")
    _add_budget(fed)
    fed.set_defaults(fn=cmd_federated)

    cp = sub.add_parser("compare",
        help="heat CONVERGING/DIVERGING/PARALLEL between two resources (per-window series + delta + denominators)")
    cp.add_argument("a", help="first repo-root-relative path")
    cp.add_argument("b", help="second repo-root-relative path")
    cp.add_argument("--windows", type=int, default=6, help="number of windows (default 6)")
    cp.add_argument("--window-days", type=int, default=14, help="days per window (default 14)")
    cp.add_argument("--half-life", type=float, default=30.0, help="decay half-life in days (default 30)")
    _add_json(cp, with_value=False)
    _add_budget(cp)
    cp.set_defaults(fn=cmd_compare)

    args = ap.parse_args(argv)
    if not getattr(args, "cmd", None):
        ap.print_help()
        return 0
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
