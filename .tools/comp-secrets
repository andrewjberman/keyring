#!/usr/bin/env python3
"""
comp-secrets -- AWS Secrets Manager lens: inventory + safe-read + consumer-map + rotation.

The RELATIONSHIP/SAFETY value a raw `aws secretsmanager get-secret-value` does not add
(a bare value-fetch is operational/off-rail by the graph-presence principle; this tool earns
its place by the context around the value):
  - INVENTORY with firm-separation tagging (bd/cot/inf/mdpf/opal/shared) + freshness/rotation.
  - SAFE READ: REDACTED by default (shape only -- JSON key-names / opaque len+sha8+last4);
    the actual value prints ONLY with --reveal, to STDOUT ONLY. The auto-logger records
    `tool + args` (the secret NAME), NEVER stdout -- so a revealed value is never logged.
  - CONSUMER MAP: which repo/TF code references a secret (file:line) -> pair with `comp-iam`
    for the IAM-grant (who-can-read) view.
  - ROTATION/FRESHNESS: last-changed / last-rotated / rotation-enabled, flags never-rotated.

comp-which-routable: "read / inspect an aws secret", "who consumes this secret",
"are any secrets un-rotated / stale".

Usage:
  comp-secrets list [--firm bd|cot|inf|mdpf|opal|shared] [--json]
  comp-secrets get <name-or-arn> [--reveal] [--json]
  comp-secrets consumers <name-or-arn>
  comp-secrets rotation [--json]
  comp-secrets --help

Read-only. NEVER creates/rotates/deletes a secret (no put/update/rotate calls).
Exit: 0 ok | 1 not-found / nothing-matched | 2 config/AWS-unreachable error.

SSL note (this Windows host): the corporate proxy breaks the default CA chain. The tool
auto-falls-back to the Windows cert store (honors $AWS_CA_BUNDLE / $REQUESTS_CA_BUNDLE first),
so it "just works" locally + on EC2 (where the default chain is fine).
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys

REGION = os.environ.get("AWS_DEFAULT_REGION", "us-east-1")
_HERE = os.path.dirname(os.path.abspath(__file__))
_WS = os.path.dirname(_HERE)
_CA_CACHE = os.path.join(os.path.expanduser("~"), ".comp-secrets-win-ca.pem")

# firm-separation tagging from the secret-name prefix (advisory; firm-mixing is a real risk).
# ORDER MATTERS: cot is checked BEFORE bd so `blackdiamond/cot/*` (Cottonwood, a SEPARATE firm
# from bd despite the shared blackdiamond/ ingest prefix) tags cot, not bd. mdpf before inf, etc.
_FIRM_PATTERNS = [
    ("cot", re.compile(r"(cottonwood|/cot/|/cot$|[-_]cot[-_/]|opal-data-cot)", re.I)),
    ("mdpf", re.compile(r"(mdpf|opal-data-mdpf)", re.I)),
    ("bd", re.compile(r"(blackdiamond|/49f|49financial|[-_]bd[-_/]|opal-data-bd|opal/bd/)", re.I)),
    ("inf", re.compile(r"(inflection|/inf/|[-_]inf[-_/]|orion|eclipse|opal-data-inf)", re.I)),
    ("opal", re.compile(r"(opal/|opalinvest|/mcp|/ms-)", re.I)),
]


def _ascii(s: str) -> str:
    return s.encode("ascii", "replace").decode("ascii")


def _client():
    """boto3 secretsmanager client, with the Windows corporate-proxy CA fallback."""
    try:
        import boto3
        from botocore.exceptions import SSLError
    except Exception as e:  # noqa: BLE001
        sys.stderr.write(f"comp-secrets: boto3 unavailable ({e})\n")
        sys.exit(2)
    verify = os.environ.get("AWS_CA_BUNDLE") or os.environ.get("REQUESTS_CA_BUNDLE")
    try:
        c = boto3.client("secretsmanager", region_name=REGION, verify=verify)
        c.list_secrets(MaxResults=1)  # cheap probe to surface an SSL break early
        return c
    except SSLError:
        bundle = _win_ca_bundle()
        if not bundle:
            sys.stderr.write("comp-secrets: SSL verify failed and no Windows CA bundle could be built.\n"
                             "  Fix: export AWS_CA_BUNDLE=<corporate-ca.pem> and retry.\n")
            sys.exit(2)
        return boto3.client("secretsmanager", region_name=REGION, verify=bundle)
    except Exception as e:  # noqa: BLE001
        sys.stderr.write(f"comp-secrets: AWS unreachable ({_ascii(str(e))})\n")
        sys.exit(2)


def _win_ca_bundle() -> str | None:
    """Export the Windows Root+CA store to a cached PEM (corporate-proxy MITM root lives there).
    Reusable fix banked as reference_aws_boto3_ssl_corporate_proxy_wincert_bundle."""
    if os.path.exists(_CA_CACHE) and os.path.getsize(_CA_CACHE) > 1000:
        return _CA_CACHE
    if os.name != "nt" and not os.environ.get("WINDIR"):
        return None
    ps = (
        "$sb=New-Object System.Text.StringBuilder;"
        "foreach($s in @('Cert:\\LocalMachine\\Root','Cert:\\CurrentUser\\Root',"
        "'Cert:\\LocalMachine\\CA','Cert:\\CurrentUser\\CA')){"
        "Get-ChildItem $s -EA SilentlyContinue|%{"
        "$b=[Convert]::ToBase64String($_.RawData,'InsertLineBreaks');"
        "[void]$sb.AppendLine('-----BEGIN CERTIFICATE-----');"
        "[void]$sb.AppendLine($b);[void]$sb.AppendLine('-----END CERTIFICATE-----')}};"
        f"Set-Content -Path '{_CA_CACHE}' -Value $sb.ToString() -Encoding ascii"
    )
    try:
        subprocess.run(["powershell", "-NoProfile", "-Command", ps], check=True,
                       capture_output=True, timeout=60)
        return _CA_CACHE if os.path.exists(_CA_CACHE) else None
    except Exception:  # noqa: BLE001
        return None


def _firm_of(name: str) -> str:
    for firm, pat in _FIRM_PATTERNS:
        if pat.search(name or ""):
            return firm
    return "shared"


def _age_days(dt) -> str:
    if not dt:
        return "never"
    try:
        import datetime as _d
        now = _d.datetime.now(dt.tzinfo) if dt.tzinfo else _d.datetime.utcnow()
        return f"{(now - dt).days}d"
    except Exception:  # noqa: BLE001
        return "?"


def _all_secrets(client) -> list:
    out, tok = [], None
    while True:
        kw = {"MaxResults": 100}
        if tok:
            kw["NextToken"] = tok
        r = client.list_secrets(**kw)
        out.extend(r.get("SecretList", []))
        tok = r.get("NextToken")
        if not tok:
            break
    return out


def _resolve(client, ident: str) -> dict | None:
    """Find a secret by exact ARN, exact name, or unique substring."""
    secs = _all_secrets(client)
    for s in secs:
        if ident in (s.get("ARN"), s.get("Name")):
            return s
    matches = [s for s in secs if ident.lower() in s.get("Name", "").lower()]
    if len(matches) == 1:
        return matches[0]
    if len(matches) > 1:
        sys.stderr.write(f"comp-secrets: '{ident}' is ambiguous ({len(matches)} matches):\n")
        for m in matches[:10]:
            sys.stderr.write(f"  {m['Name']}\n")
        sys.exit(1)
    return None


# --------------------------------------------------------------------------- list
def cmd_list(args):
    client = _client()
    secs = _all_secrets(client)
    rows = []
    for s in secs:
        firm = _firm_of(s.get("Name", ""))
        if args.firm and firm != args.firm:
            continue
        rows.append({
            "name": s.get("Name"),
            "firm": firm,
            "last_changed": _age_days(s.get("LastChangedDate")),
            "last_rotated": _age_days(s.get("LastRotatedDate")),
            "rotation": "on" if s.get("RotationEnabled") else "off",
            "arn_tail": (s.get("ARN", "")[-12:]),
        })
    rows.sort(key=lambda r: (r["firm"], r["name"]))
    if args.json:
        print(json.dumps(rows, indent=2))
        return 0 if rows else 1
    if not rows:
        print("comp-secrets: no secrets matched.")
        return 1
    print(f"{'FIRM':<7} {'ROT':<4} {'CHANGED':<8} {'ROTATED':<8} NAME")
    for r in rows:
        print(_ascii(f"{r['firm']:<7} {r['rotation']:<4} {r['last_changed']:<8} {r['last_rotated']:<8} {r['name']}"))
    print(f"\n{len(rows)} secret(s). Values NOT shown -- `comp-secrets get <name>` (redacted) or `--reveal`.")
    return 0


# --------------------------------------------------------------------------- get
def _shape(value: str) -> str:
    """A SAFE characterization of a secret value -- never the value itself."""
    raw = value or ""
    sha8 = hashlib.sha256(raw.encode("utf-8", "replace")).hexdigest()[:8]
    try:
        obj = json.loads(raw)
        if isinstance(obj, dict):
            keys = ", ".join(sorted(obj.keys()))
            return f"JSON object | keys: [{keys}] | sha8={sha8}"
    except Exception:  # noqa: BLE001
        pass
    last4 = raw[-4:] if len(raw) >= 8 else ""
    return f"opaque | len={len(raw)} | ...{last4} | sha8={sha8}"


def cmd_get(args):
    client = _client()
    s = _resolve(client, args.ident)
    if not s:
        sys.stderr.write(f"comp-secrets: no secret named/matching '{args.ident}'.\n")
        return 1
    name, arn = s["Name"], s["ARN"]
    firm = _firm_of(name)
    try:
        v = client.get_secret_value(SecretId=arn)
    except Exception as e:  # noqa: BLE001
        sys.stderr.write(f"comp-secrets: get_secret_value failed ({_ascii(str(e))})\n")
        return 2
    value = v.get("SecretString")
    is_binary = value is None and v.get("SecretBinary") is not None
    meta = {
        "name": name, "firm": firm, "arn_tail": arn[-16:],
        "version": v.get("VersionId", "")[:8],
        "last_changed": _age_days(s.get("LastChangedDate")),
        "rotation": "on" if s.get("RotationEnabled") else "off",
        "binary": is_binary,
    }
    if args.json and not args.reveal:
        print(json.dumps({**meta, "shape": ("binary" if is_binary else _shape(value))}, indent=2))
        return 0
    print(_ascii(f"name:        {name}"))
    print(_ascii(f"firm:        {firm}    rotation: {meta['rotation']}    changed: {meta['last_changed']}    ver: {meta['version']}"))
    print(_ascii(f"arn:         ...{meta['arn_tail']}"))
    if is_binary:
        print("value:       <binary secret -- use the AWS CLI/boto3 to handle bytes>")
        return 0
    if args.reveal:
        sys.stderr.write("comp-secrets: --reveal -> printing the cleartext VALUE to stdout only (NOT logged). Handle with care.\n")
        # value to stdout ONLY; the auto-logger records the command (name), never stdout.
        print(_ascii(f"value:       {value}"))
    else:
        print(_ascii(f"shape:       {_shape(value)}"))
        print("             (redacted -- re-run with --reveal to print the cleartext value)")
    return 0


# --------------------------------------------------------------------------- consumers
def cmd_consumers(args):
    client = _client()
    s = _resolve(client, args.ident)
    if not s:
        sys.stderr.write(f"comp-secrets: no secret named/matching '{args.ident}'.\n")
        return 1
    name, arn = s["Name"], s["ARN"]
    needles = {name, arn, arn.rsplit("-", 1)[0]}  # name, full arn, arn-without-the-6-char-suffix
    hits = []
    for needle in sorted(needles):
        try:
            out = subprocess.run(
                ["git", "-C", _WS, "grep", "-rniI", "--no-color", needle, "--",
                 "infra/", "data/", "org/", ".tools/", "docs/"],
                capture_output=True, text=True, timeout=60)
            for line in out.stdout.splitlines():
                hits.append(line.strip())
        except Exception:  # noqa: BLE001
            pass
    # dedup, drop this tool's own definition noise
    seen, clean = set(), []
    for h in hits:
        key = h[:160]
        if key in seen:
            continue
        seen.add(key)
        clean.append(h)
    print(_ascii(f"secret: {name}"))
    print(_ascii(f"firm:   {_firm_of(name)}    arn: ...{arn[-16:]}"))
    print(f"\nCODE/TF references ({len(clean)}):")
    if not clean:
        print("  (none in infra/data/org/.tools/docs -- may be consumed only at runtime via env/IAM)")
    for h in clean[:60]:
        print("  " + _ascii(h[:200]))
    print("\nFor the IAM-grant view (which ROLES can read it): `comp-iam` on the consuming role,")
    print("or `comp-iam gaps`. This map = static code/TF references only.")
    return 0


# --------------------------------------------------------------------------- rotation
def cmd_rotation(args):
    client = _client()
    secs = _all_secrets(client)
    rows = []
    for s in secs:
        rows.append({
            "name": s.get("Name"),
            "firm": _firm_of(s.get("Name", "")),
            "rotation": "on" if s.get("RotationEnabled") else "off",
            "last_rotated": _age_days(s.get("LastRotatedDate")),
            "last_changed": _age_days(s.get("LastChangedDate")),
            "never_rotated": s.get("LastRotatedDate") is None,
        })
    rows.sort(key=lambda r: (r["rotation"] != "off", r["name"]))  # off + never-rotated surface first
    if args.json:
        print(json.dumps(rows, indent=2))
        return 0
    never = [r for r in rows if r["never_rotated"]]
    print(f"{'ROT':<4} {'ROTATED':<9} {'CHANGED':<9} {'FIRM':<7} NAME")
    for r in rows:
        flag = "  <- never rotated" if r["never_rotated"] else ""
        print(_ascii(f"{r['rotation']:<4} {r['last_rotated']:<9} {r['last_changed']:<9} {r['firm']:<7} {r['name']}{flag}"))
    print(f"\n{len(rows)} secret(s); {len(never)} never auto-rotated (rotation off + no rotation date).")
    print("Note: 'never rotated' is by-design for many app/relay tokens; it is an inventory signal, not a defect.")
    return 0


def main():
    p = argparse.ArgumentParser(prog="comp-secrets", add_help=True,
                                description="AWS Secrets Manager lens (inventory/safe-read/consumers/rotation).")
    sub = p.add_subparsers(dest="cmd")
    pl = sub.add_parser("list", help="inventory all secrets (no values)")
    pl.add_argument("--firm", choices=["bd", "cot", "inf", "mdpf", "opal", "shared"])
    pl.add_argument("--json", action="store_true")
    pg = sub.add_parser("get", help="safe read (redacted unless --reveal)")
    pg.add_argument("ident")
    pg.add_argument("--reveal", action="store_true", help="print the cleartext value (stdout only; not logged)")
    pg.add_argument("--json", action="store_true")
    pc = sub.add_parser("consumers", help="code/TF references to a secret (+ pointer to comp-iam)")
    pc.add_argument("ident")
    pr = sub.add_parser("rotation", help="rotation/freshness across all secrets")
    pr.add_argument("--json", action="store_true")
    args = p.parse_args()
    if not args.cmd:
        p.print_help()
        return 0
    return {"list": cmd_list, "get": cmd_get, "consumers": cmd_consumers, "rotation": cmd_rotation}[args.cmd](args)


if __name__ == "__main__":
    sys.exit(main() or 0)
