#!/bin/bash
# comp-diff — map git changes to trace graph impact
# Usage: comp-diff [--ref HEAD~3] [--staged] [--json]
WORKSPACE="$(cd "$(dirname "$0")/.." && pwd)"
python "$WORKSPACE/org/modules/graph/cli.py" diff "$@"
_exit=$?
python "$WORKSPACE/org/modules/graph/comp_log_auto.py" "comp-diff" "$*" $_exit 2>/dev/null
exit $_exit
