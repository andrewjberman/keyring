#!/bin/bash
# Portal pre-push hook.
#   - VALGATE D-1 adapter-threading gate (ADHC_VALGATE.004) -- every push.
#   - tsc -b --noEmit typecheck -- PROD pushes only.
# Installed by: DT session startup / .tools/portal-hooks/install.sh
#
# D-1 lives at <workspace>/.tools/portal-hooks/d1_adapter_threading_gate.py
# (parent repo) -- the pre-push surface is parent-repo .tools/portal-hooks/;
# the portal submodule carries no committed hook machinery. install.sh copies
# this file into portal/.git/hooks/pre-push; the D-1 script is referenced in
# place and is not copied.

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# The superproject's root, for a portal that is a submodule whose real hooks dir is
# <workspace>/.git/modules/portal/hooks (portal/.git is then a file, and the ../../../ walk below
# lands on <workspace>/.git, not the workspace). Empty when portal is not a submodule.
SUPER_ROOT="$(git rev-parse --show-superproject-working-tree 2>/dev/null)"
# From a throwaway portal worktree (git worktree add --detach, as portal-merge-forward.sh and the release build use)
# the line above prints EMPTY. The installed hook's own location does not depend on the working directory: when it
# sits in <workspace>/.git/modules/<name>/hooks, the workspace is four levels up.
case "$HOOK_DIR" in
  */.git/modules/*/hooks) [ -n "$SUPER_ROOT" ] || SUPER_ROOT="$(cd "$HOOK_DIR/../../../.." && pwd)" ;;
esac

# Resolve the D-1 gate whether this hook runs as the canonical source
# (.tools/portal-hooks/pre-push) or the installed copy (portal/.git/hooks/).
D1_GATE=""
for cand in \
  "$HOOK_DIR/d1_adapter_threading_gate.py" \
  "$HOOK_DIR/../../../.tools/portal-hooks/d1_adapter_threading_gate.py" \
  "${SUPER_ROOT:+$SUPER_ROOT/.tools/portal-hooks/d1_adapter_threading_gate.py}" \
; do
  [ -n "$cand" ] || continue
  if [ -f "$cand" ]; then
    D1_GATE="$cand"
    break
  fi
done

D1_BLOCKED=0

# Resolve the DEV payload gate the same way (NFRA_DEVPLN DP-f-1).
DEVPUSH_GATE=""
for cand in \
  "$HOOK_DIR/dev_push_payload_gate.py" \
  "$HOOK_DIR/../../../.tools/portal-hooks/dev_push_payload_gate.py" \
  "${SUPER_ROOT:+$SUPER_ROOT/.tools/portal-hooks/dev_push_payload_gate.py}" \
; do
  [ -n "$cand" ] || continue
  if [ -f "$cand" ]; then
    DEVPUSH_GATE="$cand"
    break
  fi
done

DEVPUSH_BLOCKED=0

# --- 3F-BF2 provenance-read guard (every push, every branch) ---
# The direct-read-failing test (CTO ruling 20260723T042253Z: wire at BOTH layers --
# this hook beside VALGATE + the deploy CI backstop). A value array read without its
# point_class outside src/lib/pairedProvenanceRead.ts BLOCKS the push here, at the
# moment the violation could enter shared history. Guard: scripts/provenance-read-guard.mjs
# (mutant-proven). An unwired fail-on-violation guard manufactures assurance -- law #4.
if [ -f "scripts/provenance-read-guard.mjs" ]; then
  if command -v node >/dev/null 2>&1; then
    node scripts/provenance-read-guard.mjs
    if [ $? -ne 0 ]; then
      echo "ERROR: provenance-read guard BLOCKED this push (unlabeled read of a"
      echo "ERROR: provenance-bearing value array -- read via pairedProvenanceRead.ts)"
      exit 1
    fi
  else
    echo "WARN: node not found -- provenance-read guard skipped (CI backstop still runs)"
  fi
fi

while read -r local_ref local_sha remote_ref remote_sha; do

  # --- VALGATE D-1: adapter-threading gate (every push) ---
  if [ -n "$D1_GATE" ]; then
    python "$D1_GATE" \
      --local-sha "$local_sha" \
      --remote-sha "$remote_sha" \
      --remote-ref "$remote_ref"
    if [ $? -ne 0 ]; then
      D1_BLOCKED=1
      D1_GATE_FAILED=1
    fi
  elif [ "$remote_ref" = "refs/heads/DEV" ] || [ "$remote_ref" = "refs/heads/PROD" ]; then
    # CTO ruling 20261014 (CTO_RULING_20261014_013xZ_PORTAL_PREPUSH_MISSING_GATE_FAILS_CLOSED_ON_TRUNKS.md):
    # a missing gate script on a TRUNK is a silent absence, so the push fails closed.
    echo "ERROR: VALGATE D-1 gate script d1_adapter_threading_gate.py not found -- push to $remote_ref refused; run: bash .tools/portal-hooks/install.sh"
    D1_BLOCKED=1
  else
    echo "WARN: VALGATE D-1 gate script not found -- adapter-threading gate skipped"
  fi

  # --- DEV payload limb: portal DEV is written only through portal-merge-forward.sh (every push) ---
  if [ "$remote_ref" = "refs/heads/DEV" ]; then
    if [ -n "$DEVPUSH_GATE" ]; then
      python "$DEVPUSH_GATE" \
        --local-sha "$local_sha" \
        --remote-sha "$remote_sha" \
        --remote-ref "$remote_ref" \
        --portal "." < /dev/null
      if [ $? -ne 0 ]; then
        echo "ERROR: portal DEV is written only through .tools/portal-merge-forward.sh (an approved feature row)"
        DEVPUSH_BLOCKED=1
      fi
    else
      # DEV is a trunk: fail closed (same ruling as the D-1 limb above).
      echo "ERROR: DEV payload gate script dev_push_payload_gate.py not found -- push to refs/heads/DEV refused; run: bash .tools/portal-hooks/install.sh"
      DEVPUSH_BLOCKED=1
    fi
  fi

  # --- typecheck: PROD pushes only ---
  if echo "$remote_ref" | grep -q "refs/heads/PROD"; then
    echo "INFO: PROD push detected -- running typecheck (tsc -b --noEmit)"
    if command -v bun >/dev/null 2>&1; then
      bun run typecheck
    else
      npx tsc -b --noEmit
    fi
    if [ $? -ne 0 ]; then
      echo "ERROR: typecheck failed -- push to PROD blocked"
      echo "ERROR: Fix TypeScript errors before pushing to PROD"
      exit 1
    fi
    echo "OK: typecheck passed -- proceeding with PROD push"
  fi

done

if [ "$D1_BLOCKED" -ne 0 ]; then
  echo "ERROR: VALGATE D-1 adapter-threading gate BLOCKED this push"
  # Say the adapter sentence only when the gate RAN and failed; a missing script was named above.
  if [ "${D1_GATE_FAILED:-0}" -ne 0 ]; then
    echo "ERROR: a partner-facing adapter has an un-threaded output path -- see above"
  fi
  exit 1
fi

if [ "$DEVPUSH_BLOCKED" -ne 0 ]; then
  exit 1
fi

exit 0
