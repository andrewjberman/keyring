#!/usr/bin/env bash
# kill-orphans -- terminate stale workspace background scripts.
#
# Targets background processes that orphan when a Claude Code session dies
# uncleanly: inbox-watch.sh per-agent watchers, check-inbox.sh hangs, and
# agent-poller.py MCP pollers. Excludes the MCP broker daemon (broker.py)
# -- that is a singleton service and must stay running.
#
# Usage:
#   kill-orphans              dry-run: list ALL matching processes
#   kill-orphans --stale      dry-run: only watchers whose agent is NOT live in liveness.json
#   kill-orphans --serial <S> dry-run: only watchers whose serial EXACTLY = S (tilde-specific;
#                             ...~A matches only ...~A, never base or ...~B). The register-hook's
#                             scoped self-cleanup -- an agent's registration only reaps ITS OWN
#                             serial's watchers, never another agent's (Andrew-direct 2026-06-15).
#   kill-orphans --force      kill matches (with --serial = scoped; ALONE = ALL, incl. live -- danger)
#   kill-orphans --serial <S> --force   kill ONLY S's watchers (the safe scoped reap)
#   kill-orphans --stale --force    kill only stale matches (legacy routine cleanup)
#   kill-orphans --global     widen scope beyond this workspace (use with care)
#   Every reap is AUDITED to org/mcp/agent-spawn-audit.log (KILL-ORPHAN lines).
#
# Exit codes:
#   0  success (may have killed 0 processes)
#   2  invalid flag
#
# Implementation note: uses `ps -ef` (available in every Git Bash / MSYS2
# environment) rather than pgrep -- pgrep is not installed by default on
# Windows. ps -ef shows all bash-spawned processes owned by the current
# user, which is exactly the surface we target.

set -euo pipefail

WORKSPACE="$(cd "$(dirname "$0")/.." && pwd)"

FORCE=0
GLOBAL=0
STALE_ONLY=0
SERIAL_FILTER=""
while [ $# -gt 0 ]; do
    case "$1" in
        --force) FORCE=1 ;;
        --global) GLOBAL=1 ;;
        --stale) STALE_ONLY=1 ;;
        --serial)
            shift
            SERIAL_FILTER="${1:-}"
            if [ -z "$SERIAL_FILTER" ]; then
                echo "--serial requires an EXACT agent serial (tilde-specific)" >&2; exit 2
            fi
            ;;
        -h|--help)
            sed -n '2,19p' "$0"; exit 0 ;;
        *)
            echo "unknown flag: $1" >&2; exit 2 ;;
    esac
    shift
done

# Build set of LIVE agent serials from liveness.json (used by --stale filter).
# Live = last_seen within 600s (10min; raised from 120s per LD-0063 to accommodate
# substantive-work-without-explicit-heartbeat gaps. NOTE: now diverged from
# server.py STALE_THRESHOLD=120s; kill-orphans uses local 600s threshold).
LIVENESS_FILE="$WORKSPACE/org/mcp/liveness.json"
LIVE_SERIALS=""
if [ "$STALE_ONLY" -eq 1 ] && [ -f "$LIVENESS_FILE" ]; then
    # Pipe via stdin -- passing $LIVENESS_FILE as a string arg fails because
    # Python on Windows can't resolve MSYS-style /c/... paths silently
    # and the `open(...)` returns FileNotFoundError, which we'd swallow
    # and incorrectly classify every agent as stale.
    LIVE_SERIALS=$(cat "$LIVENESS_FILE" | python -c "
import json, time, sys
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
now = time.time()
for serial, info in data.items():
    if now - info.get('last_seen_epoch', 0) < 600:
        print(serial)
" 2>/dev/null | tr -d '\r')
fi

is_live_serial() {
    # Accepts an agent serial, returns 0 if currently live, 1 if stale/unknown
    local candidate="$1"
    [ -z "$LIVE_SERIALS" ] && return 1
    while IFS= read -r live; do
        [ "$candidate" = "$live" ] && return 0
    done <<< "$LIVE_SERIALS"
    return 1
}

# Script basenames known to orphan. Anchored to ".sh"/".py" to keep the
# match tight and avoid false positives from unrelated cmdlines.
PATTERNS='inbox-watch\.sh|check-inbox\.sh|agent-poller\.py'

# Snapshot ps -ef. Fields: UID PID PPID TTY STIME CMD(...)
# We want PID (col 2) + the full CMD tail (col 6+).
ps_snapshot=$(ps -ef 2>/dev/null || true)
if [ -z "$ps_snapshot" ]; then
    echo "[kill-orphans] ps -ef returned nothing -- cannot enumerate processes." >&2
    exit 0
fi

# Build candidate list: PID + cmdline, filtered by pattern, excluding
# this script's own PID ($$) and the shell that invoked us ($PPID).
matches=()
while IFS= read -r line; do
    # Skip header row
    case "$line" in UID*) continue ;; esac

    # Extract pid (col 2) and cmd (col 6 onward)
    pid=$(echo "$line" | awk '{print $2}')
    cmd=$(echo "$line" | awk '{for (i=6; i<=NF; i++) printf "%s ", $i; print ""}')
    [ -z "$pid" ] && continue
    [ "$pid" = "$$" ] && continue
    [ "$pid" = "$PPID" ] && continue

    # Pattern filter
    if ! echo "$cmd" | grep -qE "$PATTERNS"; then
        continue
    fi

    # Workspace scope filter (unless --global)
    if [ "$GLOBAL" -eq 0 ]; then
        case "$cmd" in
            *"$WORKSPACE"*) : ;;   # keep
            *) continue ;;          # skip: not our workspace
        esac
    fi

    # Extract the agent serial from the cmdline -- the token IMMEDIATELY AFTER the
    # script name (the serial is always the first positional arg). NOT by field
    # position: a persistent-Monitor stream watcher (LD-0146) has a trailing
    # `stream` arg, AND the Monitor wraps the command as
    # `... eval 'bash .../inbox-watch.sh <serial> stream' && pwd -P >| '<tmp>/...cwd'`
    # so $NF is a temp-path redirect, not the serial. Reading the wrong token made
    # every live stream watcher read as stale -> reaped on a peer's register_agent
    # (the exit-143 incident, 2026-06-15). --serial below scopes this tilde-exactly.
    serial=""
    if [ "$STALE_ONLY" -eq 1 ] || [ -n "$SERIAL_FILTER" ]; then
        # `|| true`: a no-match grep returns non-zero; under `set -euo pipefail`
        # the assignment would then trip set -e and kill the script silently.
        serial=$(echo "$cmd" | grep -oE "($PATTERNS)[[:space:]]+[^[:space:]']+" | head -1 | sed -E 's/^.*[[:space:]]+//' || true)
    fi

    # --serial filter: tilde-SPECIFIC EXACT match. `...~A` reaps only `...~A`, never
    # the base serial or `...~B`. The register-hook's scoped self-cleanup -- an
    # agent's registration must NEVER touch another serial's watcher (the root fix
    # for the fabric-wide collateral reaping, Andrew-direct 2026-06-15).
    if [ -n "$SERIAL_FILTER" ]; then
        [ "$serial" = "$SERIAL_FILTER" ] || continue
    fi

    # --stale filter: skip serials currently live (<600s) in liveness.json.
    if [ "$STALE_ONLY" -eq 1 ]; then
        if [ -n "$serial" ] && is_live_serial "$serial"; then
            continue
        fi
    fi

    matches+=("$pid|$cmd")
done <<< "$ps_snapshot"

if [ "${#matches[@]}" -eq 0 ]; then
    echo "[kill-orphans] No matching background scripts found."
    exit 0
fi

echo "[kill-orphans] ${#matches[@]} matching process(es):"
for entry in "${matches[@]}"; do
    pid="${entry%%|*}"
    cmd="${entry#*|}"
    printf "  PID %-8s  %s\n" "$pid" "$cmd"
done

if [ "$FORCE" -eq 0 ]; then
    echo ""
    echo "[kill-orphans] DRY RUN. Re-run with --force to actually kill."
    exit 0
fi

echo ""
echo "[kill-orphans] Killing..."
# Audit every reap. Was SILENT before 2026-06-15 -- exactly why exit-143 watcher
# reaps stayed "undetermined". One line per kill: ts, killer, pid, cmd-serial, flags.
AUDIT_LOG="$WORKSPACE/org/mcp/agent-spawn-audit.log"
_audit_ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo "unknown-ts")
_audit_flags="force=$FORCE stale=$STALE_ONLY global=$GLOBAL serial=${SERIAL_FILTER:-ALL}"
_audit_by="${OPAL_AGENT_SERIAL:-unknown}"
killed=0
for entry in "${matches[@]}"; do
    pid="${entry%%|*}"
    cmd="${entry#*|}"
    _cmd_serial=$(echo "$cmd" | grep -oE "($PATTERNS)[[:space:]]+[^[:space:]']+" | head -1 | sed -E 's/^.*[[:space:]]+//' || true)
    if kill "$pid" 2>/dev/null; then
        killed=$((killed + 1))
        echo "  killed PID $pid"
        echo "$_audit_ts  KILL-ORPHAN  by $_audit_by  pid=$pid  cmd-serial=${_cmd_serial:-?}  $_audit_flags" >> "$AUDIT_LOG" 2>/dev/null || true
    else
        echo "  FAILED to kill PID $pid (already gone or permission denied)"
    fi
done

# Give them 1s to exit gracefully, then SIGKILL stragglers
sleep 1
for entry in "${matches[@]}"; do
    pid="${entry%%|*}"
    if kill -0 "$pid" 2>/dev/null; then
        kill -9 "$pid" 2>/dev/null && echo "  SIGKILL'd PID $pid"
    fi
done

echo "[kill-orphans] Done. ${killed}/${#matches[@]} processes terminated."
