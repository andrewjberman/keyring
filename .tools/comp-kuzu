#!/bin/bash
# comp-kuzu -- Cypher against the SERVED GLOBGRPH projection. THIN CLIENT, no local database.
# Transport: kuzu_cli.py POSTs one statement to https://mcp.opalinvest.dev/graph/cypher with a
# Secrets-Manager bearer, and prints the service's rows plus its OWN vintage line on stderr.
# Usage: comp-kuzu "MATCH (n:CloudNode) WHERE n.node_type='LAMBDA' RETURN n.node_id LIMIT 10"
#        comp-kuzu --json "..."         # JSON array on stdout, VINTAGE line on stderr
#        comp-kuzu --limit 20 "..."     # auto-append LIMIT
#        comp-kuzu --schema             # the CloudNode/CloudEdge dialect note
# There is no refresh flag, mode or DB path: freshness is the service's property (FWD-6).
WORKSPACE="$(cd "$(dirname "$0")/.." && pwd)"
python "$WORKSPACE/infra/aws/globgrph/kuzu_cli.py" "$@"
_exit=$?
python "$WORKSPACE/org/modules/graph/comp_log_auto.py" "comp-kuzu" "$*" $_exit 2>/dev/null
exit $_exit
