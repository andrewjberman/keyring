def _now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _git_bash() -> str:
    """The GIT BASH executable, resolved EXPLICITLY. A bare 'bash' from a python subprocess on
    Windows resolves to the System32 WSL relay (execvpe(/bin/bash) fails: no distro) -- measured
    2026-07-15 on this tool's own first live run; every bash-shebang reader died silently."""
    for cand in (r"C:\Program Files\Git\bin\bash.exe",
                 r"C:\Program Files\Git\usr\bin\bash.exe"):
        if os.path.isfile(cand):
            return cand
    return "bash"  # non-Windows / custom install: trust PATH


def _run(cmd: list, timeout_s: int) -> tuple:
    """Run a reader; return (rc, stdout, elapsed_s, err_note). NEVER raises -- an axis
    adapter's failure must render as an honest degraded row, not kill the directory.
    stderr's first line rides err_note on any failure (a blind failure note is no note)."""
    t0 = time.time()
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout_s,
                           cwd=WS, encoding="utf-8", errors="replace")
        stderr_head = ((p.stderr or "").strip().splitlines() or [""])[0][:160]
        note = "" if p.returncode == 0 else f"rc={p.returncode}" + (f"; stderr: {stderr_head}" if stderr_head else "")
        return p.returncode, p.stdout or "", time.time() - t0, note
    except subprocess.TimeoutExpired:
        return None, "", time.time() - t0, f"TIMEOUT after {timeout_s}s"
    except FileNotFoundError:
        return None, "", time.time() - t0, "READER ABSENT (not on PATH / not in .tools)"
    except Exception as e:  # noqa: BLE001 -- adapter isolation is the contract
        return None, "", time.time() - t0, f"{type(e).__name__}: {e}"


