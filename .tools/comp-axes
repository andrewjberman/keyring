def render_directory(rows: list, run_at: str) -> None:
    print("=" * 98)
    print(f"comp-axes -- ANALYTIC-AXIS DIRECTORY  [run {run_at}]  (thin: existing readers, nothing recomputed)")
    print("  per-row vintage = THE READER'S OWN; live-probe = measured at call time. Degraded rows are LOUD.")
    print("=" * 98)
    for r in rows:
        flag = "" if r["status"] == "OK" else f"  !! {r['status']}"
        print(f"\n[{r['axis']}]{flag}  vintage: {r['vintage']}  ({r['elapsed_s']}s)")
        if r.get("summary"):
            print(f"  summary: {json.dumps(r['summary'], default=str)}")
        for t in r.get("top3") or []:
            print(f"    - {t['ref']}  [{t['metric']}]")
        if not r.get("top3") and r["status"] == "OK":
            print("    (no ranked entries -- an empty ranked list from a healthy reader)")
        if r.get("note"):
            print(f"  note: {r['note']}")
        print(f"  drill: {r['drill']}")


def render_delta(deltas: list) -> int:
    print("=" * 98)
    print("comp-axes delta -- what changed since the baseline row (per axis)")
    print("=" * 98)
    nonzero = 0
    for d in deltas:
        print(f"\n[{d['axis']}]", end="")
        if "note" in d:
            print(f"  {d['note']}")
            continue
        print(f"  {d['from']} -> {d['to']}")
        if d["summary_delta"]:
            nonzero += 1
            for k, (old, new) in sorted(d["summary_delta"].items()):
                print(f"    {k}: {old} -> {new}")
        if d["entered"]:
            print(f"    entered top-3: {', '.join(d['entered'])}")
        if d["left"]:
            print(f"    left top-3:    {', '.join(d['left'])}")
        if not d["summary_delta"] and not d["entered"] and not d["left"]:
            print("    (no change)")
    print(f"\nOK: DELTA axes_changed={nonzero} of {len(deltas)}")
    return 0


