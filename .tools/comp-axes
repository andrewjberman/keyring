def _fail_row(row: dict, err: str) -> dict:
    row.update(status="ABSENT" if "ABSENT" in err else "TIMEOUT" if "TIMEOUT" in err else "ERROR",
               vintage="unknown", summary={}, top3=[], note=err)
    return row


def axis_heat() -> dict:
    rc, out, el, err = _run([sys.executable, os.path.join(TOOLS, "comp-heat"),
                             "freshness", "--top", "3", "--json"], DEFAULT_TIMEOUT_S)
    row = {"axis": "heat", "drill": "comp-heat freshness [path] --top N", "elapsed_s": round(el, 1)}
    if rc is None:
        return _fail_row(row, err)
    try:
        d = json.loads(out)
        s = d.get("summary", {})
        row.update(status="OK", vintage="live-probe (git mtimes at call time)",
                   summary={"n": s.get("n"), **(s.get("bands") or {}),
                            "cold_frac": round(s.get("cold_frac", 0), 4)},
                   top3=[{"ref": p.get("path"), "metric": f"{p.get('band')} {p.get('score')}"}
