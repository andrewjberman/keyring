    except Exception as e:  # noqa: BLE001
        row.update(status="DEGRADED", vintage="live-probe", summary={}, top3=[],
                   note=f"parse: {type(e).__name__}: {e}")
    return row


def axis_pulse() -> dict:
    # exit 1 = the immune response FIRING -- a DATA state, not a failure (canonical_call note).
    # bash-shebang reader -> _git_bash() (a bare 'bash' resolves to the WSL relay and dies).
    rc, out, el, err = _run([_git_bash(), os.path.join(TOOLS, "comp-pulse"),
                             "--top", "3", "--json"], DEFAULT_TIMEOUT_S)
    row = {"axis": "pulse", "drill": "comp-pulse [--days 7] [--top 8]", "elapsed_s": round(el, 1)}
    if rc is None:
        return _fail_row(row, err)
    try:
        d = json.loads(out)
        srcs = d.get("sources", {})
        stale_srcs = sorted(k for k, v in srcs.items() if (v or {}).get("stale"))
        row.update(status="OK",
                   vintage=f"generated {d.get('generated_at')}"
                           + (f"; STALE sources: {','.join(stale_srcs)}" if stale_srcs else ""),
                   summary={"rail_rows_in_window": (srcs.get("rail") or {}).get("rows_in_window"),
                            "firing": 1 if rc == 1 else 0, "stale_sources": len(stale_srcs)},
                   top3=[{"ref": h.get("ref"), "metric": f"attention {h.get('attention')}"}
                         for h in (d.get("hot") or [])[:3]],
                   note="REFLEX FIRING (exit 1) -- a held node is under active traffic" if rc == 1 else "")
    except Exception as e:  # noqa: BLE001
        row.update(status="DEGRADED", vintage="unknown", summary={}, top3=[],
                   note=f"parse: {type(e).__name__}: {e}")
    return row


_FRESH_ROW = re.compile(r"^(\S+)\s+\|\s+(\S+)\s+\|\s+(\S+)\s+\|\s+([\d.]+h|N/A)\s+\|\s+\S+\s+\|\s+(PASS|WARN|FAIL)\s*$")


def axis_freshness() -> dict:
    rc, out, el, err = _run([sys.executable, os.path.join(TOOLS, "comp-freshness"), "all"],
                            FRESHNESS_TIMEOUT_S)
    row = {"axis": "freshness", "drill": "comp-freshness chain {bd|inf} | script <id>",
           "elapsed_s": round(el, 1)}
    if rc is None:
        return _fail_row(row, err)
    counts = {"PASS": 0, "WARN": 0, "FAIL": 0}
    fails = []
    for ln in out.splitlines():
        m = _FRESH_ROW.match(ln.strip())
        if m:
            counts[m.group(5)] += 1
            if m.group(5) == "FAIL":
                age = m.group(4)
                fails.append({"ref": m.group(1), "metric": f"FAIL age={age}"})
    fails.sort(key=lambda r: float(r["metric"].split("=")[-1].rstrip("h"))
               if r["metric"].split("=")[-1].rstrip("h").replace(".", "").isdigit() else 0,
               reverse=True)
    row.update(status="OK" if sum(counts.values()) else "DEGRADED",
               vintage="live-probe (S3/DDB LastModified at call time)",
               summary=counts, top3=fails[:3],
               note="ages are WALL-CLOCK -- resolve the trading calendar before reading any FAIL "
                    "as an outage (CLAUDE.md NEVER#1; T-1 default)")
    return row


