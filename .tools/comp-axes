def append_history(rows: list, run_at: str) -> None:
    os.makedirs(os.path.dirname(HISTORY_PATH), exist_ok=True)
    with open(HISTORY_PATH, "a", encoding="utf-8") as f:
        for r in rows:
            f.write(json.dumps({"run_at": run_at, **r}, sort_keys=True, default=str) + "\n")
    print(f"OK: HISTORY_APPENDED rows={len(rows)} -> {os.path.relpath(HISTORY_PATH, WS)}")
    try:
        import boto3
        key = f"{MIRROR_PREFIX}{run_at.replace(':', '').replace('-', '')}.jsonl"
        body = "".join(json.dumps({"run_at": run_at, **r}, sort_keys=True, default=str) + "\n"
                       for r in rows).encode()
        boto3.client("s3", region_name="us-east-1").put_object(
            Bucket=MIRROR_BUCKET, Key=key, Body=body, ContentType="application/json")
        print(f"OK: HISTORY_MIRRORED s3://{MIRROR_BUCKET}/{key}")
    except Exception as e:  # noqa: BLE001 -- mirror is best-effort; local history already landed
        print(f"WARN: HISTORY_MIRROR_FAIL err={type(e).__name__}: {e} (local history landed)")


def load_history() -> list:
    if not os.path.isfile(HISTORY_PATH):
        return []
    out = []
    with open(HISTORY_PATH, encoding="utf-8") as f:
        for ln in f:
            ln = ln.strip()
            if ln:
                try:
                    out.append(json.loads(ln))
                except ValueError:
                    print(f"WARN: HISTORY_ROW_UNPARSEABLE (skipped): {ln[:80]}")
    return out


# ---------------------------------------------------------------------------------------------
# Delta
# ---------------------------------------------------------------------------------------------
def compute_delta(rows: list, since: str | None) -> list:
    """Per axis: latest row vs baseline (previous row, or the last row at/before `since`).
    Returns [{axis, from, to, summary_delta:{k:(old,new)}, entered:[refs], left:[refs]}]."""
    by_axis: dict = {}
    for r in sorted(rows, key=lambda x: x.get("run_at", "")):
        by_axis.setdefault(r.get("axis"), []).append(r)
    out = []
    for axis, hist in sorted(by_axis.items()):
        if len(hist) < 2:
            out.append({"axis": axis, "note": f"only {len(hist)} row(s) -- no delta yet"})
            continue
        latest = hist[-1]
        if since:
            base = next((h for h in reversed(hist[:-1]) if h.get("run_at", "") <= since), hist[0])
        else:
            base = hist[-2]
        sd = {}
        for k in sorted(set(latest.get("summary") or {}) | set(base.get("summary") or {})):
            old, new = (base.get("summary") or {}).get(k), (latest.get("summary") or {}).get(k)
            if old != new:
                sd[k] = (old, new)
        old_refs = {t.get("ref") for t in (base.get("top3") or [])}
        new_refs = {t.get("ref") for t in (latest.get("top3") or [])}
        out.append({"axis": axis, "from": base.get("run_at"), "to": latest.get("run_at"),
                    "summary_delta": sd,
                    "entered": sorted(new_refs - old_refs), "left": sorted(old_refs - new_refs)})
    return out


