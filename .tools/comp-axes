def _self_test() -> bool:
    results = []

    def check(name, cond, detail=""):
        results.append(bool(cond))
        print(f"  [{'PASS' if cond else 'FAIL'}] {name}" + (f"  -> {detail}" if detail and not cond else ""))

    print("=== comp-axes self-test (parsers / delta / honest-degrade) ===")

    # 1: freshness row parser
    ln = "inf_silver_transactions                | s3://x/                 | 2026-07-10T13:44:22+00:00  | 126.4h   | 48h      | FAIL"
    m = _FRESH_ROW.match(ln.strip())
    check("1  freshness row parser (id/age/status)", bool(m) and m.group(5) == "FAIL" and m.group(4) == "126.4h")

    # 2: debris bands + reap-rank parsers
    b = _DEBRIS_BANDS.search("  bands: HOT=145 COLD-DORMANT=3 TOO-YOUNG=0 STILLBORN-OR-GUARD=40 UNKNOWN=0")
    r = _DEBRIS_REAP.match("      15d dormant  last=2026-06-30  created=2026-06-26  yang-generate-peer-performance")
    check("2  debris parsers (bands + reap rank)", bool(b) and b.group(2) == "3"
          and bool(r) and r.group(3) == "yang-generate-peer-performance")

    # 3: learns header parser incl. BEHIND
    h = _LEARNS_HDR.search("  assembled-at: 2026-07-15T04:00:53Z  |  DATA VINTAGE: 2026-07-08T18:45:51Z  (BEHIND, binding=code_heat, lag=153.3h)")
    check("3  learns-status header parser (vintage + BEHIND + lag)", bool(h) and h.group(3) == "BEHIND" and h.group(4) == "153.3")

    # 4: fedobs header parser
    f = _FEDOBS_HDR.search("[SERVED vintage (NOT live) as-of 2026-07-15T04:30:38Z  marker_head=cdcdc289bbc9  source=iceberg.globgrph.cse  cse_log_total=342]")
    check("4  fedobs header parser (as-of + marker + cse_log_total)", bool(f) and f.group(3) == "342")

    # 5: delta -- numeric change + top3 membership
    rows = [
        {"run_at": "2026-07-14T00:00:00Z", "axis": "heat", "summary": {"hot": 10}, "top3": [{"ref": "a"}]},
        {"run_at": "2026-07-15T00:00:00Z", "axis": "heat", "summary": {"hot": 12}, "top3": [{"ref": "b"}]},
    ]
    d = compute_delta(rows, None)[0]
    check("5  delta: numeric (10->12) + entered/left membership",
          d["summary_delta"].get("hot") == (10, 12) and d["entered"] == ["b"] and d["left"] == ["a"])

    # 6: delta --since picks the right baseline
    rows.append({"run_at": "2026-07-16T00:00:00Z", "axis": "heat", "summary": {"hot": 15}, "top3": [{"ref": "b"}]})
    d2 = next(x for x in compute_delta(rows, "2026-07-14T23:59:59Z") if x["axis"] == "heat")
    check("6  delta --since baselines at the last row <= since", d2["from"] == "2026-07-14T00:00:00Z"
          and d2["summary_delta"].get("hot") == (10, 15))

    # 7: single-row axis renders an honest no-delta note
    d3 = compute_delta([{"run_at": "x", "axis": "solo", "summary": {}, "top3": []}], None)[0]
    check("7  single-row axis -> honest 'no delta yet' (never a fabricated zero)", "note" in d3)

    # 8: the axis set covers the TO-3 eight
    check("8  adapter registry covers the 8 TO-3 axes",
          set(ADAPTERS) == {"heat", "pulse", "freshness", "debt", "debris", "depth",
                            "learns-gaps", "fedobs-signals"}, str(sorted(ADAPTERS)))

    total, passed = len(results), sum(results)
    print(f"=== {passed}/{total} PASS ===")
    return passed == total


def main() -> int:
    ap = argparse.ArgumentParser(description="comp-axes -- axis directory + snapshot + delta (thin)")
    ap.add_argument("mode", nargs="?", default="directory", choices=["directory", "delta"])
    ap.add_argument("--since", default=None, help="delta baseline: last row at/before this ISO date")
    ap.add_argument("--axes", default=None, help="comma-scoped axis subset (directory mode)")
    ap.add_argument("--no-snapshot", action="store_true", help="directory only; no history append")
    ap.add_argument("--json", action="store_true", help="machine-readable directory")
    ap.add_argument("--self-test", action="store_true")
    args = ap.parse_args()

    if args.self_test:
        return 0 if _self_test() else 1

    if args.mode == "delta":
        hist = load_history()
        if not hist:
            print("ERROR: no history at org/modules/graph/axes_history.jsonl -- run `comp-axes` "
                  "(directory mode) at least twice to have a delta")
            return 1
        return render_delta(compute_delta(hist, args.since))

    wanted = [a.strip() for a in args.axes.split(",")] if args.axes else list(ADAPTERS)
    unknown = [a for a in wanted if a not in ADAPTERS]
    if unknown:
        print(f"ERROR: unknown axes {unknown}; known: {sorted(ADAPTERS)}")
        return 2
    run_at = _now_iso()
    rows = []
    for name in ADAPTERS:
        if name not in wanted:
            print(f"INFO: AXIS_SKIPPED {name} (--axes scope)")
            continue
        rows.append(ADAPTERS[name]())
    if args.json:
        print(json.dumps({"run_at": run_at, "axes": rows}, indent=2, default=str))
    else:
        render_directory(rows, run_at)
    if not args.no_snapshot:
        append_history(rows, run_at)
    degraded = [r["axis"] for r in rows if r["status"] != "OK"]
    if degraded:
        print(f"\nWARN: degraded axes (loud, never silent): {degraded}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
