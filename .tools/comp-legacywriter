#!/usr/bin/env python3
"""comp-legacywriter -- thin PATH wrapper for the WRITER-CONTEST lens.

Routes to the canonical engine org/modules/graph/comp_legacywriter.py. comp-which-routable:
"who writes this artifact, who reads it, is there a legacy writer contesting it, and what breaks
when I delete it".

  comp-legacywriter                          contested locations only (2+ writers), whole population
  comp-legacywriter <key-or-bucket>          scope to one artifact / bucket
  comp-legacywriter --json                   emit JSON alongside the report
  comp-legacywriter --require-live-substrate Phase 0 REFUSES (rc=2) on a stale estate map
  comp-legacywriter --self-test              live-fixture control battery

DISTINCT FROM comp-clobber, and the difference is the reason this exists: comp-clobber's sink
identity is the KEY, and it does not model call DIRECTION. Measured 2026-07-29 -- of its 11
reported multi-writer sinks, 8 are cross-firm path matches (two firm buckets, same key) and one
of those is a pair of `aws s3 cp s3://... /dev/null` EXISTENCE PROBES, not writes. This tool keys
on the (BUCKET, KEY) PAIR and classifies PROBE separately from WRITE.

ADVISORY / READ-ONLY -- it RECOMMENDS a retirement with its evidence bar; the kill rides the
owner's lane, never-widen sign-off and the deploy ledger. No write path to S3, DDB or the repo.

Rule-16 clean: pure python3, no non-default bash utilities.
"""
import os
import runpy
import sys

_HERE = os.path.dirname(os.path.abspath(__file__))  # .tools/
_WS = os.path.dirname(_HERE)                        # repo root
_ENGINE = os.path.join(_WS, "org", "modules", "graph", "comp_legacywriter.py")

# FAIL-LOUD, never silence: a missing engine is an explicit rc=2, not an empty report.
if not os.path.isfile(_ENGINE):
    sys.stderr.write(
        "comp-legacywriter: SOURCE UNRESOLVABLE -- engine missing: %s\n"
        "  rc=2. A tool that cannot name its source must not report on it.\n" % _ENGINE
    )
    sys.exit(2)

sys.argv[0] = "comp-legacywriter"
_rc = 0
try:
    runpy.run_path(_ENGINE, run_name="__main__")
except SystemExit as e:
    _rc = e.code if isinstance(e.code, int) else 0

try:
    sys.argv = ["comp_log_auto.py", "comp-legacywriter", " ".join(sys.argv[1:]), str(_rc)]
    runpy.run_path(
        os.path.join(_WS, "org", "modules", "graph", "comp_log_auto.py"), run_name="__main__"
    )
except Exception:
    pass  # auto-log is best-effort telemetry; it must never change the tool's verdict

sys.exit(_rc)
