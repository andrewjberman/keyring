#!/usr/bin/env python3
"""comp-grep -- RETIRED NAME, now a forwarder onto comp-find (Andrew-direct 2026-08-28, "All approved"
on the /open-calls cards, CTO~D; audit COMPRAIL_GREP_GATE_AUDIT_20260828.md).

comp-find replaced comp-grep on 2026-08-07 (Rule-21 repoint) and nothing has routed here since --
yet the name still ran 824 times between 08-01 and 08-28 (comp-find: 2,696). Two names, one job.
This forwarder maps the old flags onto comp-find and prints ONE WARN line so the habit corrects
itself; the graded output, printed denominator, corpus modes and the rail-log row all come from
comp-find. The 2026-06-18 implementation lives in git history (`git show 05ebf8c4fb^:.tools/comp-grep`).

Flag map:  -i -> -i   |   -l / --files -> --files   |   --max N -> --limit N   |   --include-held -> passthrough
Everything else is passed through unchanged (pattern + pathspecs).
"""
from __future__ import annotations

import os
import subprocess
import sys


def main() -> int:
    argv = sys.argv[1:]
    here = os.path.dirname(os.path.abspath(__file__))
    target = os.path.join(here, "comp-find")
    if not argv or argv[0] in ("-h", "--help"):
        print("comp-grep is RETIRED -> forwards to comp-find. Use: comp-find <pattern> [pathspec ...]")
        print("  (comp-find --help for the graded/paged/corpus flags)")
        return 0
    out: list[str] = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-l", "--files"):
            out.append("--files")
        elif a == "--max":
            i += 1
            out.extend(["--limit", argv[i] if i < len(argv) else "25"])
        else:
            out.append(a)
        i += 1
    print("WARN: comp-grep is retired (2026-08-28); forwarding to: comp-find " + " ".join(out), file=sys.stderr)
    try:
        return subprocess.call([sys.executable, target, *out])
    except OSError as e:
        print(f"ERROR: could not run comp-find at {target}: {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
