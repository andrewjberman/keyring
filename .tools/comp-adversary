# --------------------------------------------------------------------- T11: ADMISSIBILITY
# (2026-09-03, 4.0.0_SA_CRO. The slot above carried this seat's name from 2026-08-19 and stayed
# empty until Andrew's word at the CRO terminal.)
# THE METHOD IN ONE SENTENCE: an evidence item is ADMISSIBLE to the validator of an artifact when it
# sits on the artifact's own dependency graph in the decomposition -- never merely because it shares
# a directory with something the author cited. Full text: org/standards/ADMISSIBILITY_METHOD_T11.md.
# WHY: the pre-T11 source 3 answered "what might the author not have seen" with FILESYSTEM ADJACENCY.
# On TO-CE-T-2 that was 93 siblings led by org/mcp/.exec-sum-state and broker.db-shm -- the siblings
# of the one org/mcp/ path the TO cited -- while the cells the TO actually depended on (CE-t-1,
# CE-tp-1, CE-disc-2, CE-t-3, CE-g-5), their proofs and the PRD rows it named appeared nowhere.
# DEFERRED_SOURCES said so itself: "neighborhood = directory siblings only". This is the wiring.
# ONE HOP: direct depends_on only. Transitive closure is a v2 limb and is stated as a non-application
# in the standard, so a validator never reads "one hop" as "the whole chain".
# The regexes MIRROR .tools/proof-of-spec-check.py :68-70 and :462-473 (the S5 fix @7b649df39d):
# copied, not imported -- that module runs code at import and this tool stays a leaf.
CELL_ID_RE = re.compile(
    r"\b(?:[A-Z][A-Z0-9]*-(?:m-[a-z0-9_]+|[a-z]{1,4}-[a-z]?\d+)"
    r"|L3W3-[0-9a-f]{4}-\d+"
    r"|L3S7B-[0-9a-f]{4}-\d+"
    r"|CARD-R-(?:m-\d+|[0-9a-f]{4}-\d+)"
    r"|INGEST-(?:T\d|CONV|INV)-\d+)\b")
DECOMP_REF_RE = re.compile(r"<decomp_ref>(.*?)</decomp_ref>", re.S)
DECOMP_DOC_TAG_RE = re.compile(r"<decomp_doc>\s*([^<]+?)\s*</decomp_doc>", re.S)
OWNED_CELLS_RE = re.compile(r"<owned_cells>(.*?)</owned_cells>", re.S)
# The PRD sections, outcomes and manifest rows the artifact NAMES -- printed as tokens beside the PRD
# member so the validator opens THOSE sections, never the whole document.
PRD_TOKEN_RE = re.compile(r"\bs\.\d+(?:\.\d+)*\b|\bFWD-\d+\b|\b[TGR]-\d+\b")


def _rel(p):
    try:
        return os.path.relpath(p, repo_root()).replace("\\", "/")
    except ValueError:
        return p.replace("\\", "/")


def _decomp_depends_on(decomp_text):
    """{cell_id: raw depends_on text} from every markdown table in the decomposition whose header
    carries a `depends_on` column. Pipe-split: a literal `|` inside a cell would shift columns.
    The RAW text is returned and printed, so a DROPPED / RETIRED word sitting in that column stays
    visible to the reader instead of being flattened into a bare dependency id."""
    out = {}
    lines = decomp_text.splitlines()
    i = 0
    while i < len(lines):
        ln = lines[i].strip()
        nxt = lines[i + 1].strip() if i + 1 < len(lines) else ""
        if (ln.startswith("|") and nxt.startswith("|")
                and set(nxt.replace("|", "").strip()) <= set("-: ")):
            hdr = [c.strip().strip("`").lower() for c in ln.strip("|").split("|")]
            if "depends_on" not in hdr:
                i += 2
                continue
            di = hdr.index("depends_on")
            i += 2
            while i < len(lines) and lines[i].strip().startswith("|"):
                cols = [c.strip() for c in lines[i].strip().strip("|").split("|")]
                m = CELL_ID_RE.search(cols[0]) if cols else None
                if m and di < len(cols):
                    out.setdefault(m.group(0), cols[di])
                i += 1
            continue
        i += 1
    return out


def decomp_neighborhood(path):
    """T11. (info, None) when the artifact's decomposition neighborhood resolves, else (None, reason)
    -- and the reason is PRINTED, because a fallback to directory siblings must never look like a
    graph read. Every member is a path at read-vintage; absent members print as absent."""
    text = open(path, encoding="utf-8", errors="replace").read()
    to_text, to_path = text, path
    if text.lstrip().startswith("{"):
        # A proof-of-spec instance: follow decomp_ref.to_ref to the governing task order.
        try:
            import json
            ref = (json.loads(text).get("decomp_ref") or {}).get("to_ref") or ""
        except Exception:
            ref = ""
        if not ref:
            return None, "JSON artifact carries no decomp_ref.to_ref -- not the proof of a tree task order"
        cand = ref if os.path.isabs(ref) else os.path.join(repo_root(), ref)
        if not os.path.isfile(cand):
            return None, "decomp_ref.to_ref '%s' does not resolve to a file" % ref
        to_path = cand
        to_text = open(cand, encoding="utf-8", errors="replace").read()
    m = DECOMP_REF_RE.search(to_text)
    if not m:
        return None, "artifact carries no <decomp_ref> -- not a tree task order"
    blob = m.group(1)
    dm = DECOMP_DOC_TAG_RE.search(blob)
    om = OWNED_CELLS_RE.search(blob)
    if not dm or not om:
        return None, "<decomp_ref> lacks a delimited <decomp_doc> or <owned_cells>"
    doc = dm.group(1).strip()
    owned = sorted(set(CELL_ID_RE.findall(om.group(1))))
    if not owned:
        return None, "<owned_cells> names no cell id"
    dabs = doc if os.path.isabs(doc) else os.path.join(repo_root(), doc)
    if not os.path.isfile(dabs):
        return None, "decomposition '%s' does not resolve to a file at read-vintage" % doc
    ddir = os.path.dirname(dabs)
    if os.path.basename(ddir) != "decompositions":
        return None, "decomposition is not under a project tree (no decompositions/ parent) -- flat-root layout"
    proj = os.path.dirname(ddir)
    table = _decomp_depends_on(open(dabs, encoding="utf-8", errors="replace").read())
    deps_decomp, raw = set(), {}
    for c in owned:
        r = table.get(c)
        raw[c] = r
        if r is not None:
            deps_decomp |= set(x for x in CELL_ID_RE.findall(r) if x not in owned)
    body = OWNED_CELLS_RE.sub("", DECOMP_DOC_TAG_RE.sub("", blob))
    deps_to = set(x for x in CELL_ID_RE.findall(body) if x not in owned)
    deps = sorted(deps_decomp | deps_to)
    members = [(_rel(dabs), "decomposition", None, "the rectangle the owned cells live in")]
    to_dir = os.path.join(proj, "task-orders")
    dl_dir = os.path.join(proj, "deliverables")
    owners = {}
    if os.path.isdir(to_dir):
        for fn in sorted(os.listdir(to_dir)):
            fp = os.path.join(to_dir, fn)
            if not fn.endswith(".md") or os.path.abspath(fp) == os.path.abspath(to_path):
                continue
            try:
                t = open(fp, encoding="utf-8", errors="replace").read()
            except OSError:
                continue
            mm = DECOMP_REF_RE.search(t)
            oo = OWNED_CELLS_RE.search(mm.group(1)) if mm else None
            if not oo:
                continue
            for c in CELL_ID_RE.findall(oo.group(1)):
                if c in deps:
                    owners.setdefault(c, []).append(fp)
    unproven, proofs_found = set(), 0
    for c in deps:
        tos = owners.get(c, [])
        if not tos:
            members.append((None, "dependency-cell", c,
                            "NO task order owns this cell -- spec-level, unissued, or withdrawn"))
            unproven.add(c)
            continue
        for fp in tos:
            members.append((_rel(fp), "dependency-to", c, "owns the cell"))
            stem = os.path.basename(fp)[:-3]
            found = []
            if os.path.isdir(dl_dir):
                for seat in sorted(os.listdir(dl_dir)):
                    pp = os.path.join(dl_dir, seat, stem + ".proof_of_spec.json")
                    if os.path.isfile(pp):
                        found.append(pp)
            if found:
                for pp in found:
                    members.append((_rel(pp), "dependency-proof", c, "proof-of-spec instance at read-vintage"))
                    proofs_found += 1
            else:
                members.append((None, "dependency-proof", c,
                                "NO proof-of-spec instance under deliverables/*/ -- the dependency is UNPROVEN"))
                unproven.add(c)
    prd = None
    prd_dir = os.path.join(proj, "prd")
    if os.path.isdir(prd_dir):
        for fn in sorted(os.listdir(prd_dir)):
            if fn.endswith("_PRD.md"):
                prd = os.path.join(prd_dir, fn)
                break
    toks = sorted(set(PRD_TOKEN_RE.findall(to_text)))
    if prd:
        members.append((_rel(prd), "prd", None,
                        "sections named by the artifact: %s" % (", ".join(toks[:20]) or "none by token")))
    return {"decomp": _rel(dabs), "project": _rel(proj), "owned": owned, "deps": deps,
            "deps_decomp": sorted(deps_decomp), "deps_to": sorted(deps_to), "raw": raw,
            "members": members, "unproven": sorted(unproven), "proofs_found": proofs_found}, None


def _emit(body, out_path):
    if out_path:
        with open(out_path, "w", encoding="utf-8") as f:
            f.write(body)
        print("declaration written: %s (%d bytes)" % (out_path, len(body)))
    else:
        print(body)


def _packet_section(siblings, cited, artifact_date, budget, per_file_bytes, no_packet,
                    domain_label="uncited siblings"):
    """STAGE 4. Emits the declared selection rule, its class census, the digests, and -- the
    part that carries the contract -- what it did NOT digest and why. `domain_label` names the
    source-3 set the packet selects from: directory siblings before T11, the decomposition
    neighborhood's members when T11 resolves. The DOMAIN is printed, never only implied."""
    L = []
    L.append("### source 5: comp-read digests of the complement (THE PACKET -- stage 4)")
    if no_packet:
        L.append("  SKIP: --no-packet given. Stage 4 was DISABLED BY THE CALLER for this run;")
        L.append("  the complement above is POINTERS ONLY. This is a caller's choice, recorded")
        L.append("  here so the validator never reads a pointer list as a digested one.")
        L.append("")
        return L
    rows, s1_note = classify_salience(siblings, cited, artifact_date)
    order = {c[0]: i for i, c in enumerate(SALIENCE_CLASSES)}
    ranked = sorted(rows, key=lambda r: (order[r[1]], r[0]))
    census = {c[0]: [0, 0] for c in SALIENCE_CLASSES}     # [selected, total]
    for _, c in rows:
        census[c][1] += 1
    selected, skipped_binary = [], 0
    for p, c in ranked:
        if len(selected) >= budget:
            break
        if p.lower().endswith(BINARY_EXT):
            skipped_binary += 1
            continue
        selected.append((p, c))
        census[c][0] += 1
    L.append("  selection rule: ADVERSARIAL SALIENCE, one axis, first-match-wins over "
             "S1>S2>S3>S4 (MECE by construction; full record in the source header)")
    for cid, nm, why in SALIENCE_CLASSES:
        L.append("    %s %-10s %s" % (cid, nm, why))
    if s1_note:
        L.append("  S1 NOTE: %s" % s1_note)
    L.append("  domain: %s (the source-3 set)" % domain_label)
    L.append("  budget: %d file(s) at <=%d bytes each (raise with --digest-budget/--digest-bytes)"
             % (budget, per_file_bytes))
    L.append("  selected: %d of %d %s" % (len(selected), len(rows), domain_label))
    L.append("  class census: %s" % ", ".join(
        "%s %d/%d" % (cid, census[cid][0], census[cid][1]) for cid, _, _ in SALIENCE_CLASSES))
    not_digested = len(rows) - len(selected)
    L.append("  NOT DIGESTED: %d of %d %s -- %d beyond the budget, %d non-text (comp-read "
             "is a text instrument; binaries stay in the denominator, never dropped)"
             % (not_digested, len(rows), domain_label, max(0, not_digested - skipped_binary),
                skipped_binary))
    summary_at = len(L)   # F2: the DEFERRED line is inserted HERE after the digests run
    L.append("  WARN: THE PACKET IS A SELECTION, NOT A SURVEY. A file's ABSENCE from the "
             "digests below is a BUDGET fact, never an assessment that it did not matter.")
    L.append("")
    total_bytes = 0
    deferred = 0
    bases = {}
    for i, (p, c) in enumerate(selected, 1):
        txt, err = _comp_read_digest(p, per_file_bytes)
        L.append("  --- digest %d/%d: %s [class %s]" % (i, len(selected), p, c))
        if err:
            deferred += 1
            L.append("      DEFERRED: %s" % err)
            continue
        total_bytes += len(txt)
        # Q4 CONSUMER HALF (2026-09-02). This packet embeds comp-read's stdout VERBATIM, so the
        # backend comp-read chose IS part of this declaration's content. 1.0.0_SA_CTO 90547 ruled
        # the shebang fix and this update move TOGETHER precisely because landing the producer
        # alone would have SILENTLY altered every validation_context_declaration the estate emits.
        # The remedy is not to freeze the digest -- it is to make the basis VISIBLE, so a reader
        # comparing two declarations can see WHY they differ instead of inferring drift.
        _b = _digest_basis(txt)
        bases[_b] = bases.get(_b, 0) + 1
        L.append("      digest basis: %s" % _b)
        for ln in txt.splitlines():
            L.append("  | " + ln)
        L.append("")
    # F2 (NFRA_COMPEFFICACY T-16, 2026-09-02): with every digest timed out this roll-up used to read
    # exactly as a healthy run -- terminal-honest/artifact-lies. The bucket is ALWAYS printed, so its
    # absence can never be read as zero.
    L.insert(summary_at, "  DEFERRED: %d of %d selected digest(s) did not return -- each names its reason "
             "below; for those files this packet is POINTERS ONLY" % (deferred, len(selected)))
    L.append("  packet: %d digest(s) delivered, %d deferred, %d bytes total"
             % (len(selected) - deferred, deferred, total_bytes))
    if bases:
        L.append("  digest bases: %s" % ", ".join(
            "%s x%d" % (k, v) for k, v in sorted(bases.items(), key=lambda kv: -kv[1])))
        L.append("  ^ the BACKEND comp-read used per file. A change here changes this packet's "
                 "CONTENT, so it is declared rather than left for a diff to discover. Extensionless "
                 "python (the comp-* tools) reads via python-ast as of 2026-09-02; before that it "
                 "fell to top-level-keys and enumerated UNBANDED.")
    L.append("")
    return L


def compose(path, out_path, cap, open_mode=False, digest_budget=12, digest_bytes=2400,
            no_packet=False):
    now = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    head = _git("rev-parse", "--short=10", "HEAD").stdout.strip()
    L = []
    L.append("# validation_context_declaration -- comp-adversary v1")
    L.append("family: L0a boundary_report SIBLING (declaration + conformance + pins + denominators)")
    L.append("read-vintage: HEAD @%s at %s  [pin kind: read-vintage]" % (head, now))
    if open_mode:
        L.append("mode: OPEN (model-prior validator -- NO estate context composed BY DESIGN)")
        L.append("")
        L.append("## DECLARATION")
        L.append("The validator receives ZERO estate context. Every conclusion drawn in this mode")
        L.append("rests on model priors plus the artifact under review alone -- estate-grounded")
        L.append("verification is DECLARED ABSENT, not implied.")
        L.append("")
        L.append("## DENOMINATORS")
        L.append("complement sources run: 0 / 0 applicable (open mode)")
        body = "\n".join(L) + "\n"
        _emit(body, out_path)
        return body
    prof = parse_artifact(path)
    rel, avin, adate = artifact_vintage(path)
    L.append("artifact: %s" % rel)
    L.append("artifact-vintage: %s (%s)" % (avin or "UNCOMMITTED", (adate or "n/a")[:19]))
    L.append("")
    L.append("## AUTHOR PROFILE (what the author's evidence context WAS)")
    L.append("pins found: %d commits, %d repo paths, %d file:line cites, %d tool mentions"
             % (len(prof["commits"]), len(prof["paths"]), len(prof["filelines"]), len(prof["tools"])))
    if prof["tools"]:
        L.append("tools cited: %s" % ", ".join(prof["tools"]))
    if not prof["commits"] and not prof["paths"]:
        L.append("!! ZERO MACHINE-EXTRACTABLE PINS: this artifact's evidence is prose-cited or")
        L.append("!! externally homed -- the validator must derive the evidence set BY READING.")
        L.append("!! Every complement source below ran against an EMPTY profile and says so in")
        L.append("!! its own denominator. A zero here is a signal, never a clean pass.")
    # SHARPER TRIGGER (2026-09-02, 3.0.0_SA_CVO finding 90279 s.2, recommendation adopted):
    # WARN: THE GUARD ABOVE FIRES ONLY ON A TOTALLY EMPTY PROFILE, AND THAT IS THE WRONG HALF OF THE
    # CLASS. Measured by that seat, two runs bracketing the trigger exactly:
    #     0 commits, 0 paths, 0 tools -> banner FIRES     (already looks suspicious)
    #     0 commits, 1 path,  0 tools -> banner SILENT    (looks WELL-EVIDENCED, and was not)
    # The silent case is the dangerous one: an artifact that cites paths reads as well-grounded
    # while every commit pin was silently dropped by the parser. The predicate below is what
    # that seat recommended -- warn when hashes EXIST IN THE BYTES but zero PARSED -- and it
    # needs no new source, only the denominator parse_artifact now carries.
    if not prof["commits"] and prof["raw_hex"]:
        L.append("!! HEX RUNS PRESENT BUT ZERO PARSED AS PINS (%d run(s)): %s"
                 % (len(prof["raw_hex"]), ", ".join(prof["raw_hex"][:8])
                    + (" ..." if len(prof["raw_hex"]) > 8 else "")))
        L.append("!! The pin parser saw NOTHING while the bytes carry commit-shaped hex. Either")
        L.append("!! these are digests/ETags/snapshot-ids (not pins -- fine), or the citation")
        L.append("!! form is one COMMIT_RE cannot read, in which case source 1's '0 attempted'")
        L.append("!! is a PARSER zero, not an evidence zero. They are byte-identical in output.")
        L.append("!! The runs are printed so this is inspectable rather than merely alarming.")
    elif prof["unparsed_hex"]:
        # Partial: some pins parsed, others did not. Lower severity, still worth the denominator.
        L.append("!! %d hex run(s) not parsed as pins (%d were): %s"
                 % (len(prof["unparsed_hex"]), len(prof["commits"]),
                    ", ".join(prof["unparsed_hex"][:6])
                    + (" ..." if len(prof["unparsed_hex"]) > 6 else "")))
        L.append("!! Expected for digests/ETags. Check none is a pin in a form COMMIT_RE misses.")
    L.append("")
    L.append("## COMPLEMENT (what the validator should know the author may NOT have seen)")
    L.append("")
    cr = verify_commits(prof["commits"])
    bad = [c for c, v in cr if v != "VERIFIED"]
    L.append("### source 1: cited-commit verification (%d attempted / %d verified / %d UNVERIFIABLE)"
             % (len(cr), len(cr) - len(bad), len(bad)))
    # EVERY pin's verdict prints, VERIFIED included (MSTR finding 64159: a verified pin that is
    # counted but never printed leaves nothing for a control to assert about the verification
    # path -- the silence about successes is what made self-test control 2 reach for the
    # read-vintage header and go anti-correlated in both directions).
    for c, v in cr:
        L.append("  - @%s : %s" % (c, v))
    if cr and not bad:
        L.append("  - all cited commits resolve at read-vintage")
    L.append("")
    vr = vintage_check(prof["paths"], adate)
    moved = [x for x in vr if x[1] != "STABLE"]
    L.append("### source 2: cited-path vintage (%d attempted / %d stable / %d flagged)"
             % (len(vr), len(vr) - len(moved), len(moved)))
    for p, v, why in moved:
        L.append("  - %s : %s (%s)" % (p, v, why))
    L.append("")
    nb, nb_total, nb_full = uncited_neighbors(prof["paths"], cap)
    dn, dn_err = decomp_neighborhood(path)
    dyn_excl = []
    if dn:
        # T11: the graph resolved. Siblings are DEMOTED, never silently dropped -- their count
        # prints here AND as a declared exclusion below.
        L.append("### source 3: decomposition neighborhood (T11 admissibility -- the cell's graph, "
                 "not the filesystem)")
        L.append("  owned cells: %s | decomposition: %s | project: %s"
                 % (", ".join(dn["owned"]), dn["decomp"], dn["project"]))
        both = sorted(set(dn["deps_decomp"]) & set(dn["deps_to"]))
        d_only = sorted(set(dn["deps_decomp"]) - set(dn["deps_to"]))
        t_only = sorted(set(dn["deps_to"]) - set(dn["deps_decomp"]))
        L.append("  dependencies (ONE HOP): %d -- decomp depends_on column: %s | TO-declared "
                 "read-dependencies: %s"
                 % (len(dn["deps"]), ", ".join(dn["deps_decomp"]) or "none",
                    ", ".join(dn["deps_to"]) or "none"))
        L.append("    in both carriers: %s | decomp-only: %s | TO-only: %s"
                 % (", ".join(both) or "none", ", ".join(d_only) or "none",
                    ", ".join(t_only) or "none"))
        for c, r in dn["raw"].items():
            if r is None:
                L.append("    %s depends_on: (cell not found in a table carrying a depends_on column)" % c)
            else:
                L.append("    %s depends_on (raw): %s"
                         % (c, _ascii(r)[:160] + (" ..." if len(r) > 160 else "")))
        L.append("  members: %d (proof instances found: %d)" % (len(dn["members"]), dn["proofs_found"]))
        for p, kind, cell, note in dn["members"]:
            L.append("  - %s [%s%s] %s" % (p or "(absent)", kind, (" " + cell) if cell else "", note))
        L.append("  UNPROVEN dependencies: %d of %d -- %s"
                 % (len(dn["unproven"]), len(dn["deps"]), ", ".join(dn["unproven"]) or "none"))
        L.append("  directory siblings: DEMOTED under T11 -- %d uncited sibling(s) of cited paths "
                 "NOT shown; filesystem adjacency is not admissible when the decomposition "
                 "resolves (org/standards/ADMISSIBILITY_METHOD_T11.md)" % nb_total)
        dyn_excl.append(("directory-sibling neighborhood (the pre-T11 source 3)",
                         "DEMOTED: the decomposition neighborhood resolved; %d sibling(s) withheld"
                         % nb_total))
        packet_domain = [p for p, _, _, _ in dn["members"] if p]
        domain_label = "neighborhood members"
    else:
        L.append("### source 3: uncited neighborhood (directory siblings of cited paths)")
        L.append("  T11: decomposition neighborhood NOT RESOLVED (%s) -- filesystem adjacency "
                 "stands as the neighborhood" % dn_err)
        L.append("  total uncited siblings: %d (showing %d -- the CAP is declared, not silent)" % (nb_total, len(nb)))
        for p in nb:
            L.append("  - %s" % p)
        packet_domain = nb_full
        domain_label = "uncited siblings"
    L.append("")
    L.extend(_packet_section(packet_domain, prof["paths"], adate, digest_budget, digest_bytes,
                             no_packet, domain_label))
    drift, err = comp_state_drift()
    if err:
        L.append("### source 4: comp-state drift -- DEFERRED (%s)" % err)
    else:
        L.append("### source 4: comp-state drift (raw excerpt -- validator reads full output)")
        for ln in (drift or "(empty)").splitlines()[:12]:
            L.append("  " + ln)
    L.append("")
    L.append("## DECLARED EXCLUSIONS (sources the validator was NOT shown -- v1 contract)")
    for name, why in DEFERRED_SOURCES + dyn_excl:
        L.append("  - %s : %s" % (name, why))
    L.append("")
    L.append("## DENOMINATORS")
    L.append("complement sources: %d run / %d deferred-with-reason / %d declared-excluded"
             % ((3 if no_packet else 4) + (0 if err else 1), (1 if err else 0),
                len(DEFERRED_SOURCES) + len(dyn_excl)))
    L.append("pin kinds: all pins in this declaration are READ-VINTAGE (declaration-vintage pins")
    L.append("appear only where the artifact itself recorded one -- trace-to-authority claims are")
    L.append("UNANSWERABLE from this declaration alone and are not implied).")
    body = "\n".join(L) + "\n"
    _emit(body, out_path)
    return body


