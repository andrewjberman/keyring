        out = args[args.index("--out") + 1] if "--out" in args else None
        cap = int(args[args.index("--max-neighbors") + 1]) if "--max-neighbors" in args else 25
        budget = int(args[args.index("--digest-budget") + 1]) if "--digest-budget" in args else 12
        dbytes = int(args[args.index("--digest-bytes") + 1]) if "--digest-bytes" in args else 2400
        compose(path, out, cap=cap, digest_budget=budget, digest_bytes=dbytes,
                no_packet=("--no-packet" in args))
