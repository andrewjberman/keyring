import os
import re
import subprocess
import sys
import tempfile
from datetime import datetime, timezone

ROOT = None


def repo_root():
    global ROOT
    if ROOT is None:
        r = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
        if r.returncode != 0:
            print("ERROR: not in a git repo (comp-adversary is repo-scoped)")
            sys.exit(2)
        ROOT = r.stdout.strip()
    return ROOT


def _git(*args):
    return subprocess.run(["git", "-C", repo_root()] + list(args), capture_output=True, text=True)


COMMIT_RE = re.compile(r"@`?([0-9a-f]{7,40})\b")
# BACKTICK FIX (2026-09-02; 3.0.0_SA_CVO findings 90276-90279, bound 1, reproduced independently
# 3 days after the design note's own 08-28 reproduction). The pattern required a hex digit
# IMMEDIATELY after `@`, so the estate's most common markdown pin form -- @`<hash>` -- matched
# NOTHING and source 1 reported "0 attempted / 0 verified / 0 UNVERIFIABLE".
# WARN: THAT ZERO READS AS "0 PROBLEMS". A pin the parser cannot see is indistinguishable, in the
# output, from an artifact that cited no commits at all.
# MEASURED on the specimen before and after (ANDREW_DIRECT_20260828_MSTR_INTEGRATOR_AND_
# OBSERVER_ONLY.md, 1 raw hex run, ctx ' @`6bac8e6cdb` '):
#     before  @([0-9a-f]{7,40})\b   -> []
#     after   @`?([0-9a-f]{7,40})\b -> ['6bac8e6cdb']
# Scoped deliberately to an optional backtick after `@`: a BARE backticked hex run with no `@`
# is NOT treated as a pin, because md5s, S3 ETags and snapshot ids are also backticked hex and
# promoting them to commits would manufacture UNVERIFIABLE noise. The zero-pin guard below is
# what covers that residue -- it reports unparsed hex runs instead of guessing at them.
# TRUNCATION FIX (Andrew-PRIORITIZED 2026-08-20, VERBATIM: "truncated outputs is a very risky
# error type and one we've seen crop up many times").
# The trailing \b was satisfied by the FIRST dot-segment that could pass as an extension, so a
# BARE SERIAL-NAMED DIRECTORY truncated instead of not matching:
#     "org/tier2_senior/0.8.0_AE_CloudComp"   ->  extracted  "org/tier2_senior/0.8"
# `.8` reads as a one-char extension and the NEXT character is `.`, a non-word char, so \b HOLDS.
# The truncated path does not exist, so source 2 then reported a confident GONE about a path
# NOBODY CITED -- a well-formed answer about a TRUNCATED input, which is exactly the class Andrew
# named. Measured 4/4 false GONEs across serial-named dirs before this fix; every seat folder in
# org/ carries dots, so the blast radius was every citation of a seat directory.
# The lookahead requires the match to END at a real token boundary -- a path may not be followed
# by another path character. A bare directory now yields NO MATCH (correct: it is not a file
# citation) rather than a truncated one, and every real file path extracts byte-identically.
PATH_RE = re.compile(r"\b((?:org|docs|infra|data|portal|rcg|workflows)/[A-Za-z0-9_\-./~]+\.[A-Za-z0-9]{1,6})(?![A-Za-z0-9_\-./~])")
TOOL_RE = re.compile(r"\b(comp-[a-z0-9\-]+|to-check\.py|safe-commit|safe-apply|safe-deploy)\b")
FILELINE_RE = re.compile(r"\b([A-Za-z0-9_\-./]+\.(?:py|ts|tsx|sh|yaml|yml|json|md)):(\d+)\b")
# Any bare hex run that could be a commit-ish. Deliberately NOT used to extract pins (see the
# COMMIT_RE note) -- only to COUNT what the pin parser may have failed to see.
RAW_HEX_RE = re.compile(r"\b[0-9a-f]{7,40}\b")


def parse_artifact(path):
    text = open(path, encoding="utf-8", errors="replace").read()
    commits = sorted(set(COMMIT_RE.findall(text)))
    paths = sorted(set(p for p in PATH_RE.findall(text) if not p.endswith((".png", ".jpg"))))
    tools = sorted(set(TOOL_RE.findall(text)))
    filelines = sorted(set(FILELINE_RE.findall(text)))
    # Every hex run that COULD be a commit pin, whether or not COMMIT_RE claimed it. This is the
    # denominator the zero-pin guard needs: "hashes exist in the bytes but zero PARSED" is a
    # strictly sharper alarm than "the profile is empty", and it is the only way a FUTURE
    # unparsed pin form announces itself instead of rendering as a clean zero.
    raw_hex = sorted(set(RAW_HEX_RE.findall(text)))
    return {"text_len": len(text), "commits": commits, "paths": paths,
            "tools": tools, "filelines": filelines, "raw_hex": raw_hex,
            "unparsed_hex": [h for h in raw_hex if h not in set(commits)]}


def verify_commits(commits):
    rows = []
    for c in commits:
        r = _git("cat-file", "-t", c)
        ok = (r.returncode == 0 and r.stdout.strip() == "commit")
        rows.append((c, "VERIFIED" if ok else "UNVERIFIABLE-PIN"))
    return rows


def artifact_vintage(path):
    rel = os.path.relpath(path, repo_root()).replace("\\", "/")
    r = _git("log", "-1", "--format=%H %cI", "--", rel)
    if r.returncode == 0 and r.stdout.strip():
        h, d = r.stdout.strip().split(" ", 1)
        return rel, h[:10], d
    return rel, None, None


def vintage_check(paths, artifact_date):
    rows = []
    for p in paths:
        ap = os.path.join(repo_root(), p)
        if not os.path.exists(ap):
            rows.append((p, "GONE", "cited path absent at read-vintage"))
            continue
        r = _git("log", "-1", "--format=%cI", "--", p)
        last = r.stdout.strip() if r.returncode == 0 else ""
        if artifact_date and last and last > artifact_date:
            rows.append((p, "MOVED-SINCE-AUTHORING", "last change %s postdates the artifact" % last[:19]))
        else:
            rows.append((p, "STABLE", "no change after the artifact's vintage" if last else "untracked/no history"))
    return rows


def uncited_neighbors(paths, cap):
    """Returns (capped_display_list, total, full_list). The FULL list is what stage 4
    classifies -- selecting from a list that was already capped for display would silently
    scope the packet to the display cap, a different (and unstated) selection rule."""
    cited = set(paths)
    cited_dirs = {}
    for p in paths:
        cited_dirs.setdefault(os.path.dirname(p), True)
    full = []
    for d in sorted(cited_dirs):
        ad = os.path.join(repo_root(), d)
        if not os.path.isdir(ad):
            continue
        try:
            sibs = sorted(x for x in os.listdir(ad) if os.path.isfile(os.path.join(ad, x)))
        except OSError:
            continue
        for s in sibs:
            rp = (d + "/" + s).lstrip("/")
            if rp not in cited:
                full.append(rp)
    return full[:cap], len(full), full


# --------------------------------------------------------------------- STAGE 4: THE PACKET
# THE SELECTION RULE, as a SCHEMA (CLAUDE.md Rule 24 TAXONOMY LAW -- a value-enum an agent
# authors arrives with its four-postulate record or it is not a proposal):
#
#   AXIS (one, and only one): ADVERSARIAL SALIENCE -- how likely is it that this uncited file,
#   if the validator read it, would CHANGE the conclusion the author reached? Not "importance",
#   not "recency" alone: those are different axes and mixing them is the intent-coherence defect.
#
#   (i) MECE over the DECLARED domain. Domain = every uncited directory sibling of a cited path
#       (the source-3 set). Classes are evaluated FIRST-MATCH-WINS in the order below, which
#       makes the partition exhaustive and disjoint BY CONSTRUCTION -- every member lands in
#       exactly one class, and the class census in the output sums to the domain.
#   (ii) SAME GRAIN. Every class is at FILE grain. No class is a directory or a topic.
#   (iii) INTENT COHERENCE. One axis (salience), one intent (what to spend the budget on).
#         Budget size is a SEPARATE knob (--digest-budget); it is not a class.
#   (iv) STATE COHERENCE -- which values one remedy does NOT move:
#         * Re-running at a later vintage moves S1 membership ONLY (S1 is vintage-indexed).
#           It does NOT move S2/S3/S4, which are structural.
#         * The author citing MORE paths moves S2 and S3 (both are relative to the citation
#           set) and can move a file OUT of the domain entirely. It does NOT move S1.
#         * Raising --digest-budget moves what is SELECTED. It moves no file's CLASS.
#
#   S1 POSTDATES  the sibling changed AFTER the artifact's vintage. The author could not have
#                 read what it says now -- the strongest "the world moved under the author" case.
#   S2 KIN        the sibling shares a filename stem with something the author DID cite: the
#                 sibling member / wrong-version class (they read v1, v2 sat beside it).
#   S3 DENSE      the sibling sits in a directory the author cited 2+ times -- demonstrably
#                 their working area, so an omission there is a choice, not distance.
#   S4 PERIPHERAL everything else: a sibling of a directory touched exactly once.
#
# WARN: THE RULE IS DECLARED IN THE OUTPUT, NEVER ONLY HERE. A selection rule buried in code is
# indistinguishable to a validator from an arbitrary truncation.
SALIENCE_CLASSES = [
    ("S1", "POSTDATES", "changed after the artifact's vintage -- author could not have read this"),
    ("S2", "KIN", "shares a filename stem with a CITED path -- sibling-member/wrong-version class"),
    ("S3", "DENSE", "in a directory the author cited 2+ times -- demonstrably their working area"),
    ("S4", "PERIPHERAL", "sibling of a directory the author cited once"),
]
# Non-text members of the domain: they are CLASSIFIED (they stay in the denominator) but never
# digested -- comp-read is a text instrument and a binary digest would be noise wearing evidence
# clothing. Declared in the output as a named exclusion, never dropped silently.
BINARY_EXT = (".png", ".jpg", ".jpeg", ".gif", ".pdf", ".zip", ".gz", ".xlsx", ".pptx", ".docx",
              ".pkl", ".parquet", ".ico", ".woff", ".woff2", ".ttf", ".exe", ".dll", ".pyc")


def _ascii(s):
    """comp-read reads source files with errors='replace', so a digest can carry U+FFFD out of
    any file that is not clean ASCII. This declaration gets WRITTEN TO DISK, and CLAUDE.md bans
    non-ASCII in production output -- so the packet sanitizes rather than propagating."""
    return "".join(ch if 32 <= ord(ch) < 127 or ch in "\n\t" else "?" for ch in s)


def paths_changed_since(since_iso):
    """ONE git call for the whole S1 question. The per-file form (git log -1 -- <path>) is 542
    subprocesses on the measured artifact; this is one, and it asks the same question."""
    if not since_iso:
        return set(), "artifact has no commit vintage -- S1 is UNRESOLVABLE and reads empty"
    r = _git("log", "--since=%s" % since_iso, "--name-only", "--format=")
    if r.returncode != 0:
        return set(), "git log --since rc=%d -- S1 DEFERRED" % r.returncode
    return set(x.strip() for x in r.stdout.splitlines() if x.strip()), None


def classify_salience(siblings, cited, artifact_date):
    changed, s1_note = paths_changed_since(artifact_date)
    stems = set()
    for p in cited:
        b = os.path.basename(p)
        stems.add(b.rsplit(".", 1)[0].lower())
    dense = {}
    for p in cited:
        d = os.path.dirname(p)
        dense[d] = dense.get(d, 0) + 1
    rows = []
    for p in siblings:
        stem = os.path.basename(p).rsplit(".", 1)[0].lower()
        kin = stem in stems or any(
            (stem.startswith(s) or s.startswith(stem)) and min(len(stem), len(s)) >= 8
            for s in stems)
        if p in changed:
            cls = "S1"
        elif kin:
            cls = "S2"
        elif dense.get(os.path.dirname(p), 0) >= 2:
            cls = "S3"
        else:
            cls = "S4"
        rows.append((p, cls))
    return rows, s1_note


def _digest_basis(txt):
    """The backend comp-read used, lifted from its own header line:
        '  574 lines | 22 section(s) via python-ast | question: ...'
    Returns 'UNDECLARED' when the header is absent or reshaped -- NEVER a guess. A wrong basis
    label is worse than an absent one here, because this string is what a validator compares
    across two declarations to decide whether a digest difference is real."""
    for ln in (txt or "").splitlines()[:6]:
        if " via " in ln and "section(s)" in ln:
            tail = ln.split(" via ", 1)[1]
            return tail.split("|", 1)[0].strip() or "UNDECLARED"
    return "UNDECLARED"


def _comp_read_digest(rel, budget_bytes):
    """Rung 2 of the build ladder: comp-read EXISTS and the spec names it. This shells out to it
    exactly as comp_state_drift() shells out to comp-state -- no second digest engine."""
    tool = os.path.join(repo_root(), ".tools", "comp-read")
    if not os.path.exists(tool):
        return None, "comp-read not present at %s (packet DEFERRED, not silently skipped)" % tool
    try:
        r = subprocess.run(["python", tool, rel], capture_output=True, text=True,
                           timeout=60, cwd=repo_root())
        if r.returncode != 0:
            return None, "comp-read rc=%d" % r.returncode
        txt = _ascii(r.stdout or "")
        if len(txt) > budget_bytes:
            # comp-read's own hard rule 2 is NEVER TRUNCATE SILENTLY. Inherited here.
            txt = txt[:budget_bytes] + (
                "\n... DIGEST TRUNCATED at %d of %d bytes (per-file cap --digest-bytes; the "
                "FULL file is the territory, this was only ever an index into it)\n"
                % (budget_bytes, len(_ascii(r.stdout or ""))))
        return txt, None
    except Exception as e:
        return None, "comp-read unavailable: %s" % type(e).__name__


def comp_state_drift():
    try:
        r = subprocess.run(["python", os.path.join(repo_root(), ".tools", "comp-state"), "--json"],
                           capture_output=True, text=True, timeout=120, cwd=repo_root())
        if r.returncode != 0:
            return None, "comp-state rc=%d (source DEFERRED, not silently skipped)" % r.returncode
        return (r.stdout[:4000] or "").strip(), None
    except Exception as e:
        return None, "comp-state unavailable: %s (source DEFERRED)" % type(e).__name__


