def _resolve_aws_cmd() -> list[str]:
    """Return the command prefix to invoke the aws CLI.

    On Windows the aws CLI ships as aws.CMD which subprocess cannot exec
    directly -- wrap with ['cmd', '/c', path]. On Linux/Mac aws is a binary.
    """
    exe = shutil.which("aws")
    if exe is None:
        raise AwsUnreachable("aws CLI not found in PATH")
    if exe.lower().endswith(".cmd"):
        return ["cmd", "/c", exe]
    return [exe]


def _aws(*args: str, check_aws: bool = True) -> Optional[str]:
    """Run an aws CLI command and return stdout stripped, or None on failure."""
    env = os.environ.copy()
    env["AWS_EC2_METADATA_DISABLED"] = "true"
    try:
        cmd = _resolve_aws_cmd() + list(args)
        result = subprocess.run(cmd, capture_output=True, text=True, env=env, timeout=30)
        if result.returncode != 0:
            if check_aws:
                stderr = result.stderr.strip()
                if "Unable to locate credentials" in stderr or "NoCredentialsError" in stderr:
                    raise AwsUnreachable("AWS credentials not found")
                if "EndpointResolutionError" in stderr or "ConnectTimeoutError" in stderr or "Could not connect" in stderr:
                    raise AwsUnreachable("AWS endpoint unreachable")
            return None
        out = result.stdout.strip()
        return out if out and out != "None" else None
    except subprocess.TimeoutExpired:
        raise AwsUnreachable("AWS CLI timed out (30s)")
    except FileNotFoundError:
        raise AwsUnreachable("aws CLI not found in PATH")


class AwsUnreachable(Exception):
    pass


def _parse_s3_uri(s3_uri: str) -> tuple[str, str]:
    """Parse s3://bucket/prefix into (bucket, prefix)."""
    if not s3_uri.startswith("s3://"):
        raise ValueError(f"Expected s3:// URI, got: {s3_uri!r}")
    without_scheme = s3_uri[len("s3://"):]
    bucket, _, prefix = without_scheme.partition("/")
    return bucket, prefix


def _parse_timestamps_from_raw(raw: str) -> list[datetime.datetime]:
    """Parse all non-null timestamps from potentially multi-line --output text result.

    AWS CLI v2 auto-paginates list-objects-v2 and may apply JMESPath per page,
    producing one line per page. We parse all lines and return valid datetimes.
    """
    results = []
    for line in raw.strip().splitlines():
        line = line.strip()
        if not line or line == "None":
            continue
        try:
            results.append(_parse_timestamp(line))
        except (ValueError, AttributeError):
            pass
    return results


def get_latest_modified(s3_key_prefix: str) -> Optional[datetime.datetime]:
    """
    Return the LastModified timestamp of the most-recent object under s3_key_prefix.

    Strategy (ADHC_COMPIL.012 compiler_tools_mandate):
    1. List with --delimiter / to find partition sub-prefixes (O(1) for Hive-partitioned
       daily data with years of files; preferred over aws s3 ls --recursive which scans
       all objects and is O(n)).
       Parse sub-prefixes in Python (aws CLI v2 text output: one prefix per line).
       Take the lexicographically last sub-prefix as the latest date partition.
    2. If partitions found: list objects in that partition and take max LastModified.
    3. If no partitions (flat or single-file prefix): list directly and take max.
    Note: AWS CLI v2 auto-paginates and may return one result per page for aggregate
    JMESPath queries; _parse_timestamps_from_raw handles multi-line output by taking max.
    """
    try:
        bucket, prefix = _parse_s3_uri(s3_key_prefix)
    except ValueError as e:
        raise ConfigError(str(e))

    # Step 1: partition-aware listing (safe query: CommonPrefixes[*].Prefix returns []
    # when no sub-prefixes; does not fail on null unlike sort_by on null array)
    raw_prefixes = _aws("s3api", "list-objects-v2",
                        "--bucket", bucket,
                        "--prefix", prefix,
                        "--delimiter", "/",
                        "--no-paginate",
                        "--query", "CommonPrefixes[*].Prefix",
                        "--output", "text")

    target_prefix = prefix
    if raw_prefixes and raw_prefixes.strip():
        sub_prefixes = [p.strip() for p in raw_prefixes.strip().split() if "/" in p]
        if sub_prefixes:
            target_prefix = sorted(sub_prefixes)[-1]

    # Step 2: get max LastModified under target_prefix
    # max_by(Contents, &LastModified) returns null (not error) when Contents is empty;
    # multi-line output from auto-pagination is handled by _parse_timestamps_from_raw.
    ts_raw = _aws("s3api", "list-objects-v2",
                  "--bucket", bucket,
                  "--prefix", target_prefix,
                  "--query", "max_by(Contents, &LastModified).LastModified",
                  "--output", "text")
    if ts_raw and ts_raw.strip():
        timestamps = _parse_timestamps_from_raw(ts_raw)
        if timestamps:
            return max(timestamps)

    # Step 3: if target_prefix was a partition and found nothing, fall back to root
    if target_prefix != prefix:
        ts_raw = _aws("s3api", "list-objects-v2",
                      "--bucket", bucket,
                      "--prefix", prefix,
                      "--query", "max_by(Contents, &LastModified).LastModified",
                      "--output", "text")
        if ts_raw and ts_raw.strip():
            timestamps = _parse_timestamps_from_raw(ts_raw)
            if timestamps:
                return max(timestamps)

    return None  # prefix not found or empty


def _parse_timestamp(raw: str) -> datetime.datetime:
    """Parse AWS-style ISO-8601 timestamp (may include microseconds and +00:00 or Z)."""
    raw = raw.strip()
    # Normalize: replace 'Z' with '+00:00', strip microseconds if present
    raw = raw.replace("Z", "+00:00")
    # Handle fractional seconds (up to 6 digits)
    try:
        return datetime.datetime.fromisoformat(raw)
    except ValueError:
        # Fallback: strip fractional seconds
        raw_no_frac = raw.split(".")[0] + "+00:00"
        return datetime.datetime.fromisoformat(raw_no_frac)


