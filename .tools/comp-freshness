class ConfigError(Exception):
    pass


def _load_config(path: Path) -> list[dict]:
    if not path.exists():
        raise ConfigError(f"Config not found: {path}")
    try:
        with open(path, encoding="utf-8") as f:
            data = yaml.safe_load(f)
    except yaml.YAMLError as e:
        raise ConfigError(f"YAML parse error in {path}: {e}")
    if not isinstance(data, list):
        raise ConfigError(f"Config must be a YAML list of artifact entries, got {type(data).__name__}")
    required_fields = {"artifact_id", "s3_key_prefix", "cadence"}
    for i, entry in enumerate(data):
        missing = required_fields - set(entry.keys())
        if missing:
            raise ConfigError(f"Entry {i} missing required fields: {missing}")
    return _filter_partition_key_entries(data, path)


def _filter_partition_key_entries(data: list[dict], path: Path) -> list[dict]:
    """LOAD-FILTER (the load-bearing safety mechanism, CTO-gated 2026-06-26): drop entries
    whose freshness is keyed to a silver date-PARTITION-key (as_of_source: silver-partition-key,
    a freshness_manifest_gen.py / BD-source-bound concept). comp-freshness only knows mtime +
    as_of_field content-mode; mtime-checking a partition-key snapshot table FALSE-REDs every run
    (the config header warns of exactly this -- BD pins a frozen CurrentDay as-of, so a daily
    rewrite has a fresh mtime but a stale stamped as-of). Fail-SAFE: such an entry is SKIPPED
    here (never mtime-mischecked) and announced LOUD, never silently mis-verdicted. (bd/inf carry
    none today -> no-op there; this protects the cot served-config load.)"""
    kept, skipped = [], []
    for e in data:
        if str(e.get("as_of_source", "")).strip() == "silver-partition-key":
            skipped.append(e.get("artifact_id", "?"))
        else:
            kept.append(e)
    if skipped:
        print(f"comp-freshness: NOTE -- {len(skipped)} partition-key entr"
              f"{'y' if len(skipped)==1 else 'ies'} in {path.name} SKIPPED (as_of_source: "
              f"silver-partition-key is freshness_manifest_gen's domain; comp-freshness would "
              f"mtime-mischeck -> false-RED). Skipped: {', '.join(skipped)}", file=sys.stderr)
    return kept


def _load_configs(pipeline: Optional[str] = None) -> tuple[list[dict], list[dict]]:
    """Return (bd_entries, inf_entries) based on pipeline filter."""
    bd_entries: list[dict] = []
    inf_entries: list[dict] = []
    if pipeline in (None, "bd"):
        bd_entries = _load_config(BD_CONFIG)
    if pipeline in (None, "inf"):
        inf_entries = _load_config(INF_CONFIG)
    return bd_entries, inf_entries


def _load_ddb_config() -> list[dict]:
    """Load DDB freshness config from data/ddb_freshness_config.yaml."""
    if not DDB_CONFIG.exists():
        raise ConfigError(f"DDB config not found: {DDB_CONFIG}")
    try:
        with open(DDB_CONFIG, encoding="utf-8") as f:
            data = yaml.safe_load(f)
    except yaml.YAMLError as e:
        raise ConfigError(f"YAML parse error in {DDB_CONFIG}: {e}")
    if not isinstance(data, list):
        raise ConfigError(f"DDB config must be a YAML list, got {type(data).__name__}")
    required_fields = {"table", "pk_prefix", "max_age_hours"}
    for i, entry in enumerate(data):
        missing = required_fields - set(entry.keys())
        if missing:
            raise ConfigError(f"DDB config entry {i} missing required fields: {missing}")
    return data


