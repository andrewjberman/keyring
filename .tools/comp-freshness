# DynamoDB helpers
# ---------------------------------------------------------------------------

def _get_ddb_items(table: str, pk_prefix: str, sk_filter: Optional[str] = None) -> Optional[list[dict]]:
    """Scan DDB table for items with PK beginning with pk_prefix.

    Returns list of raw item dicts (DDB format), or None if table not found.
    Raises AwsUnreachable on credential / network errors.
    """
    env = os.environ.copy()
    env["AWS_EC2_METADATA_DISABLED"] = "true"

    if sk_filter:
        filter_expr = "begins_with(PK, :p) AND SK = :s"
        expr_vals = json.dumps({":p": {"S": pk_prefix}, ":s": {"S": sk_filter}})
    else:
        filter_expr = "begins_with(PK, :p)"
        expr_vals = json.dumps({":p": {"S": pk_prefix}})

    cmd = _resolve_aws_cmd() + [
        "dynamodb", "scan",
        "--table-name", table,
        "--filter-expression", filter_expr,
        "--expression-attribute-values", expr_vals,
        "--output", "json",
    ]
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, env=env, timeout=30)
    except subprocess.TimeoutExpired:
        raise AwsUnreachable(f"DynamoDB scan timed out for table {table!r}")
    except FileNotFoundError:
        raise AwsUnreachable("aws CLI not found in PATH")

    stderr = result.stderr.strip()
    if result.returncode != 0:
        if "ResourceNotFoundException" in stderr or "Requested resource not found" in stderr:
            return None  # table does not exist
        if "Unable to locate credentials" in stderr or "NoCredentialsError" in stderr:
            raise AwsUnreachable("AWS credentials not found")
        if "EndpointResolutionError" in stderr or "ConnectTimeoutError" in stderr:
            raise AwsUnreachable("AWS endpoint unreachable")
        raise AwsUnreachable(f"DynamoDB scan failed: {stderr[:200]}")

    try:
        payload = json.loads(result.stdout)
    except json.JSONDecodeError as e:
        raise AwsUnreachable(f"DynamoDB scan returned invalid JSON: {e}")

    return payload.get("Items", [])


def _extract_ddb_timestamp(item: dict, primary_attr: str, fallback_attr: Optional[str]) -> Optional[datetime.datetime]:
    """Extract a timestamp from a DDB item dict.

    Tries primary_attr first, then fallback_attr.
    DDB string values are wrapped as {"S": "..."}.
    """
    for attr in filter(None, [primary_attr, fallback_attr]):
        raw = item.get(attr)
        if raw and isinstance(raw, dict) and "S" in raw:
            try:
                return _parse_timestamp(raw["S"])
            except (ValueError, AttributeError):
                pass
    return None


def _check_ddb_entry(entry: dict, now: datetime.datetime) -> dict:
    """Check one DDB config entry for freshness.

    Returns result dict with artifact_id, s3_key (reused as ddb_target), last_modified,
    age_h, fail_at_h, status, severity, cadence, notes — same shape as S3 results for
    unified rendering by print_results.
    """
    table        = entry["table"]
    pk_prefix    = entry["pk_prefix"]
    sk_filter    = entry.get("sk_filter")  # may be None or "null"
    ts_attr      = entry.get("timestamp_attr", "updatedAt")
    ts_fallback  = entry.get("fallback_timestamp_attr")
    warn_h       = entry.get("warn_age_hours")
    fail_h       = entry["max_age_hours"]
    severity     = entry.get("severity", "ERROR").upper()

    # "null" string in YAML (unquoted null parses to Python None already, but be safe)
    if sk_filter == "null":
        sk_filter = None

    artifact_id = f"ddb:{table}[{pk_prefix}*]"
    ddb_target  = f"dynamodb://{table}/PK={pk_prefix}*"

    base: dict = {
        "artifact_id":   artifact_id,
        "s3_key":        ddb_target,
        "last_modified": None,
        "age_h":         None,
        "fail_at_h":     fail_h,
        "warn_at_h":     warn_h,
        "status":        "SKIP",
        "severity":      severity,
        "cadence":       "ddb",
        "notes":         entry.get("cadence_note", ""),
    }

    try:
        items = _get_ddb_items(table, pk_prefix, sk_filter if sk_filter else None)
    except AwsUnreachable:
        raise

    if items is None:
        # Table does not exist
        base["status"] = "FAIL" if severity == "ERROR" else "WARN"
        base["notes"]  = f"MISSING: table {table!r} not found in DynamoDB"
        return base

    if not items:
        base["status"] = "WARN"
        base["notes"]  = f"No items found with PK prefix {pk_prefix!r}" + (f" SK={sk_filter!r}" if sk_filter else "")
        return base

    # Find the most-recently-updated item across all matching items
    latest: Optional[datetime.datetime] = None
    for item in items:
        ts = _extract_ddb_timestamp(item, ts_attr, ts_fallback)
        if ts is not None:
            if ts.tzinfo is None:
                ts = ts.replace(tzinfo=datetime.timezone.utc)
            if latest is None or ts > latest:
                latest = ts

    if latest is None:
        base["status"] = "WARN"
        base["notes"]  = f"No timestamp attribute ({ts_attr!r}" + (f" or {ts_fallback!r}" if ts_fallback else "") + ") found on any item"
        return base

    if now.tzinfo is None:
        now = now.replace(tzinfo=datetime.timezone.utc)

    age_h = (now - latest).total_seconds() / 3600.0
    base["last_modified"] = latest.isoformat()
    base["age_h"]         = round(age_h, 1)
    base["notes"]         = f"{len(items)} item(s) checked; " + entry.get("cadence_note", "")

    if age_h >= fail_h:
        base["status"] = "FAIL" if severity == "ERROR" else "WARN"
    elif warn_h is not None and age_h >= warn_h:
        base["status"] = "WARN"
    else:
        base["status"] = "PASS"

    return base


def check_ddb_entries(entries: list[dict]) -> list[dict]:
    """Check all DDB entries in parallel, return results in original order."""
    now = datetime.datetime.now(tz=datetime.timezone.utc)
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        futures = {pool.submit(_check_ddb_entry, e, now): i for i, e in enumerate(entries)}
        results = [None] * len(entries)
        for fut in concurrent.futures.as_completed(futures):
            idx = futures[fut]
            results[idx] = fut.result()
    return results


# ---------------------------------------------------------------------------
# Freshness check logic
# ---------------------------------------------------------------------------
def _status_from_age(age_h: float, warn_h, fail_h, severity: str) -> str:
    """Map an age (hours) to PASS/WARN/FAIL against cadence thresholds. Shared by the
    mtime path and the content path so they cannot drift."""
    if fail_h is not None and age_h >= fail_h:
        return "FAIL" if severity == "ERROR" else "WARN"
    if warn_h is not None and age_h >= warn_h:
        return "WARN"
    return "PASS"


def _parse_as_of(s: str) -> Optional[datetime.datetime]:
    """Parse an artifact's INTERNAL as-of value (a date or timestamp) -> aware UTC datetime.
    Tolerant of date-only ('2026-06-22'), ISO datetime, and trailing Z. Returns None if
    unparseable (caller treats that as content-UNCHECKED, never a silent pass)."""
    s = (s or "").strip()
    if not s:
        return None
    for fmt in ("%Y-%m-%d", "%Y-%m-%dT%H:%M:%S", "%Y-%m-%dT%H:%M:%SZ",
                "%Y-%m-%d %H:%M:%S", "%Y/%m/%d"):
        try:
            dt = datetime.datetime.strptime(s, fmt)
            return dt.replace(tzinfo=datetime.timezone.utc)
        except ValueError:
            continue
    try:
        dt = datetime.datetime.fromisoformat(s.replace("Z", "+00:00"))
        return dt if dt.tzinfo else dt.replace(tzinfo=datetime.timezone.utc)
    except Exception:
        return None


def _resolve_as_of_field(doc, field: str):
    """Resolve a (possibly dotted) as_of field path within a parsed JSON object.
    Returns the value or None if the path is absent."""
    val = doc
    for part in field.split("."):
        if isinstance(val, dict) and part in val:
            val = val[part]
        else:
            return None
    return val


def _evaluate_artifact(entry: dict, now: datetime.datetime,
                       last_modified: Optional[datetime.datetime],
                       content_doc=None, content_error: str = "") -> dict:
    """PURE status evaluation given already-fetched mtime + (optional) parsed object content.
    Separated from I/O so content-mode is unit-testable without AWS.

    CONTENT-MODE (CTO freshness-doctrine spec, 3.0.0_SA_CVO 2026-06-26): when the entry
    declares `as_of_field`, the artifact's INTERNAL as-of date is AUTHORITATIVE and mtime
    is demoted to a secondary sanity signal. mtime-fresh != content-fresh: a re-uploaded
    but stale artifact gets a fresh LastModified while its internal as-of stays old -- the
    EXACT cot freeze (mtime moved, data_as_of stuck at 06-22 -> mtime-only wrongly FRESH).
    False-FRESH on a stale artifact is the dangerous direction; content-mode closes it.
    """
    artifact_id = entry["artifact_id"]
    s3_key = entry["s3_key_prefix"]
    cadence = entry.get("cadence", "daily")
    severity = entry.get("severity", "ERROR").upper()
    warn_h = entry.get("warn_age_hours")
    fail_h = entry.get("fail_age_hours")
    as_of_field = entry.get("as_of_field")

    result = {
        "artifact_id": artifact_id,
        "s3_key":      s3_key,
        "last_modified": None,
        "age_h":       None,
        "fail_at_h":   fail_h,
        "warn_at_h":   warn_h,
        "status":      "SKIP",
        "severity":    severity,
        "cadence":     cadence,
        "notes":       entry.get("notes", ""),
    }

    if cadence == "on-demand":
        result["status"] = "SKIP"
        return result

    # DEPRECATED: an entry for an artifact the pipeline does NOT (or no longer) produces -- a
    # by-design absence. SKIP (not WARN on Prefix-not-found), but surface it as a deprecated
    # FINDING (false-clean discipline: documented, not silently omitted), so a stale config entry
    # is visible + clearable rather than a chronic false-WARN. (CVO 2026-06-26)
    if cadence == "deprecated":
        result["status"] = "SKIP"
        result["notes"] = ("DEPRECATED config entry (by-design absent / not produced) -- "
                           + (result["notes"] or "")).strip(" -")
        return result

    if last_modified is None:
        # Prefix not found: WARN (could be a new artifact not yet populated)
        result["status"] = "WARN"
        result["notes"] = f"Prefix not found in S3: {s3_key}"
        return result

    if last_modified.tzinfo is None:
        last_modified = last_modified.replace(tzinfo=datetime.timezone.utc)
    if now.tzinfo is None:
        now = now.replace(tzinfo=datetime.timezone.utc)

    result["last_modified"] = last_modified.isoformat()
    age_h = (now - last_modified).total_seconds() / 3600.0
    result["age_h"] = round(age_h, 1)
    mtime_status = _status_from_age(age_h, warn_h, fail_h, severity)
    result["status"] = mtime_status

    # ---- CONTENT-MODE override (authoritative when as_of_field is declared) ----
    if as_of_field:
        result["mtime_status"] = mtime_status  # mtime kept as a secondary signal
        result["content_checked"] = False
        if content_doc is None:
            why = content_error or "object content unreadable"
            result["notes"] = (result["notes"] + f" | CONTENT-MODE UNCHECKED ({why}); "
                               "mtime is the WEAKER signal here").strip(" |")
            return result
        raw_val = _resolve_as_of_field(content_doc, as_of_field)
        if raw_val is None:
            result["notes"] = (result["notes"] + f" | CONTENT-MODE UNCHECKED "
                               f"(as_of_field '{as_of_field}' absent); mtime is the WEAKER "
                               "signal here").strip(" |")
            return result
        as_of_dt = _parse_as_of(str(raw_val))
        if as_of_dt is None:
            result["notes"] = (result["notes"] + f" | CONTENT-MODE UNCHECKED "
                               f"(as_of '{raw_val}' unparseable); mtime is the WEAKER "
                               "signal here").strip(" |")
            return result
        content_age_h = (now - as_of_dt).total_seconds() / 3600.0
        result["content_as_of"] = str(raw_val)
        result["content_age_h"] = round(content_age_h, 1)
        result["content_checked"] = True
        result["status"] = _status_from_age(content_age_h, warn_h, fail_h, severity)
        # the dangerous direction made LOUD: mtime says fresh, content says stale
        if result["status"] in ("FAIL", "WARN") and mtime_status == "PASS":
            result["notes"] = (result["notes"] + f" | MTIME-FRESH-BUT-CONTENT-STALE: "
                               f"mtime age {result['age_h']}h PASS but internal as_of "
                               f"{raw_val} is {round(content_age_h,1)}h old").strip(" |")

    return result


def _fetch_object_doc(s3_key: str):
    """I/O: fetch a concrete .json S3 object's parsed content for content-mode.
    Returns (doc, error). Scoped to concrete .json keys (served artifacts); a gzipped
    or non-text origin yields (None, reason) -> content-UNCHECKED, documented weaker
    signal, never a silent pass. (binary/gzip origin = a documented follow-on.)"""
    if not s3_key.endswith(".json"):
        return None, f"content-mode supports concrete .json keys only ({s3_key})"
    raw = _aws("s3", "cp", s3_key, "-", check_aws=False)
    if not raw:
        return None, "object content unreadable (missing / gzipped / non-text origin)"
    try:
        return json.loads(raw), ""
    except Exception:
        return None, "object not parseable as JSON (gzipped origin? -> binary follow-on)"


def _check_artifact(entry: dict, now: datetime.datetime) -> dict:
    """
    Check one artifact entry against its cadence thresholds (I/O + delegate to the pure
    evaluator). Returns a result dict with: artifact_id, s3_key, last_modified, age_h,
    fail_at_h, warn_at_h, status, severity, cadence, notes (+ content_* when as_of_field set).
    """
    if entry.get("cadence", "daily") == "on-demand":
        return _evaluate_artifact(entry, now, None)  # evaluator returns SKIP for on-demand
    s3_key = entry["s3_key_prefix"]
    last_modified = get_latest_modified(s3_key)
    content_doc, content_error = (None, "")
    if entry.get("as_of_field") and last_modified is not None:
        content_doc, content_error = _fetch_object_doc(s3_key)
    return _evaluate_artifact(entry, now, last_modified, content_doc, content_error)


def check_entries(entries: list[dict]) -> list[dict]:
    """Check all entries in parallel and return results in original order."""
    now = datetime.datetime.now(tz=datetime.timezone.utc)
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        futures = {pool.submit(_check_artifact, e, now): i for i, e in enumerate(entries)}
        results = [None] * len(entries)
        for fut in concurrent.futures.as_completed(futures):
            idx = futures[fut]
            results[idx] = fut.result()
    return results


# ---------------------------------------------------------------------------
# Output formatting
# ---------------------------------------------------------------------------
def _fmt_row(r: dict) -> str:
    aid  = r["artifact_id"][:_COL_ID].ljust(_COL_ID)
    key  = r["s3_key"][:_COL_KEY].ljust(_COL_KEY)
    ts   = (r["last_modified"] or "N/A")[:_COL_TS].ljust(_COL_TS)
    age  = (f"{r['age_h']:.1f}h" if r["age_h"] is not None else "N/A").ljust(_COL_AGE)
    fail = (f"{r['fail_at_h']}h" if r["fail_at_h"] is not None else "N/A").ljust(_COL_FAIL)
    st   = r["status"].ljust(_COL_ST)
    base = f"{aid} | {key} | {ts} | {age} | {fail} | {st}"
    # When content-mode was engaged, the displayed age_h is MTIME (secondary). Surface the
    # authoritative content age so a content-driven WARN/FAIL is legible (not 'WARN at 0.6h?').
    if "mtime_status" in r:
        if r.get("content_checked"):
            base += " [content as_of %s, %.1fh]" % (r.get("content_as_of", "?"),
                                                    r.get("content_age_h") or 0.0)
            if r.get("status") in ("WARN", "FAIL") and r.get("mtime_status") == "PASS":
                base += " <MTIME-FRESH/CONTENT-STALE>"
        else:
            base += " [content UNCHECKED -> mtime is the weaker signal]"
    return base


def _fmt_header() -> str:
    aid  = "artifact_id".ljust(_COL_ID)
    key  = "s3_key".ljust(_COL_KEY)
    ts   = "last_modified".ljust(_COL_TS)
    age  = "age_h".ljust(_COL_AGE)
    fail = "fail_at_h".ljust(_COL_FAIL)
    st   = "STATUS".ljust(_COL_ST)
    return f"{aid} | {key} | {ts} | {age} | {fail} | {st}"


def print_results(results: list[dict], label: str = "") -> int:
    """Print results table and return exit code (0 PASS, 1 FAIL)."""
    if label:
        print(f"\n-- {label} --")
    print(_fmt_header())
    print("-" * (_COL_ID + _COL_KEY + _COL_TS + _COL_AGE + _COL_FAIL + _COL_ST + 15))
    any_fail = False
    for r in results:
        print(_fmt_row(r))
        if r["status"] == "FAIL":
            any_fail = True
            if r.get("notes"):
                print(f"  NOTE: {r['notes']}")
    return 1 if any_fail else 0


# ---------------------------------------------------------------------------
# Subcommand handlers
# ---------------------------------------------------------------------------
def cmd_chain(pipeline: str) -> int:
    if pipeline not in PIPELINE_CONFIGS:
        print(f"ERROR: unknown pipeline {pipeline!r}. Use {'/'.join(PIPELINE_CONFIGS)}.", file=sys.stderr)
        return 2
    config_path = PIPELINE_CONFIGS[pipeline]
    entries = _load_config(config_path)
    # Filter out on-demand entries for chain check (show them as SKIP)
    results = check_entries(entries)
    return print_results(results, label=f"chain {pipeline}")


def cmd_script(script_id: str) -> int:
    """Check freshness for inputs of a specific script (BD or INF)."""
    # Determine pipeline from script ID prefix
    pipeline = "inf" if script_id.upper().startswith("INF_") else "bd"
    config_path = BD_CONFIG if pipeline == "bd" else INF_CONFIG
    entries = _load_config(config_path)

    # Filter entries tagged to this script (scripts[] field in config)
    script_entries = [
        e for e in entries
        if script_id in e.get("scripts", []) or script_id.upper() in [s.upper() for s in e.get("scripts", [])]
    ]
    if not script_entries:
        # absence != fresh: no config entry tagged -> this script's input freshness
        # was NOT checked. Was exit-0 (read as 'fresh/fine'); now exit-2 (config
        # error / UNCHECKED) per this tool's own exit convention (see header: 2 =
        # config error). A missing config must not silently pass as fresh.
        print(f"NO_FRESHNESS_CONFIG: no cadence config entries tagged for script {script_id!r} "
              f"-- UNCHECKED, NOT a freshness pass (0 inputs verified).")
        print(f"  Add a {pipeline} freshness_config entry, or run "
              f"'comp-freshness chain {pipeline}' to check all {pipeline.upper()} artifacts.")
        print(f"WARN: no cadence config entries tagged for script {script_id!r}.", file=sys.stderr)
        return 2

    results = check_entries(script_entries)
    return print_results(results, label=f"script {script_id}")


def cmd_artifact(s3_prefix: str, raw: bool = False, max_age=None) -> int:
    """Check freshness for a single S3 prefix.

    raw=True (F3 / NFRA_COMPTOOL_USEPATHS): for an UNREGISTERED prefix, report the newest-object
    age WITHOUT a FRESH/STALE verdict (no guessed cadence). max_age (hours): an ad-hoc threshold
    for an unregistered prefix instead of the default-daily guess. Both are no-ops when the prefix
    HAS a registered cadence entry (the real config wins)."""
    # Find matching entry in either config for thresholds
    entry = None
    for path in (BD_CONFIG, INF_CONFIG):
        if not path.exists():
            continue
        entries = _load_config(path)
        for e in entries:
            if e["s3_key_prefix"].rstrip("/") == s3_prefix.rstrip("/"):
                entry = e
                break
        if entry:
            break

    _registered = entry is not None
    if entry is None:
        if max_age is not None:
            # Ad-hoc threshold: a real verdict against the caller-supplied max-age.
            entry = {
                "artifact_id": s3_prefix, "s3_key_prefix": s3_prefix, "cadence": "custom",
                "warn_age_hours": float(max_age) * 0.75, "fail_age_hours": float(max_age),
                "severity": "ERROR",
                "notes": f"ad-hoc --max-age {max_age}h (no registered cadence)",
            }
        else:
            # No config entry: permissive defaults (daily, 48h fail) -- a GUESS.
            entry = {
                "artifact_id": s3_prefix, "s3_key_prefix": s3_prefix, "cadence": "daily",
                "warn_age_hours": 30, "fail_age_hours": 48, "severity": "ERROR",
                "notes": "No cadence config entry — using default daily thresholds",
            }

    now = datetime.datetime.now(tz=datetime.timezone.utc)
    result = _check_artifact(entry, now)

    # F3 RAW: an unregistered prefix has no cadence baseline, so a FRESH/STALE verdict is a guess.
    # Report the age, suppress the verdict -> 'RAW'. Genuine states (MISSING/ERROR) are preserved.
    if raw and not _registered and max_age is None and result.get("status") not in ("MISSING", "ERROR"):
        result["status"] = "RAW"
        result["severity"] = "INFO"
        result["notes"] = ("RAW: no registered cadence -- newest-object age reported, NO FRESH/STALE "
                           "verdict (a guessed-daily verdict would mislead; pass --max-age <h> for an "
                           "ad-hoc threshold, or register a cadence entry).")

    print(_fmt_header())
    print("-" * 120)
    print(_fmt_row(result))
    if result.get("notes"):
        print(f"  NOTE: {result['notes']}")
    if result["status"] == "RAW":
        return 0
    return 1 if result["status"] == "FAIL" else 0


def cmd_ddb(table: str, pattern: Optional[str] = None) -> int:
    """Handle 'comp-freshness ddb <table> [--pattern PREFIX]'.

    If table is in ddb_freshness_config.yaml, uses its thresholds.
    If not, uses permissive defaults (168h warn, ERROR severity).
    Pattern overrides the pk_prefix from config if supplied.
    """
    ddb_entries: list[dict] = []
    if DDB_CONFIG.exists():
        try:
            ddb_entries = _load_ddb_config()
        except ConfigError:
            ddb_entries = []

    # Find matching config entry for this table
    entry = next((e for e in ddb_entries if e["table"] == table), None)

    if entry is None:
        # No config entry: permissive defaults
        entry = {
            "table":                   table,
            "pk_prefix":               pattern or "",
            "sk_filter":               None,
            "timestamp_attr":          "updatedAt",
            "fallback_timestamp_attr": "createdAt",
            "warn_age_hours":          120,
            "max_age_hours":           168,
            "severity":                "ERROR",
            "cadence_note":            "No config entry — using default 168h thresholds",
            "description":             table,
        }
    elif pattern:
        entry = dict(entry)
        entry["pk_prefix"] = pattern

    now = datetime.datetime.now(tz=datetime.timezone.utc)
    result = _check_ddb_entry(entry, now)
    print(_fmt_header())
    print("-" * (_COL_ID + _COL_KEY + _COL_TS + _COL_AGE + _COL_FAIL + _COL_ST + 15))
    print(_fmt_row(result))
    if result.get("notes"):
        print(f"  NOTE: {result['notes']}")
    return 1 if result["status"] == "FAIL" else 0


def cmd_all() -> int:
    """Run all S3 (bd + inf) + all DDB entries in one pass."""
    exit_code = 0

    # S3: BD
    if BD_CONFIG.exists():
        bd_entries = _load_config(BD_CONFIG)
        bd_results = check_entries(bd_entries)
        exit_code = max(exit_code, print_results(bd_results, label="chain bd (S3)"))
    else:
        print(f"WARN: BD config not found: {BD_CONFIG}", file=sys.stderr)

    # S3: INF
    if INF_CONFIG.exists():
        inf_entries = _load_config(INF_CONFIG)
        inf_results = check_entries(inf_entries)
        exit_code = max(exit_code, print_results(inf_results, label="chain inf (S3)"))
    else:
        print(f"WARN: INF config not found: {INF_CONFIG}", file=sys.stderr)

    # S3: COT (served entries only; partition-key silver entries load-filtered out)
    if COT_CONFIG.exists():
        cot_entries = _load_config(COT_CONFIG)
        cot_results = check_entries(cot_entries)
        exit_code = max(exit_code, print_results(cot_results, label="chain cot (S3)"))
    else:
        print(f"WARN: COT config not found: {COT_CONFIG}", file=sys.stderr)

    # DDB
    if DDB_CONFIG.exists():
        ddb_entries = _load_ddb_config()
        ddb_results = check_ddb_entries(ddb_entries)
        exit_code = max(exit_code, print_results(ddb_results, label="ddb freshness"))
    else:
        print(f"WARN: DDB config not found: {DDB_CONFIG}", file=sys.stderr)

    return exit_code


def cmd_list() -> int:
    """Print cadence config in human-readable form grouped by pipeline."""
    for label, path in (("BD", BD_CONFIG), ("INF", INF_CONFIG), ("COT", COT_CONFIG)):
        if not path.exists():
            print(f"\n-- {label} config not found: {path} --")
            continue
        entries = _load_config(path)
        print(f"\n== {label} pipeline ({len(entries)} entries) ==")
        print(f"  Config: {path}")
        print()
        on_demand = [e for e in entries if e.get("cadence") == "on-demand"]
        checked   = [e for e in entries if e.get("cadence") != "on-demand"]
        for e in sorted(checked, key=lambda x: x["artifact_id"]):
            cad  = CADENCE_LABELS.get(e.get("cadence", "daily"), e.get("cadence", "daily"))
            warn = e.get("warn_age_hours")
            fail = e.get("fail_age_hours")
            sev  = e.get("severity", "ERROR")
            w_str = f"warn={warn}h" if warn else "warn=none"
            f_str = f"fail={fail}h" if fail else "fail=none"
            print(f"  {e['artifact_id']:<40} [{cad:<30}] {w_str} {f_str} ({sev})")
            print(f"    {e['s3_key_prefix']}")
            if e.get("notes"):
                print(f"    NOTE: {e['notes']}")
        if on_demand:
            print("\n  -- on-demand (not checked in chain) --")
            for e in sorted(on_demand, key=lambda x: x["artifact_id"]):
                print(f"  {e['artifact_id']:<40} {e['s3_key_prefix']}")

    # DDB section
    if DDB_CONFIG.exists():
        try:
            ddb_entries = _load_ddb_config()
            print(f"\n== DDB ({len(ddb_entries)} entries) ==")
            print(f"  Config: {DDB_CONFIG}")
            print()
            for e in ddb_entries:
                pk     = e["pk_prefix"]
                sk     = e.get("sk_filter") or "*"
                warn   = e.get("warn_age_hours")
                fail   = e["max_age_hours"]
                sev    = e.get("severity", "ERROR")
                w_str  = f"warn={warn}h" if warn else "warn=none"
                f_str  = f"fail={fail}h"
                ts_a   = e.get("timestamp_attr", "updatedAt")
                ts_fb  = e.get("fallback_timestamp_attr")
                ts_str = ts_a + (f"/{ts_fb}" if ts_fb else "")
                label_str = f"  {e['table']:<30} PK={pk}* SK={sk:<8} ts={ts_str:<25} {w_str} {f_str} ({sev})"
                print(label_str)
                if e.get("cadence_note"):
                    print(f"    NOTE: {e['cadence_note']}")
        except ConfigError as ex:
            print(f"\n  DDB config error: {ex}")
    else:
        print(f"\n-- DDB config not found: {DDB_CONFIG} --")

    return 0


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------
def main() -> int:
    parser = argparse.ArgumentParser(
        prog="comp-freshness",
        description="S3 + DynamoDB artifact freshness gate for BD and INF gold chains.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Exit codes:
  0  All PASS (WARN entries do not block)
  1  Any FAIL (artifact beyond fail_age_hours with ERROR severity)
  2  Config error or AWS unreachable

Examples:
  comp-freshness chain bd
  comp-freshness chain inf
  comp-freshness ddb opal-users-v2
  comp-freshness ddb opal-users-v2 --pattern "FIRM#"
  comp-freshness all
  comp-freshness artifact s3://opal-data-bd/silver/prices/canonical_prices.parquet
  comp-freshness artifact s3://opal-data-schwab/silver/RPS/
  comp-freshness --list
""",
    )
    sub = parser.add_subparsers(dest="command")

    p_chain = sub.add_parser("chain", help="Check all S3 chain input artifacts")
    p_chain.add_argument("pipeline", choices=["bd", "inf", "cot"])

    p_script = sub.add_parser("script", help="Check inputs for a specific script ID")
    p_script.add_argument("script_id")

    p_artifact = sub.add_parser("artifact", help="Check a single S3 prefix")
    p_artifact.add_argument("s3_prefix")
    p_artifact.add_argument("--raw", action="store_true",
                            help="RAW mode (F3): for an UNREGISTERED prefix, report the newest-object "
                                 "age with NO FRESH/STALE verdict (no guessed cadence -- a guessed-daily "
                                 "verdict misleads on a legitimately-weekly/ad-hoc prefix).")
    p_artifact.add_argument("--max-age", type=float, default=None, dest="max_age",
                            help="Ad-hoc freshness threshold in HOURS for an unregistered prefix "
                                 "(verdict against this, instead of the default-daily guess).")

    p_ddb = sub.add_parser("ddb", help="Check DynamoDB table freshness")
    p_ddb.add_argument("table", help="DynamoDB table name (e.g. opal-users-v2)")
    p_ddb.add_argument("--pattern", default=None,
                       help="PK prefix pattern override (e.g. 'FIRM#'); uses config default if omitted")

    sub.add_parser("all", help="Check all S3 (bd+inf) + all DDB entries in one pass")

    parser.add_argument("--list", action="store_true", help="Print all cadence config (S3 + DDB)")

    args = parser.parse_args()

    try:
        if args.list:
            return cmd_list()
        if args.command == "chain":
            return cmd_chain(args.pipeline)
        if args.command == "script":
            return cmd_script(args.script_id)
        if args.command == "artifact":
            return cmd_artifact(args.s3_prefix, raw=getattr(args, "raw", False),
                                max_age=getattr(args, "max_age", None))
        if args.command == "ddb":
            return cmd_ddb(args.table, getattr(args, "pattern", None))
        if args.command == "all":
            return cmd_all()
        parser.print_help()
        return 2
    except ConfigError as e:
        print(f"ERROR: {e}", file=sys.stderr)
        return 2
    except AwsUnreachable as e:
        print(f"AWS_UNREACHABLE: {e}", file=sys.stderr)
        print("Check AWS credentials and network connectivity.", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
