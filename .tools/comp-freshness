#!/usr/bin/env python3
"""
comp-freshness -- S3 + DynamoDB artifact freshness gate for BD and INF gold chains.

Detects stale upstream S3 data before a script runs against it and produces
wrong output silently. Implements the ADHC_COMPIL v3 Theme G specification.
DynamoDB freshness extension: ADHC_COMPIL_V4.015 (AE 0.7.0, 2026-05-11).

Incidents this tool would have caught:
  2026-04-17 Schwab RPS 10-day staleness -> $130M linear_interpolation overshoot
  2026-04-29 silver/aum_snapshot 8-day staleness -> $89.6M vs $182.71M correct

Usage:
  comp-freshness chain {bd|inf}       check all S3 chain input artifacts
  comp-freshness script <id>          check inputs for a specific script
  comp-freshness artifact <s3-prefix> check a single S3 artifact
  comp-freshness ddb <table>          check DynamoDB table freshness (from ddb config)
  comp-freshness ddb <table> --pattern FIRM#   narrow to items with this PK prefix
  comp-freshness all                  check all S3 (bd+inf) + all DDB entries in one pass
  comp-freshness --list               print all cadence config (S3 + DDB)
  comp-freshness --help               show help

Output (one line per artifact):
  artifact_id | s3_key | last_modified | age_h | fail_at_h | STATUS
  STATUS in {PASS, WARN, FAIL, SKIP}

Exit codes:
  0 -- all PASS or WARN (WARN alone does not block dispatch)
  1 -- any FAIL (one or more artifacts beyond fail_at_h with ERROR severity)
  2 -- config error (missing yaml, malformed entry, AWS unreachable)
"""
from __future__ import annotations

