#!/bin/bash
# pipescript -- named-thread estate traversal (NFRA_PIPESCRIPT).
# Single human-friendly entry point: `pipescript <name>` -> every resource in that
# named thread + producers -> served artifacts -> frontend consumers + owning tool +
# coverage status + debt flags, over the whole estate, with NO silent Unknown. Read-only.
# Usage: pipescript <name> | pipescript --list | pipescript --resource <substr>
#        pipescript --tool <name> <tool> | pipescript --validate
WORKSPACE="$(cd "$(dirname "$0")/.." && pwd)"
python "$WORKSPACE/org/modules/graph/pipescript_cli.py" "$@"
_exit=$?
python "$WORKSPACE/org/modules/graph/comp_log_auto.py" "pipescript" "$*" $_exit 2>/dev/null
exit $_exit
