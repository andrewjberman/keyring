RAIL_LOG = os.path.join(WS, "org", "mcp", "comp-which-rail.log")

# identifier-ish token patterns, in extraction-priority order (most specific first)
_TERM_PATS = [
    re.compile(r"[A-Za-z_][\w./-]*\.(?:parquet|tsx|ts|py|json|md|yaml|yml|sh|hcl|tf)\b"),  # filenames
    re.compile(r"\b[a-z][a-z0-9]+(?:[A-Z][a-z0-9]+)+\b"),                                   # camelCase
    re.compile(r"\b[A-Z][a-z0-9]+(?:[A-Z][a-z0-9]+)+\b"),                                   # PascalCase
    re.compile(r"\b\w+_\w[\w_]*\b"),                                                          # snake_case
    re.compile(r"\b[a-z0-9]+(?:-[a-z0-9]+){2,}\b"),                                           # hyphenated-names (opal-...)
    re.compile(r"\b[A-Z][A-Z0-9_]{3,}\b"),                                                    # ALL_CAPS
]


def _extract_term(q: str):
    """Pick the most likely search target from a NL question. Quoted text wins; else the
    most specific identifier-ish token; else the longest non-stopword word (>=4 chars)."""
    m = re.search(r'"([^"]{2,})"|\'([^\']{2,})\'', q)
    if m:
        return (m.group(1) or m.group(2)).strip()
    for pat in _TERM_PATS:
        found = pat.findall(q)
        if found:
            return max(found, key=len)
    words = [w for w in re.findall(r"[A-Za-z0-9_]+", q) if w.lower() not in _STOP and len(w) >= 4]
    return max(words, key=len) if words else None


_PATH_RX = re.compile(r"(?<![\w/])([A-Za-z0-9_.-]+/[A-Za-z0-9_./-]+)")


def _extract_path(q: str):
    """A slash-containing path token (for list/find intents -> pass as pathspec, not a pattern)."""
    m = _PATH_RX.search(q)
    return m.group(1).rstrip("/.") if m else None


def _log_rail(decision: str, intent: str, term, q: str) -> None:
    # --- --route-only IS NOW ACTUALLY SIDE-EFFECT-FREE (COO~Z + 0.8.0_AE_CloudComp~Z, 2026-07-13) ------
    # `_ROUTE_ONLY` was DOCUMENTED as "side-effect-free preview mode" (:881) and was NOT: it still wrote a
    # ROUTE row. comp-tool-hud.sh:291 calls it on EVERY search nudge, piping the agent's RAW SEARCH
    # STRING in -- so the rail log recorded SEARCHES AGENTS RAN, not QUESTIONS AGENTS ASKED.
    #
    # MEASURED CONSEQUENCE: ~10% of the "real agent questions" cohort were GLOB PATTERNS
    # (`**/*COMPASSURANCE*`, `**/cot_bronze_ingest.py`). They score zero because THEY ARE NOT QUESTIONS --
    # and a glob falling through to comp-glob is THE FALLBACK WORKING AS DESIGNED. So the log was
    # SCORING A SUCCESS AS A FAILURE and inflating the defect estimate by ~4 points (33.1% -> 29.0%).
    #
    # This is the SAME FAMILY as self_route_verdicts() on the commit gate: TWO INDEPENDENT INSTRUMENTS,
    # BOTH SILENTLY AUTHORING THE EVIDENCE BASE THEY WERE MEASURED BY. The clean fix is the flag, never a
    # strip rule downstream -- "a filter would be us deciding what agents really meant."
    if _ROUTE_ONLY:
        return
    try:
        import datetime
        ts = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    except Exception:
        ts = "?"
    # SANITIZE EVERY INTERPOLATED FIELD, not just q (NFRA_COMPCLOSE 2026-07-14): intent/term were
    # written raw, so a multi-line extracted term (shell-fragment queries via the HUD) wrote
    # CONTINUATION LINES into the rail -- ~350 junk rows ("=== x216, bare fragments) whose first
    # token then parsed as a TAG. The rail's own writer must emit rows its readers can parse.
    def _san(v, cap=120):
        return str(v if v not in (None, "") else "-").replace("\n", " ").replace("\r", " ")[:cap]
    # R8 (NFRA_VELOCITY_ESTATE WS-E6.R8): stamp the route id + the recommended-tool COUNT on
    # TOOL-VALUED route families only, and hand the id off so the SUBSEQUENT run can carry it.
    # route_id/n are inserted BEFORE the terminal quoted q= so existing key=value readers and
    # the positional `awk '{print $2}'` decision parse are both unaffected (additive).
    rid = _route_id() if decision in _TOOL_VALUED_ROUTE_FAMILIES else ""
    extra = ""
    if rid:
        n = len([c for c in str(intent).split("+") if c.strip()])
        extra = "route_id=%s  n=%d  " % (rid, n)
        _handoff_route(rid, n)
    line = '%s  %s  tool=comp-which  intent=%s  term=%s  %sq="%s"\n' % (
        ts, _san(decision, 40), _san(intent), _san(term), extra, _san(q))
    try:
        os.makedirs(os.path.dirname(RAIL_LOG), exist_ok=True)
        with open(RAIL_LOG, "a", encoding="utf-8") as f:
            f.write(line)
    except Exception:
        pass


