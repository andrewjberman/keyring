#!/usr/bin/env python3
"""comp-which "<question>" -- the comp-tool ROUTER (NFRA_TOOLHUD #2, Andrew-direct 2026-06-15).

THE PROBLEM (the HUD #2 arm): the 41KB graph-call-manifest catalog is too big to
hold in an agent's head, so even with every tool documented, "which tool answers
this?" is friction the blind-grep reflex skips. comp-which makes the catalog
QUERYABLE: type your actual question, get the canonical comp call -- without
knowing the catalog.

  comp-which "what produces canonical_prices.parquet?"
  comp-which "which lambda serves /api/scoped/advisor-intelligence?"
  comp-which "what breaks if I change build_dashboard?"

Two layers:
 1. CURATED high-confidence rules = CVO #3 baseline's ranked question->tool map
    (bdf7a0a9a) -- the high-traffic question classes get the exact, vetted call.
 2. MANIFEST-FUZZY backstop = keyword-overlap score over graph-call-manifest.yaml's
    use_case entries -> comprehensive + auto-updates as tools are added.

Read-only, deterministic, ASCII-only. Tune the curated rules to CVO's post-hook
re-measure (which redirects agents accept vs ignore).
"""
from __future__ import annotations

import os
import re
import subprocess
import sys

WS = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
MANIFEST = os.path.join(WS, "org", "modules", "graph", "graph-call-manifest.yaml")

# Curated rules: (any-keyword list, label, [calls], why). Order = CVO bypass-volume rank.
RULES = [
    (["produce", "produces", "consume", "consumes", "who reads", "who writes", "what writes",
      "what reads", "artifact", "s3 key", "s3://", "parquet", "platinum/", "/gold/", "/silver/"],
     "S3 artifact / who-reads-writes",
     ["comp-pipescript io <script>", "pipescript --resource <key>"],
     "what produces/consumes an S3 key + who reads an artifact"),
    (["portal", "component", "endpoint", "scoped route", "scoped", "/api/", ".tsx", "tsx",
      "frontend", "renders", "rendering", "getadvisor", "which lambda serves", "serves /api"],
     "portal component / route",
     ["comp-transform schema-check <Component>", "comp-routes behaviors", "pipescript <thread>"],
     "which producer/endpoint feeds a portal component + the serving/CF route"),
    (["lambda", "function", "handler", "what does this lambda", "what does the lambda"],
     "lambda",
     ["comp-iam service <fn>", "comp-aws", "pipescript --resource <fn>"],
     "what a lambda does + its IAM + its named thread"),
    (["iam", "role", "perm", "permission", "policy", "grant", "allow", "deny", "principal"],
     "IAM role/policy",
     ["comp-iam service <lambda>", "comp-iam gaps"],
     "perms before deploy (note: a Principal:* on Effect=Deny is a GUARDRAIL, not a public grant)"),
    (["what resources", "aws resource", "which thread owns", "estate", "cloud graph", "blast radius of"],
     "AWS resources / thread ownership",
     ["comp-aws", "pipescript <name>", "comp-pipescript deployed"],
     "what AWS resources exist + which named thread owns them"),
    (["breaks", "blast", "what depends", "if i change", "impact of changing", "downstream of"],
     "blast radius",
     ["comp-blast <fn-or-artifact>"],
     "what breaks if you change X (pass a function name, not a script name)"),
    (["cache", "collision", "query key", "react query"],
     "cache collisions",
     ["comp-cache collisions"],
     "cache-key collisions / shared keys"),
    (["what's in", "whats in", "everything in", "whole pipeline", "the scanner", "named thread", "what is in the"],
     "named-thread traversal",
     ["pipescript <name>", "pipescript --list"],
     "every resource + deps + data-flow in a named pipeline/thread (no silent Unknown)"),
    (["deployed", "stale", "latest code", "s3 etag", "runner has", "is the runner on"],
     "deploy freshness",
     ["comp-pipescript deployed [script]"],
     "is the deployed runner on the latest code (MATCH/STALE/MISSING)"),
    (["4xx", "html response", "error response", "cloudfront error", "cf error", "auth fail"],
     "route/CF debugging",
     ["comp-routes behaviors"],
     "CF error rules masking JSON errors / 4xx debugging"),
    (["gold scripts", "silver scripts", "bronze scripts", "scripts in", "what scripts",
      "list the gold", "list gold", "pipeline scripts", "scripts in the"],
     "list pipeline scripts",
     ["pipescript --list", "comp-pipescript deployed --firm <bd|inf|cot|mdpf>",
      "comp-glob data/<firm>/scripts/gold/"],
     "the scripts in a named pipeline/firm (+ deployed MATCH/STALE state)"),
]

# Function-relationship intents that ARE a rich-tool job (route, do NOT run-the-primitive):
# "call sites / callers of X" is comp-blast's exact semantic traversal, not a text grep.
CALLSITE_RX = re.compile(r"\b(call ?sites?|callers?|callees?|who calls)\b", re.IGNORECASE)

# Text-search intent: a verb that means "find this string/symbol in the repo" -- the cases
# with NO rich tool, where comp-which must RUN the on-rails primitive instead of dead-ending.
SEARCHVERB_RX = re.compile(
    r"\b(where (is|are)|defined|definition of|declared|declaration of|references? to|"
    r"refer(s|red)? to|usages? of|occurrences? of|find (the |every |all )?|grep|"
    r"search (for|the)|show me (the |where )|locate|which files? (reference|contain|have|use|mention)|"
    r"what files?)\b", re.IGNORECASE)

# List-files intent -> run comp-glob (not comp-grep).
LISTVERB_RX = re.compile(
    r"\b(list (the )?files|what files|files (in|under|matching|named)|"
    r"ls |show (me )?(the )?files|directory listing|dir listing)\b", re.IGNORECASE)

_STOP = {
    "the", "a", "an", "is", "are", "was", "were", "what", "which", "who", "where", "when",
    "how", "why", "does", "do", "did", "of", "in", "on", "to", "for", "and", "or", "with",
    "from", "this", "that", "these", "those", "find", "show", "me", "list", "all", "every",
    "reference", "references", "defined", "definition", "declared", "search", "grep", "file",
    "files", "portal", "lambda", "script", "scripts", "pipeline", "gold", "code", "have",
    "has", "had", "get", "got", "it", "its", "their", "there", "here", "by", "at", "as",
    "be", "been", "being", "into", "out", "up", "down", "off", "over", "under", "about",
}

GOLD_ID = re.compile(r"(?<![\w])(INF_)?[A-DIS]_-?\d{1,2}[a-z]?(?![\w])")


def _tokens(s: str):
    return set(re.findall(r"[a-z0-9_]+", s.lower()))


def _score_rule(q: str, qtok: set, keywords) -> int:
    score = 0
    ql = q.lower()
    for kw in keywords:
        if " " in kw or "/" in kw or "." in kw or ":" in kw:
            if kw in ql:
                score += 3  # phrase / path match = strong
        elif kw in qtok:
            score += 2
    return score


def _manifest_matches(q: str, qtok: set, top: int = 3):
    """Keyword-overlap backstop over the manifest use_case entries."""
    out = []
    if not os.path.exists(MANIFEST):
        return out
    try:
        import yaml
        with open(MANIFEST, encoding="utf-8") as f:
            data = yaml.safe_load(f)
    except Exception:
        return out
    for e in (data or {}).get("use_cases", []) if isinstance(data, dict) else []:
        text = " ".join(str(e.get(k, "")) for k in ("use_case", "id", "tool"))
        overlap = len(qtok & _tokens(text))
        if overlap >= 2:
            out.append((overlap, e.get("tool", "?"), e.get("canonical_call", ""), e.get("use_case", "")[:90]))
    out.sort(key=lambda x: -x[0])
    return out[:top]


RAIL_LOG = os.path.join(WS, "org", "mcp", "comp-which-rail.log")

# identifier-ish token patterns, in extraction-priority order (most specific first)
_TERM_PATS = [
    re.compile(r"[A-Za-z_][\w./-]*\.(?:parquet|tsx|ts|py|json|md|yaml|yml|sh|hcl|tf)\b"),  # filenames
    re.compile(r"\b[a-z][a-z0-9]+(?:[A-Z][a-z0-9]+)+\b"),                                   # camelCase
    re.compile(r"\b[A-Z][a-z0-9]+(?:[A-Z][a-z0-9]+)+\b"),                                   # PascalCase
    re.compile(r"\b\w+_\w[\w_]*\b"),                                                          # snake_case
    re.compile(r"\b[a-z0-9]+(?:-[a-z0-9]+){2,}\b"),                                           # hyphenated-names (opal-...)
    re.compile(r"\b[A-Z][A-Z0-9_]{3,}\b"),                                                    # ALL_CAPS
]


def _extract_term(q: str):
    """Pick the most likely search target from a NL question. Quoted text wins; else the
    most specific identifier-ish token; else the longest non-stopword word (>=4 chars)."""
    m = re.search(r'"([^"]{2,})"|\'([^\']{2,})\'', q)
    if m:
        return (m.group(1) or m.group(2)).strip()
    for pat in _TERM_PATS:
        found = pat.findall(q)
        if found:
            return max(found, key=len)
    words = [w for w in re.findall(r"[A-Za-z0-9_]+", q) if w.lower() not in _STOP and len(w) >= 4]
    return max(words, key=len) if words else None


_PATH_RX = re.compile(r"(?<![\w/])([A-Za-z0-9_.-]+/[A-Za-z0-9_./-]+)")


def _extract_path(q: str):
    """A slash-containing path token (for list/find intents -> pass as pathspec, not a pattern)."""
    m = _PATH_RX.search(q)
    return m.group(1).rstrip("/.") if m else None


def _log_rail(decision: str, intent: str, term, q: str) -> None:
    try:
        import datetime
        ts = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    except Exception:
        ts = "?"
    line = '%s  %s  tool=comp-which  intent=%s  term=%s  q="%s"\n' % (
        ts, decision, intent, (term or "-"), q.replace("\n", " ")[:120])
    try:
        os.makedirs(os.path.dirname(RAIL_LOG), exist_ok=True)
        with open(RAIL_LOG, "a", encoding="utf-8") as f:
            f.write(line)
    except Exception:
        pass


def _run_primitive(kind: str, term: str) -> int:
    """RUN the on-rails primitive (the never-dead-end). kind in {grep, glob}. Invokes the
    sibling comp-grep/comp-glob via sys.executable (NOT a bash launcher -> Windows-safe)."""
    script = os.path.join(WS, ".tools", "comp-grep" if kind == "grep" else "comp-glob")
    call = "comp-%s %s" % (kind, term)
    print('comp-which -- no rich comp-tool fits this exact search; running the ON-RAILS primitive:')
    print("  $ %s" % call)
    print("  (on the rail: repo-scoped + .gitignore-aware + logged. If a rich tool SHOULD")
    print("   exist for this recurring intent, that is a TO-5 coverage-gap -> build it.)\n")
    try:
        rc = subprocess.call([sys.executable, script, term], cwd=WS)
        return rc
    except Exception as e:
        # absolute last resort -- still NOT a dead-end: hand the agent the exact on-rail call
        print("comp-which: WARN: could not auto-run (%s). Run it yourself: %s" % (e, call))
        return 0


def main() -> int:
    for _s in (sys.stdout, sys.stderr):  # uncrashable output on a cp1252 console
        try:
            _s.reconfigure(errors="replace")
        except Exception:
            pass
    if len(sys.argv) < 2 or not sys.argv[1].strip():
        print('comp-which "<your question>"  -- maps a natural-language question to the canonical comp-* call.')
        print('  e.g. comp-which "what produces canonical_prices.parquet?"')
        print('  Browse: pipescript --list   |   full catalog: org/modules/graph/graph-call-manifest.yaml')
        return 0
    q = " ".join(sys.argv[1:]).strip()
    qtok = _tokens(q)

    hits = []  # (score, label, calls, why)
    gid = GOLD_ID.search(q)
    if gid:
        hits.append((6, "gold-script id " + gid.group(0),
                     ["comp-pipescript io %s" % gid.group(0), "comp-pipescript feeds/consumers %s" % gid.group(0),
                      "pipescript --resource %s" % gid.group(0)],
                     "what a gold script reads/writes + who feeds/consumes it"))
    # "call sites / callers of X" -> comp-blast is the rich semantic answer (strong route,
    # NOT a text grep): force a high score so it routes even though it reads like a search.
    if CALLSITE_RX.search(q):
        hits.append((6, "call sites / callers",
                     ["comp-blast <fn-name>"],
                     "the call sites / callers of a function (semantic traversal -- pass the function name, not a script)"))
    for keywords, label, calls, why in RULES:
        s = _score_rule(q, qtok, keywords)
        if s > 0:
            hits.append((s, label, calls, why))
    hits.sort(key=lambda x: -x[0])
    best_score = hits[0][0] if hits else 0

    search_intent = bool(SEARCHVERB_RX.search(q))
    list_intent = bool(LISTVERB_RX.search(q))
    term = _extract_term(q)

    print('comp-which -- best match for: "%s"\n' % q)

    # --- DECISION (never dead-ends, NFRA_COMPRAIL TO-2 AC1) -----------------------------------
    # 1) STRONG rich-tool route (>=4 == a phrase match or 2+ keyword tokens) -> point.
    # 2) WEAK/zero route BUT a text-search intent + an extractable term -> RUN the primitive
    #    (the case native grep used to be the only answer for -> now it's on the rail).
    # 3) Some route but no search intent -> point (a weak match is still a rich-tool pointer).
    # 4) Nothing -> still RUN the primitive (or print the on-rail call) -- never "browse the catalog".
    STRONG = 4
    if best_score >= STRONG:
        _route_print(hits)
        _log_rail("ROUTE", hits[0][1], term, q)
        return 0

    if (search_intent or best_score == 0) and term:
        if list_intent:
            kind, target = "glob", (_extract_path(q) or term)  # a path -> pathspec, not a pattern
        else:
            kind, target = "grep", term
        if hits:
            print("  (a rich tool MIGHT fit -- consider first:)")
            _route_print(hits[:1])
        _log_rail("RUN-%s" % kind.upper(), (hits[0][1] if hits else "no-rich-tool"), target, q)
        return _run_primitive(kind, target)

    if hits:
        _route_print(hits)
        _log_rail("ROUTE", hits[0][1], term, q)
        return 0

    # nothing matched and no extractable term: still on-rail, never the 41KB-catalog dead-end
    mf = _manifest_matches(q, qtok)
    if mf:
        print("  (no high-confidence rule; closest catalog entries:)")
        for overlap, tool, call, uc in mf:
            print("  -> %s   (%s)" % (call or tool, uc))
        print("")
    if list_intent:
        _log_rail("RUN-GLOB", "no-rich-tool", ".", q)
        return _run_primitive("glob", ".")
    print("  No rich tool fit and no clear search term. The on-rails primitives (never a bare grep):")
    print("    comp-grep <pattern> [pathspec]   -- .gitignore-aware, logged repo search + dependency context")
    print("    comp-glob <pattern> [pathspec]   -- .gitignore-aware file find + dependency context")
    print("  Browse named threads: pipescript --list")
    _log_rail("NO-TERM", "none", term, q)
    return 0


def _route_print(hits):
    for s, label, calls, why in hits[:3]:
        print("  -> %s" % "   |   ".join(calls))
        print("     [%s] %s" % (label, why))
        print("")
    print("  (comp-which routed -- run the call yourself. No tool fit? it would have RUN comp-grep/comp-glob.)")


if __name__ == "__main__":
    raise SystemExit(main())
