def _yq(s):
    """Minimal YAML scalar quote -- the catalog carries ':', '#', quotes and unicode."""
    return "'" + str(s).replace("'", "''") + "'"


def _spill_full_ranking(ranked_all, call_of, concern_of, q):
    """Write the COMPLETE ranked catalog for this question. PID-keyed: concurrent agents never race.
    Returns a workspace-relative path, or None (a spill failure must NEVER break a route)."""
    try:
        os.makedirs(_SPILL_DIR, exist_ok=True)
        path = os.path.join(_SPILL_DIR, "rank-%d.yaml" % os.getpid())
        with open(path, "w", encoding="utf-8") as fh:
            fh.write("# comp-which -- the ranked CANDIDATE POOL for THIS question's intent.\n")
            fh.write("# NOT the tool universe: Stage A intent pre-filtering applies (E1/DR3 --\n")
            fh.write("# write-path tools are EXCLUDED from read/navigate intents, INCLUDED for\n")
            fh.write("# rebuild/compute intents), so tools_ranked varies per question. The tool\n")
            fh.write("# universe lives in graph-call-manifest.yaml tools_index. (Law-6 label fix,\n")
            fh.write("# CVO~Z tick-22: the prior 'COMPLETE ranked catalog' wording read a\n")
            fh.write("# per-intent pool as the universe and mis-reconciled a registry count.)\n")
            fh.write("# score = token/prior OVERLAP, NOT a confidence.\n")
            fh.write("# score >= 1.0 => a CURATED (vetted) rule fired. < 1.0 => a fuzzy base-band guess.\n")
            fh.write("question: %s\n" % _yq(q))
            # CE-p-4: THE VERDICT, TOLD APART ON THE ARTIFACT. A measurement that reads only
            # `tools_ranked` cannot tell "0 rows because nothing fit" from "0 rows because the
            # subject does not exist" -- two different failures with two different remedies.
            # THREE values, not two: `true` / `false` / `not-applicable`. The third is not
            # padding -- most questions carry no gold id at all, and calling those `true` would
            # record a check that never ran as a check that passed.
            fh.write("subject: %s\n" % _yq(_SUBJECT_STATE.get("subject") or ""))
            fh.write("subject_resolved: %s\n" % _yq(_SUBJECT_STATE.get("resolved")))
            fh.write("authority_consulted: %s\n" % _yq(_SUBJECT_STATE.get("authority") or ""))
            fh.write("shown_in_terminal: %d\n" % _TOPK)
            fh.write("tools_ranked: %d\n" % len(ranked_all))
            fh.write("tools:\n")
            for i, s in enumerate(ranked_all, 1):
                cid = s.cap.id
                fh.write("  - rank: %d\n" % i)
                fh.write("    tool: %s\n" % _yq(cid))
                fh.write("    score: %.2f\n" % s.score)
                fh.write("    vetted: %s\n" % ("true" if s.score >= 1.0 else "false"))
                fh.write("    call: %s\n" % _yq(call_of.get(cid, cid)))
                fh.write("    does: %s\n" % _yq((concern_of.get(cid, "") or "").strip()))
        return os.path.relpath(path, WS).replace("\\", "/")
    except Exception:
        return None

