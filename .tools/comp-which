def _emit_json(kind, caps, call_of, concern_of, term, q, fallback=None):
    """Emit the machine-readable route (CD1). caps = ordered cap_ids; fallback = a comp-grep/glob call
    string when the route floored to the on-rails primitive. Deterministic, ASCII-only."""
    import json
    routed = [{"tool": c, "call": call_of.get(c, c), "concern": concern_of.get(c, "")} for c in caps]
