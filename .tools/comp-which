_ROUTE_ID_CACHE = []


def _route_id() -> str:
    """One id per comp-which invocation, stable across multiple _log_rail calls in that run."""
    if _ROUTE_ID_CACHE:
        return _ROUTE_ID_CACHE[0]
    try:
        import datetime
        import hashlib
        stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
        seed = "%s|%d|%s" % (stamp, os.getpid(), " ".join(sys.argv[1:])[:200])
        rid = "%s-%s" % (stamp, hashlib.sha1(seed.encode("utf-8", "replace")).hexdigest()[:10])
    except Exception:
        rid = "unknown-route"
    _ROUTE_ID_CACHE.append(rid)
    return rid


def _handoff_route(rid: str, n: int) -> None:
    """Hand the route id to the NEXT comp-tool run via a RACE-FREE per-session file, mirroring
    comp-to's org/mcp/sessions/<sid>.to_id mechanism. NEVER the shared .agent_context: that file
    is one repo-global last-writer-wins surface across every concurrent agent, which is exactly
    how TO_ID got cross-attributed before LD-0070's session-keyed fix.

    No session id (a non-Claude-Code shell) -> no handoff, and the run row simply carries no
    route_id. That is an honest absence: the alternative is attributing a route to whatever
    agent happens to run next.
    """
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    if not sid:
        return
    # SEAT + SESSION KEY (2026-09-03, 1.0.0_SA_CTO, row NFRA_COMPEFFICACY-S28): Codex children launched from one
    # Claude seat inherit its session id, so a session-only key is last-writer-wins across them. When
    # OPAL_AGENT_SERIAL is set the handoff is keyed <sid>.<serial>.route; comp_log_auto reads that first.
    import re as _re
    seat = os.environ.get("OPAL_AGENT_SERIAL", "")
    key = "%s.%s" % (sid, _re.sub(r"[^A-Za-z0-9_.~-]", "_", seat)) if seat else sid
    try:
        import time  # local: comp-which does not import time at module scope
        d = os.path.join(WS, "org", "mcp", "sessions")
        os.makedirs(d, exist_ok=True)
        with open(os.path.join(d, "%s.route" % key), "w", encoding="utf-8") as f:
            # id | emit epoch | N recommended tools. N is recorded so an ALL-of-N rate stays
            # derivable without a re-baseline; COO ruled ANY-of-N CONVERTS (065315Z).
            f.write("%s|%.3f|%d\n" % (rid, time.time(), n))
    except Exception:
        pass  # telemetry must never break the tool it measures


def _run_primitive(kind: str, term: str) -> int:
    """RUN the on-rails primitive (the never-dead-end). kind in {grep, glob}. Invokes the
    sibling comp-find via sys.executable (NOT a bash launcher -> Windows-safe).

    RULE T (NFRA_COMPEFFICACY CE-t-3, PRD v0.4 s.4.4): this is one of comp-which's TWO
    timeout-carrying subprocess sites (the other is _self_report()'s telemetry call). Its ceiling
    now reads _CLOCK.remaining() instead of the fixed FALLBACK_TIMEOUT_S -- both sites share ONE
    Clock started in main(), so the budget is a wall-clock allowance for the WHOLE run.

    >> RULE-21 REPOINT, 2026-08-07, 1.0.0_SA_CTO. Andrew-direct: "(A) lift it" (the rollout hold
    on "comp-find replaces grep", discharged on TRIAL-1 -- a non-author field trial, verdict "I
    would keep using it with the mandate lifted, unreservedly"). This shelled comp-grep/comp-glob
    until now. comp-find replaces BOTH: content search bare, filename search behind --name.

    WHY THE OLD BINARIES ARE DELIBERATELY LEFT IN PLACE: retire consumers first, binary last. A
    gate whose binary cannot be found does not fail loudly -- `command -v` fails and the caller
    SILENTLY SKIPS (the comp-surface-check retirement lesson, CLAUDE.md Rule 20). comp-grep and
    comp-glob keep working; nothing routes to them.

    WHY THIS FUNCTION AND THE FOOTERS MOVED IN ONE COMMIT: on 2026-07-29 the rail denied a raw
    grep, routed the agent to its own named fallback, and the fallback did not resolve -- the gate
    FAILED OPEN AT ITS OWN DESIGNATED FALLBACK immediately after reporting healthy. An agent who
    obeys the law and then asks the router must not be sent to a tool the law just retired.

    GRAIN NOTE, carry it if you quote a count: comp-find counts LINES, not AST nodes. Measured
    2026-08-07 -- comp-find 4,336 vs a probe's 4,897 subscript nodes on one corpus. That is a
    grain difference correctly reported as such, NOT a disagreement, and it matters because a
    line count wearing a node count's clothes is a denominator defect.
    """
    script = os.path.join(WS, ".tools", "comp-find")
    argv = [sys.executable, script] + (["--name", term] if kind == "glob" else [term])
    call = "comp-find %s%s" % ("--name " if kind == "glob" else "", term)
    if _ROUTE_ONLY:
        print("comp-which-route-only: NO-ROUTE (would run: %s)" % call)
        return 0
    print('comp-which -- no rich comp-tool fits this exact search; running the ON-RAILS primitive:')
    print("  $ %s" % call)
    print("  (on the rail: repo-scoped + .gitignore-aware + logged. If a rich tool SHOULD")
    print("   exist for this recurring intent, that is a TO-5 coverage-gap -> build it.)\n")
    try:
        # SRC ATTRIBUTION (NFRA_COMPCLOSE 2026-07-14): the child comp-grep/comp-glob logs its own
        # RUN-GREP/RUN-GLOB rail row, byte-identical to a DIRECT agent invocation -- so the Rule-21
        # audit rail could not answer "fallback or direct?" (COMPASSURANCE TO-8d). The env var makes
        # the child's row carry src=comp-which; a direct invocation carries src=direct.
        env = dict(os.environ)
        env["COMP_WHICH_CHILD"] = "1"
        # NFRA_TOOLARCH.GATEBOUND Stage B: this WAS `subprocess.call(...)` with no timeout -- the
        # confirmed 84-minute hang source. Popen + wait(timeout=) + an explicit kill()+wait() on
        # TimeoutExpired is used instead of `subprocess.call(..., timeout=...)` deliberately: CORRECTED
        # 2026-07-25 (CVO~Z, GATEBOUND Stage B verification, reading CPython's actual subprocess.call
        # source) -- call()'s own timeout path DOES kill the child on expiry; that is not unique to
        # run(). The real reason is that `call(timeout=...)` RAISES TimeoutExpired instead of returning
        # an int, and _run_primitive is typed `-> int` (its value becomes an exit code) -- the explicit
        # Popen form is what lets a bounded call return an rc gracefully instead of propagating an
        # exception out of a function callers expect to always return an int.
        #
        # RULE T (NFRA_COMPEFFICACY CE-t-3, PRD v0.4 s.4.4): the ceiling now derives from
        # _CLOCK.remaining() -- the SAME shared clock _self_report() also reads, so the budget is
        # ONE wall-clock allowance for the whole run, not a fresh 60s handed to every fallback call.
        remaining = _CLOCK.remaining() if _CLOCK is not None else FALLBACK_TIMEOUT_S
        if remaining is not None and remaining <= 0:
            # DEFERRED, never silently skipped: the budget is already exhausted before this
            # indivisible unit could even start -- the same pre-flight shape CE-t-2 established.
            print("  BUDGET REACHED: %s s (%s); scanned 0 of 1 fallback_primitive_call; results "
                  "are a PREFIX, not the answer; the fallback was SKIPPED, not run; NO CURSOR: "
                  "this is one indivisible call -- nothing to resume, only to re-run with a "
                  "larger --budget; the on-rail call itself: %s"
                  % (_compbudget.fmt(_BUDGET_S), _BUDGET_SOURCE, call))
            return 1
        proc = subprocess.Popen(argv, cwd=WS, env=env)
        try:
            rc = proc.wait(timeout=remaining)
            if _CLOCK is not None:
                print("  " + _compbudget.within_budget_line(
                    1, 1, "fallback_primitive_call", _BUDGET_S, _BUDGET_SOURCE,
                    round(_CLOCK.elapsed(), 2)))
            return rc
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()  # reap -- an un-waited killed child is a zombie, not a closed hang
            print("comp-which: WARN: %s did not finish inside its remaining budget and was "
                  "KILLED. Run it yourself with a narrower scope: %s" % (call, call))
            if _CLOCK is not None:
                print("  BUDGET REACHED: %s s (%s); scanned 0 of 1 fallback_primitive_call; "
                      "results are a PREFIX, not the answer; the subprocess did not return "
                      "within the remaining budget (TimeoutExpired); NO CURSOR: this is one "
                      "indivisible call -- nothing to resume, only to re-run with a larger "
                      "--budget." % (_compbudget.fmt(_BUDGET_S), _BUDGET_SOURCE))
            return 1
    except Exception as e:
        # absolute last resort -- still NOT a dead-end: hand the agent the exact on-rail call
        print("comp-which: WARN: could not auto-run (%s). Run it yourself: %s" % (e, call))
        return 0


