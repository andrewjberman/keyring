GOLD_ID = re.compile(r"(?<![\w])(INF_)?[A-DIS]_-?\d{1,2}[a-z]?(?![\w])")


def _tokens(s: str):
    return set(re.findall(r"[a-z0-9_]+", s.lower()))


def _score_rule(q: str, qtok: set, keywords) -> int:
    score = 0
    ql = q.lower()
    for kw in keywords:
        if " " in kw or "/" in kw or "." in kw or ":" in kw:
            if kw in ql:
                score += 3  # phrase / path match = strong
        elif kw in qtok:
            score += 2
    return score


def _manifest_matches(q: str, qtok: set, top: int = 3):
    """Keyword-overlap backstop over the manifest use_case entries."""
    out = []
    if not os.path.exists(MANIFEST):
        return out
    try:
        import yaml
        with open(MANIFEST, encoding="utf-8") as f:
            data = yaml.safe_load(f)
    except Exception:
        return out
    # LD-0208 fix (A): the manifest stores rows under `entries:`, not `use_cases:`.
    # Reading the wrong key iterated [] and matched NOTHING -> the whole fuzzy backstop
    # was dead, leaving ~28 long-tail tools unreachable via the router.
    for e in (data or {}).get("entries", []) if isinstance(data, dict) else []:
        text = " ".join(str(e.get(k, "")) for k in ("use_case", "id", "tool"))
        overlap = len(qtok & _tokens(text))
        if overlap >= 2:
            out.append((overlap, e.get("tool", "?"), e.get("canonical_call", ""), e.get("use_case", "")[:90]))
    out.sort(key=lambda x: -x[0])
    return out[:top]


RAIL_LOG = os.path.join(WS, "org", "mcp", "comp-which-rail.log")

# identifier-ish token patterns, in extraction-priority order (most specific first)
_TERM_PATS = [
    re.compile(r"[A-Za-z_][\w./-]*\.(?:parquet|tsx|ts|py|json|md|yaml|yml|sh|hcl|tf)\b"),  # filenames
    re.compile(r"\b[a-z][a-z0-9]+(?:[A-Z][a-z0-9]+)+\b"),                                   # camelCase
    re.compile(r"\b[A-Z][a-z0-9]+(?:[A-Z][a-z0-9]+)+\b"),                                   # PascalCase
    re.compile(r"\b\w+_\w[\w_]*\b"),                                                          # snake_case
    re.compile(r"\b[a-z0-9]+(?:-[a-z0-9]+){2,}\b"),                                           # hyphenated-names (opal-...)
    re.compile(r"\b[A-Z][A-Z0-9_]{3,}\b"),                                                    # ALL_CAPS
]


def _extract_term(q: str):
    """Pick the most likely search target from a NL question. Quoted text wins; else the
    most specific identifier-ish token; else the longest non-stopword word (>=4 chars)."""
    m = re.search(r'"([^"]{2,})"|\'([^\']{2,})\'', q)
    if m:
        return (m.group(1) or m.group(2)).strip()
    for pat in _TERM_PATS:
        found = pat.findall(q)
        if found:
            return max(found, key=len)
    words = [w for w in re.findall(r"[A-Za-z0-9_]+", q) if w.lower() not in _STOP and len(w) >= 4]
    return max(words, key=len) if words else None


_PATH_RX = re.compile(r"(?<![\w/])([A-Za-z0-9_.-]+/[A-Za-z0-9_./-]+)")


def _extract_path(q: str):
    """A slash-containing path token (for list/find intents -> pass as pathspec, not a pattern)."""
    m = _PATH_RX.search(q)
    return m.group(1).rstrip("/.") if m else None


def _log_rail(decision: str, intent: str, term, q: str) -> None:
    try:
        import datetime
        ts = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    except Exception:
        ts = "?"
    line = '%s  %s  tool=comp-which  intent=%s  term=%s  q="%s"\n' % (
        ts, decision, intent, (term or "-"), q.replace("\n", " ")[:120])
    try:
        os.makedirs(os.path.dirname(RAIL_LOG), exist_ok=True)
        with open(RAIL_LOG, "a", encoding="utf-8") as f:
            f.write(line)
    except Exception:
        pass


def _run_primitive(kind: str, term: str) -> int:
    """RUN the on-rails primitive (the never-dead-end). kind in {grep, glob}. Invokes the
    sibling comp-grep/comp-glob via sys.executable (NOT a bash launcher -> Windows-safe)."""
    script = os.path.join(WS, ".tools", "comp-grep" if kind == "grep" else "comp-glob")
    call = "comp-%s %s" % (kind, term)
    print('comp-which -- no rich comp-tool fits this exact search; running the ON-RAILS primitive:')
    print("  $ %s" % call)
    print("  (on the rail: repo-scoped + .gitignore-aware + logged. If a rich tool SHOULD")
    print("   exist for this recurring intent, that is a TO-5 coverage-gap -> build it.)\n")
    try:
        rc = subprocess.call([sys.executable, script, term], cwd=WS)
        return rc
    except Exception as e:
        # absolute last resort -- still NOT a dead-end: hand the agent the exact on-rail call
        print("comp-which: WARN: could not auto-run (%s). Run it yourself: %s" % (e, call))
        return 0


def main() -> int:
    for _s in (sys.stdout, sys.stderr):  # uncrashable output on a cp1252 console
        try:
            _s.reconfigure(errors="replace")
        except Exception:
            pass
    if len(sys.argv) < 2 or not sys.argv[1].strip():
        print('comp-which "<your question>"  -- maps a natural-language question to the canonical comp-* call.')
        print('  e.g. comp-which "what produces canonical_prices.parquet?"')
        print('  Browse: pipescript --list   |   full catalog: org/modules/graph/graph-call-manifest.yaml')
        return 0
    q = " ".join(sys.argv[1:]).strip()
    qtok = _tokens(q)

    hits = []  # (score, label, calls, why)
    gid = GOLD_ID.search(q)
    if gid:
        hits.append((6, "gold-script id " + gid.group(0),
                     ["comp-pipescript io %s" % gid.group(0), "comp-pipescript feeds/consumers %s" % gid.group(0),
                      "pipescript --resource %s" % gid.group(0)],
                     "what a gold script reads/writes + who feeds/consumes it"))
    # "call sites / callers of X" -> comp-blast is the rich semantic answer (strong route,
    # NOT a text grep): force a high score so it routes even though it reads like a search.
    if CALLSITE_RX.search(q):
        hits.append((6, "call sites / callers",
                     ["comp-blast <fn-name>"],
                     "the call sites / callers of a function (semantic traversal -- pass the function name, not a script)"))
    # estate hygiene intent -> comp-heat (force above a co-occurring find/list verb)
    if HEAT_RX.search(q):
        hits.append((6, "estate object write-freshness / hygiene (comp-heat)",
                     ["comp-heat freshness [path]", "comp-heat drift"],
                     "what's stale/dead/safe-to-archive (cold subtrees) or written-but-not-committed "
                     "(drift); DISTINCT from comp-freshness (data-pipeline S3/DDB)"))
    for keywords, label, calls, why in RULES:
        s = _score_rule(q, qtok, keywords)
        if s > 0:
            hits.append((s, label, calls, why))
    hits.sort(key=lambda x: -x[0])
    best_score = hits[0][0] if hits else 0

    search_intent = bool(SEARCHVERB_RX.search(q))
    list_intent = bool(LISTVERB_RX.search(q))
    term = _extract_term(q)

    print('comp-which -- best match for: "%s"\n' % q)

    # --- DECISION (never dead-ends, NFRA_COMPRAIL TO-2 AC1; LD-0208 backstop-reorder) ----------
    # 1) STRONG curated route (>=4 == a phrase match or 2+ keyword tokens) -> the vetted answer.
    # 2) EXPLICIT search/list verb ("where is X", "find Y", "list files") -> RUN the primitive
    #    (the literal-find case native grep used to own -> now on the rail).
    # 3) LD-0208 (B): no search verb + weak/zero curated -> consult the manifest-fuzzy BACKSTOP
    #    BEFORE any grep. A confident backstop hit (overlap >= MF_STRONG, strictly beating the
    #    weak curated score) ROUTES -> this is what makes the ~28 long-tail tools reachable.
    # 4) Still no route but an extractable term -> RUN the primitive (never a catalog dead-end).
    # 5) A weak curated hit is still a rich-tool pointer -> point.
    # 6) Nothing -> backstop suggestions / on-rail primitive -- never "browse the 41KB catalog".
    STRONG = 4
    MF_STRONG = 3  # LD-0208: manifest-backstop overlap that earns a ROUTE (not a grep fallback)
    mf = _manifest_matches(q, qtok)  # computed once; key fixed (entries) so it actually matches now

    if best_score >= STRONG:
        _route_print(hits)
        _log_rail("ROUTE", hits[0][1], term, q)
        return 0

    if search_intent and term:
        if list_intent:
            kind, target = "glob", (_extract_path(q) or term)  # a path -> pathspec, not a pattern
        else:
            kind, target = "grep", term
        if hits:
            print("  (a rich tool MIGHT fit -- consider first:)")
            _route_print(hits[:1])
        _log_rail("RUN-%s" % kind.upper(), (hits[0][1] if hits else "no-rich-tool"), target, q)
        return _run_primitive(kind, target)

    if mf and mf[0][0] >= MF_STRONG and mf[0][0] > best_score:
        print("  (matched the catalog backstop -- closest rich tool(s):)")
        for overlap, tool, call, uc in mf:
            print("  -> %s   (%s)" % (call or tool, uc))
        print("")
        print("  (comp-which routed via the manifest backstop -- run the call yourself.)")
        _log_rail("ROUTE", "manifest:%s" % (mf[0][1] or "?"), term, q)
        return 0

    if best_score == 0 and term:
        if list_intent:
            kind, target = "glob", (_extract_path(q) or term)
        else:
            kind, target = "grep", term
        if hits:
            print("  (a rich tool MIGHT fit -- consider first:)")
            _route_print(hits[:1])
        _log_rail("RUN-%s" % kind.upper(), (hits[0][1] if hits else "no-rich-tool"), target, q)
        return _run_primitive(kind, target)

    if hits:
        _route_print(hits)
        _log_rail("ROUTE", hits[0][1], term, q)
        return 0

    # nothing matched and no extractable term: still on-rail, never the 41KB-catalog dead-end
    if mf:
        print("  (no high-confidence rule; closest catalog entries:)")
        for overlap, tool, call, uc in mf:
            print("  -> %s   (%s)" % (call or tool, uc))
        print("")
    if list_intent:
        _log_rail("RUN-GLOB", "no-rich-tool", ".", q)
        return _run_primitive("glob", ".")
    print("  No rich tool fit and no clear search term. The on-rails primitives (never a bare grep):")
    print("    comp-grep <pattern> [pathspec]   -- .gitignore-aware, logged repo search + dependency context")
    print("    comp-glob <pattern> [pathspec]   -- .gitignore-aware file find + dependency context")
    print("  Browse named threads: pipescript --list")
    _log_rail("NO-TERM", "none", term, q)
    return 0


def _route_print(hits):
    for s, label, calls, why in hits[:3]:
        print("  -> %s" % "   |   ".join(calls))
        print("     [%s] %s" % (label, why))
        print("")
    print("  (comp-which routed -- run the call yourself. No tool fit? it would have RUN comp-grep/comp-glob.)")


