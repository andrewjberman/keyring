_DEPRECATED_TOOLS = None


def _deprecated_tools():
    """TOOL IDs the population authority marks `status: deprecated` (comp-coverage-map.yaml
    schema.node_fields.status, NFRA_CLDGRPH CG-s-30, 2026-09-09 Andrew-direct).

    A deprecated tool STAYS IN THE POPULATION -- it is homed, counted, parity-checked and still
    CALLABLE BY NAME. It is only PULLED OUT OF SELECTION here: never ranked, never drilled to from
    a surface. That is the whole control; there is no gate and no refusal anywhere (Andrew: "We do
    not need to gate it, merely need to pull it out of comp-which selection, that will be enough").

    Read from the ledger comp-which already loads (compiled index first, YAML on sha mismatch), so
    this costs nothing on the hot path. An empty/failed read returns an EMPTY set -- the router
    never crashes and never silently drops a live tool.
    """
    global _DEPRECATED_TOOLS
    if _DEPRECATED_TOOLS is None:
        out = set()
        led = _load_ledger() or {}
        for section in ("tools", "meta_tools"):
            for row in (led.get(section) or []):
                if isinstance(row, dict) and row.get("tool"):
                    if str(row.get("status") or "active") == "deprecated":
                        out.add(str(row["tool"]).strip())
        _DEPRECATED_TOOLS = out
    return _DEPRECATED_TOOLS


def _surface_index(led):
    """{surface_id: {high_level, gap, gap_note, tools:[(tool, concern, concern_tokens)]}} built
    from the ledger. Data-readable (AC3 -- COMPLEARN can score against this projection)."""
    idx = {}
    for s in (led.get("surfaces", []) if led else []):
        sid = s.get("id")
        hl = s.get("high_level_tool")
        if not hl and s.get("high_level_tools"):
            hl = " + ".join(s["high_level_tools"])
        if hl == "GAP" or s.get("gap"):
            hl = "GAP (no dedicated comp-tool)"
        idx[sid] = {"high_level": hl, "gap": bool(s.get("gap")),
                    "gap_note": s.get("gap_note") or s.get("high_level_concern"), "tools": []}
    for t in (led.get("tools", []) if led else []):
        sid = t.get("surface")
        # CG-s-30: a `status: deprecated` tool is NOT an agent route -- it is skipped in the
        # surface drill-down exactly as it is skipped in the ranking. Its membership in the
        # ledger is untouched; only its presentation is.
        if str(t.get("status") or "active") == "deprecated":
            continue
        if sid and sid in idx:
            idx[sid]["tools"].append((t["tool"], t.get("concern", ""), _tokens(t.get("concern", ""))))
    return idx


def _surface_has(ql, kw):
    """Word-boundary match (so 'git' does not match 'digit', 'ms' does not match 'forms')."""
    return re.search(r"(?<![\w])%s(?![\w])" % re.escape(kw), ql) is not None


def _detect_surface(q):
    """The apex surface a question explicitly names. SPECIFIC markers (longest wins) take priority
    over GENERIC 'cloud X' phrases -- so 'ms cloud estate' resolves MS-CLOUD, not AWS-CLOUD."""
    ql = q.lower()
    best, best_len = None, 0
    for sid, kws in SURFACE_KW_SPECIFIC.items():
        for kw in kws:
            if _surface_has(ql, kw) and len(kw) > best_len:
                best, best_len = sid, len(kw)
    if best:
        return best
    for sid, kws in SURFACE_KW_GENERIC.items():
        for kw in kws:
            if _surface_has(ql, kw):
                return sid
    return None


def _surface_first(q, qtok):
    """Resolve SURFACE -> drill to the tool from the ledger taxonomy. Returns
    (surface_id, high_level, [(tool, concern), ...], gap_note) or None (never-dead-end fall-through)."""
    led = _load_ledger()
    if not led:
        return None
    sid = _detect_surface(q)
    if not sid:
        return None
    info = _surface_index(led).get(sid)
    if not info:
        return None
    if info["gap"]:
        return (sid, info["high_level"], [], info.get("gap_note"))
    # rank by CONCERN-token overlap, with surface-indicating tokens stripped (they say WHICH
    # surface, not WHICH tool) so e.g. 'fresh in aws' ranks comp-freshness over comp-aws.
    drill_tok = qtok - _SURFACE_NOISE
    ranked = sorted(info["tools"], key=lambda x: -len(drill_tok & x[2]))
    drilled = [(tool, concern) for tool, concern, toks in ranked if drill_tok & toks]
    return (sid, info["high_level"], drilled, None)


def _print_surfaces():
    """Dump the surface-first taxonomy as data (COMPLEARN-consumable; AC3)."""
    led = _load_ledger()
    if not led:
        print("comp-which --surfaces: ledger unreadable at %s" % LEDGER)
        return 2
    idx = _surface_index(led)
    print("comp-which surface-first taxonomy (from %s):" % os.path.relpath(LEDGER, WS))
    for sid in ("LOCAL", "GIT", "AWS-CLOUD", "MS-CLOUD", "TRINO"):
