GOLD_ID = re.compile(r"(?<![\w])(INF_)?[A-DIS]_-?\d{1,2}[a-z]?(?![\w])")

# --- SUBJECT EXISTENCE (NFRA_COMPEFFICACY CE-p-4, 0.9.0_WK_NFRA_COMPEFFICACY~1, 2026-09-09) ------
# THE DEFECT (T-3 audit finding F2, the CVO's second cut s.4): GOLD_ID above validates a subject's
# SHAPE and never its EXISTENCE. Measured on this file before the change: `comp-which "what does
# INF_D_99 write to s3"` -> rank 1 `comp-pipescript io INF_D_99`, score 2.00, `vetted: true`,
# rc 0, 78 ranked rows -- a gold id NO script tree carries, handed to a seat as a vetted route.
# A mistyped subject is the wrong-object error one step before every downstream read, and the
# router is where every subject question starts.
#
# THE AUTHORITY, FOUND NOT INVENTED (census 2026-09-09, worktree @0e9ef40b37):
#   * `comp-find 'GOLD_ID' .tools --all` -> 2 hits, BOTH in this file (:1279 def, :2236 use).
#     The pattern has no second consumer, so there is no competing id-space to reconcile.
#   * The estate registers gold-script ids IN THE FILESYSTEM, not in a registry file.
#     org/modules/graph/pipeline_cli.py:203 `_discover_script_trees` is explicit -- "re-derive
#     the script-tree universe from the FILESYSTEM at call time -- NOT a frozen list ... A longer
#     hand-list would have gone stale the next time someone adds a tree; a predicate cannot" --
#     and :3016 `_resolve_gold_script` resolves an id by globbing the gold directories. Those
#     two ARE the estate's resolvers for exactly this id-space, and both read directories.
#   * Measured universe: 30 `data/*/scripts/<layer>/` directories on disk, 3 of them carrying
#     GOLD_ID-shaped stems -- black_diamond/gold 29, cot/gold 28, inf/gold 43 -> 74 distinct ids.
#
# So this check is a PREDICATE OVER THE SAME SUBSTRATE the estate's own resolver uses, never a
# hand-kept list in this file: a new firm tree or a new script is covered the day it lands. It
# scans EVERY layer (not only gold) deliberately -- refusing a real id that happens to live in a
# silver tree would be an OVER-refusal, and an over-refusal on the enforcing rail is worse than
# the confident mis-route it replaces.
_SUBJECT_UNKNOWN = "not-applicable"   # the question carries no gold id -- nothing to resolve
_SUBJECT_STATE = {"resolved": _SUBJECT_UNKNOWN, "authority": "", "subject": ""}
_SUBJECT_CACHE = None


def _gold_subject_universe():
    """(ids -> [relative dirs that carry it], [dirs consulted]) from `data/*/scripts/*/*.py`.

    Cached per process: main() consults it at most once, but _spill_full_ranking reads the
    census line too. Any OSError yields an EMPTY universe, and an empty universe DISABLES the
    check (see _resolve_gold_subject) -- a filesystem this cannot read must never become
    "no registry carries it", which would refuse every real id at once.
    """
    global _SUBJECT_CACHE
    if _SUBJECT_CACHE is not None:
        return _SUBJECT_CACHE
    ids, dirs = {}, []
    data_root = os.path.join(WS, "data")
    try:
        trees = sorted(os.listdir(data_root))
    except OSError:
        trees = []
    for tree in trees:
        scripts = os.path.join(data_root, tree, "scripts")
        if not os.path.isdir(scripts):
            continue
        try:
            layers = sorted(os.listdir(scripts))
        except OSError:
            continue
        for layer in layers:
            layer_dir = os.path.join(scripts, layer)
            if layer.startswith("__") or not os.path.isdir(layer_dir):
                continue
            try:
                names = os.listdir(layer_dir)
            except OSError:
                continue
            rel = "data/%s/scripts/%s" % (tree, layer)
            carried = False
            for name in names:
                if not name.endswith(".py") or name.startswith("__"):
                    continue
                stem = name.split(".")[0]
                if GOLD_ID.fullmatch(stem):
                    ids.setdefault(stem, [])
                    if rel not in ids[stem]:
                        ids[stem].append(rel)
                    carried = True
            if carried:
                dirs.append(rel)
    _SUBJECT_CACHE = (ids, dirs)
    return _SUBJECT_CACHE


def _authority_line(dirs, ids):
    """The AUTHORITY, named in one line with its denominator. Printed AND spilled."""
    if not dirs:
        return "data/*/scripts/*/*.py stems matching GOLD_ID (0 directories readable)"
    return ("data/*/scripts/*/*.py stems matching GOLD_ID -- %d ids across %d directories: %s"
            % (len(ids), len(dirs), ", ".join(dirs)))


def _resolve_gold_subject(subject):
    """(state, authority_line, homes, candidates).

    state is 'true' when the id is carried by a script tree, 'false' when it is not, and
    _SUBJECT_UNKNOWN when the universe could not be read at all (fail-OPEN: an unreadable
    substrate is NOT evidence of absence, so the router behaves exactly as it did before).
    Candidates come from difflib against the SAME universe -- never a hand-written alias map.
    """
    ids, dirs = _gold_subject_universe()
    auth = _authority_line(dirs, ids)
    if not ids:
        return _SUBJECT_UNKNOWN, auth, [], []
    if subject in ids:
        return "true", auth, ids[subject], []
    lower = {k.lower(): k for k in ids}
    if subject.lower() in lower:                      # case-insensitive, as _ci_lookup does
        hit = lower[subject.lower()]
        return "true", auth, ids[hit], []
    return "false", auth, [], _nearest_ids(subject, sorted(ids))


def _edit1(a, b):
    """True when b is ONE substitution, insertion, deletion or ADJACENT TRANSPOSITION from a.

    The transposition limb is why this is not just difflib. difflib.SequenceMatcher ranks
    INF_D_20 closer to INF_D_10 (0.875) than to INF_D_02 (0.75), so the single most likely
    real intent behind a transposed id -- the exact negative control this check was built for --
    was ABSENT from a pure-difflib candidate list. Measured on this tool, 2026-09-09.
    """
    la, lb = len(a), len(b)
    if abs(la - lb) > 1:
        return False
    if la == lb:
        diff = [i for i in range(la) if a[i] != b[i]]
        if len(diff) <= 1:
            return True
        if len(diff) == 2 and diff[1] == diff[0] + 1:
            i, j = diff
            return a[i] == b[j] and a[j] == b[i]
        return False
    short, longer = (a, b) if la < lb else (b, a)
    for i in range(len(longer)):
        if longer[:i] + longer[i + 1:] == short:
            return True
    return False


def _nearest_ids(subject, universe, n=5):
    """Nearest real ids: every edit-distance-1 neighbour FIRST, then difflib fills the list.

    Two passes because they fail differently -- edit-1 is exact and can return nothing at all
    (a subject two typos away); difflib always returns something but orders by a similarity
    ratio that does not model a transposition. Neither alone is a candidate list.
    """
    from difflib import get_close_matches
    out = [u for u in universe if _edit1(subject, u)]
    if len(out) < n:
        for cutoff in (0.6, 0.4):
            for c in get_close_matches(subject, universe, n=n * 2, cutoff=cutoff):
                if c not in out:
                    out.append(c)
                if len(out) >= n:
                    break
            if len(out) >= n:
                break
    return out[:n]


def _tokens(s: str):
    return set(re.findall(r"[a-z0-9_]+", s.lower()))


def _score_rule(q: str, qtok: set, keywords) -> int:
    score = 0
    ql = q.lower()
    for kw in keywords:
        if " " in kw or "/" in kw or "." in kw or ":" in kw:
            if kw in ql:
                score += 3  # phrase / path match = strong
        elif kw in qtok:
            score += 2
    return score


# NFRA_TOOLARCH.GATEBOUND Stage B memoization (0.8.0_AE_CloudComp~D, 2026-07-25): _manifest_matches
# is called 2x per query cascade (:1558, :1802) and re-parsed the 133KB MANIFEST from disk every
# single call -- under the warm in-process path (comp-which-routing-test.py's self_route_verdicts,
# up to ~69 tools per run) that is up to ~138 re-parses of a file that never changes mid-process.
# Cache the PARSE, not the per-query result: `data` is query-independent (the overlap-scoring below
# still runs fresh every call, keyed on qtok -- that part is genuine per-query work, not redundant).
# _MANIFEST_LOADED distinguishes "not yet attempted" from "attempted, file absent/bad -> None cached"
# -- without it a missing manifest would re-attempt (and re-fail) the same read every call forever.
_MANIFEST_DATA = None
_MANIFEST_LOADED = False


# COMPILED-INDEX WIRING (CTO ruling #1 @20260728T212335Z, routed 0.8.0_AE_CloudComp). The router's
# hot path stops parsing YAML: .tools/tool_index.py embeds the PARSED manifest + ledger docs
# (generated by gen_tool_registry.py with the exact open+safe_load shape used below, import-verified
# round-trip-equal before the generator replaces the live index). The sha guard makes staleness a
# COST, never a correctness risk: on ANY mismatch/absence/import failure the caller falls back to
# the YAML parse that was the only path before this wiring -- byte-for-byte today's behavior.
# The returned doc is deepcopied so two comp-which module instances in one process (the
# routing-test harness loads a second) keep today's isolation -- each instance owns its doc.
def _index_doc(path, sha_attr, doc_attr):
    """The embedded parsed doc for `path`, ONLY when the live file's sha256 matches the sha
    embedded at generation time. None on any other condition -- caller parses the YAML."""
    try:
        import copy as _cp
        import hashlib as _h
        try:
            import tool_index as _ti
        except ImportError:
            import sys as _s
            _s.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
            import tool_index as _ti
        with open(path, "rb") as f:
            if _h.sha256(f.read()).hexdigest() != getattr(_ti, sha_attr, None):
                return None
        doc = getattr(_ti, doc_attr, None)
        return _cp.deepcopy(doc) if doc is not None else None
    except Exception:
        return None


def _load_manifest_data():
    global _MANIFEST_DATA, _MANIFEST_LOADED
    if not _MANIFEST_LOADED:
        _MANIFEST_LOADED = True
        if os.path.exists(MANIFEST):
            _MANIFEST_DATA = _index_doc(MANIFEST, "MANIFEST_SHA256", "MANIFEST_DOC")
            if _MANIFEST_DATA is None:
                try:
                    import yaml
                    with open(MANIFEST, encoding="utf-8") as f:
                        _MANIFEST_DATA = yaml.safe_load(f)
                except Exception:
                    _MANIFEST_DATA = None
    return _MANIFEST_DATA


def _manifest_matches(q: str, qtok: set, top: int = 3):
    """Keyword-overlap backstop over the manifest use_case entries."""
    out = []
    data = _load_manifest_data()
    if data is None:
        return out
    # LD-0208 fix (A): the manifest stores rows under `entries:`, not `use_cases:`.
    # Reading the wrong key iterated [] and matched NOTHING -> the whole fuzzy backstop
    # was dead, leaving ~28 long-tail tools unreachable via the router.
    # NFRA_TOOLCHECK P3 req#2a fuzzy-backstop hardening (COO~B 2026-07-08): overlap used to
    # count RAW tokens incl. stopwords ("a", "the", "which", "on", ...), so any two entries
    # with long descriptive text could hit overlap>=2/3 on pure function-word coincidence --
    # a real latent false-positive (surfaced by making comp-fedobs's rich concern text
    # routable: it "matched" an unrelated PII query purely on {"a","this","the"}). Strip
    # stopwords from BOTH sides before counting -- overlap now requires SUBSTANTIVE shared
    # vocabulary, tightening every tool's fuzzy match, not just fedobs's.
    qtok_sig = qtok - _STOP
    for e in (data or {}).get("entries", []) if isinstance(data, dict) else []:
        text = " ".join(str(e.get(k, "")) for k in ("use_case", "id", "tool"))
        overlap = len(qtok_sig & (_tokens(text) - _STOP))
        if overlap >= 2:
            out.append((overlap, e.get("tool", "?"), e.get("canonical_call", ""), e.get("use_case", "")[:90]))
    out.sort(key=lambda x: -x[0])
    return out[:top]


