        if gap_note and not drilled:  # MS-CLOUD: honest GAP from the ledger -- do not invent a tool
            print("  -> GAP: %s" % gap_note)
            print("     (no dedicated comp-tool for this surface -- reach via the m365 MCP gateway /")
            print("      the graph ms-layer; an empty node on COMPLEARN's build-next worklist.)")
            _log_rail("ROUTE-SURFACE", "%s:GAP" % sid, term, q)
            return 0
        if drilled:
            for tool, concern in drilled[:3]:
                print("  -> %s   [%s]" % (tool, concern))
        else:
            print("  (no specific concern matched in the question; the %s surface toolkit:)" % sid)
            for tool, concern, _ in _surface_index(_load_ledger()).get(sid, {}).get("tools", [])[:8]:
                print("  -> %s   [%s]" % (tool, concern))
        print("")
        print("  (comp-which routed SURFACE-FIRST from the coverage ledger -- drill within the surface.")
        print("   No tool fit? it would have RUN comp-find -- never a dead-end.)")
        _log_rail("ROUTE-SURFACE", sid, term, q)
        return 0

    if search_intent and term:
        if _posterior_backstop(q, term):  # NFRA_COMPROUTE L4: a rich near-tie beats a bare search
            return 0
        if list_intent:
            kind, target = "glob", (_extract_path(q) or term)  # a path -> pathspec, not a pattern
        else:
            kind, target = "grep", term
        if hits:
            print("  (a rich tool MIGHT fit -- consider first:)")
            _route_print(hits[:1])
        _log_rail("RUN-%s" % kind.upper(), (hits[0][1] if hits else "no-rich-tool"), target, q)
        return _run_primitive(kind, target)

    if mf and mf[0][0] >= MF_STRONG and mf[0][0] > best_score:
        print("  (matched the catalog backstop -- closest rich tool(s):)")
        for overlap, tool, call, uc in mf:
            print("  -> %s   (%s)" % (call or tool, uc))
        print("")
        print("  (comp-which routed via the manifest backstop -- run the call yourself.)")
        _log_rail("ROUTE", "manifest:%s" % (mf[0][1] or "?"), term, q)
        return 0

    if best_score == 0 and term:
        if _posterior_backstop(q, term):  # NFRA_COMPROUTE L4: a rich near-tie beats a bare search
            return 0
        if list_intent:
            kind, target = "glob", (_extract_path(q) or term)
        else:
            kind, target = "grep", term
        if hits:
            print("  (a rich tool MIGHT fit -- consider first:)")
            _route_print(hits[:1])
        _log_rail("RUN-%s" % kind.upper(), (hits[0][1] if hits else "no-rich-tool"), target, q)
        return _run_primitive(kind, target)

    if hits:
        _route_print(hits)
        _log_rail("ROUTE", hits[0][1], term, q)
        return 0

    # nothing matched and no extractable term: still on-rail, never the 41KB-catalog dead-end
    if _posterior_backstop(q, term):  # NFRA_COMPROUTE L4: last rich-route attempt before the on-rail tail
        return 0
    if mf:
        print("  (no high-confidence rule; closest catalog entries:)")
        for overlap, tool, call, uc in mf:
            print("  -> %s   (%s)" % (call or tool, uc))
        print("")
    if list_intent:
        _log_rail("RUN-GLOB", "no-rich-tool", ".", q)
        return _run_primitive("glob", ".")
    print("  No rich tool fit and no clear search term. The on-rails primitives (never a bare grep):")
    print("    comp-find <pattern> [pathspec]       -- graded repo content search + dependency context")
    print("    comp-find --name <glob> [pathspec]   -- graded repo file find + dependency context")
    print("  Browse named threads: pipescript --list")
    _log_rail("NO-TERM", "none", term, q)
    return 0


def _route_print(hits):
    for s, label, calls, why in hits[:3]:
        print("  -> %s" % "   |   ".join(calls))
        print("     [%s] %s" % (label, why))
        print("")
    print("  (comp-which routed -- run the call yourself. No tool fit? it would have RUN comp-find.)")


def _self_report(rc: int) -> None:
    """R8 half 2 -- comp-which SELF-REPORTS into the run telemetry, closing the 295x under-report.

    comp-which was the only major comp tool that never appeared in its own estate's tool
    telemetry: `.tools/comp-blast` calls comp_log_auto and comp-which did not, so it wrote to the
    rail log instead and the two were never joined. Measured 2026-07-30: comp-which had 0 of
    10,305 rows in the run sink while being the most-invoked comp surface in the estate.

    SCOPE, and it is deliberate: a `--route-only` invocation reports NOTHING -- no rail row (the
    existing guard at the top of _log_rail) and no telemetry row either. That mode is the HUD's
    PreToolUse preview and is DOCUMENTED side-effect-free; it was silently not, once, and the fix
    was the flag rather than a downstream strip rule. Adding telemetry to it would re-break the
    same contract and would also refill the sink with SEARCHES AGENTS RAN rather than QUESTIONS
    AGENTS ASKED -- the exact population error that inflated a prior defect estimate by 4 points.

    Never raises: a telemetry sink must never break the tool it measures.

    RULE T (NFRA_COMPEFFICACY CE-t-3, PRD v0.4 s.4.4): the second of comp-which's two
    timeout-carrying subprocesses, reading the SAME _CLOCK _run_primitive() reads -- so a run
    that already spent most of its budget on the fallback primitive has correspondingly less
    left for this telemetry call, never a fresh independent allowance. Never printed for
    --route-only (unchanged: no rail row, no telemetry row, no Rule T line either -- the
    documented side-effect-free contract binds this print too).
    """
    if _ROUTE_ONLY:
        return
    remaining = _CLOCK.remaining() if _CLOCK is not None else 20
    if remaining is not None and remaining <= 0:
        try:
            print("  BUDGET REACHED: %s s (%s); scanned 0 of 1 telemetry_call; results are a "
                  "PREFIX, not the answer; the self-report subprocess was SKIPPED, not run; NO "
                  "CURSOR: this is one indivisible timeout-carrying subprocess -- nothing to "
                  "resume, only to re-run with a larger --budget."
                  % (_compbudget.fmt(_BUDGET_S), _BUDGET_SOURCE))
        except Exception:
            pass
        return
    try:
        subprocess.run(
            [sys.executable, os.path.join(WS, "org", "modules", "graph", "comp_log_auto.py"),
             "comp-which", " ".join(sys.argv[1:])[:200], str(rc)],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=remaining)
        if _CLOCK is not None:
            print("  " + _compbudget.within_budget_line(
                1, 1, "telemetry_call", _BUDGET_S, _BUDGET_SOURCE, round(_CLOCK.elapsed(), 2)))
    except subprocess.TimeoutExpired:
        if _CLOCK is not None:
            try:
                print("  BUDGET REACHED: %s s (%s); scanned 0 of 1 telemetry_call; results are "
                      "a PREFIX, not the answer; the self-report subprocess did not return "
                      "within the remaining budget (TimeoutExpired); NO CURSOR: this is one "
                      "indivisible timeout-carrying subprocess -- nothing to resume, only to "
                      "re-run with a larger --budget."
                      % (_compbudget.fmt(_BUDGET_S), _BUDGET_SOURCE))
            except Exception:
                pass
    except Exception:
        pass


if __name__ == "__main__":
    _rc = main()
