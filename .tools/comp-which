def _emit_training_row(row) -> None:
    """Best-effort append of the flywheel training row to the COMPROUTE queue (COMPLEARN/~E ingests it).
    Decoupled + fail-safe: comp-which stays read-only/deterministic; a write failure never affects routing.
    ENRICHED (NFRA_COMPROUTE charter-2, CTO GO 20260707T110333Z): stamps the JOIN KEYS -- serial (the
    invoking agent), ts_epoch, session_id -- so the route->run outcome-capture can join THIS route to the
    agent's subsequent comp-tool RUN (rolling corpus, keyed serial+tool+ts_epoch) -> the took-and-sufficed
    / rejection routing-outcome signal. Historical rows lack these keys (charter-2's re-measure is
    data-accrual-gated from here). Side-emit only; enrichment failure never affects routing."""
    try:
        import json
        import time
        if isinstance(row, dict):
            row = dict(row)
            row.setdefault("serial", os.environ.get("OPAL_AGENT_SERIAL", ""))
            row.setdefault("ts_epoch", time.time())
            row.setdefault("session_id", os.environ.get("CLAUDE_CODE_SESSION_ID", ""))
            # SRC TAG (NFRA_COMPCLOSE 2026-07-14): --route-only was made rail-silent (the fix above)
            # but STILL emitted training rows -- so the HUD's PreToolUse pipe filled the flywheel
            # corpus with raw SEARCH STRINGS, not questions (the same defect, second sink; the rail
            # fix stopped one sink and this one kept authoring the evidence base). TAG, do not
            # suppress: consumers filter on src, and the historical corpus is salvageable by the
            # same key (a suppressed row can never be re-examined; a tagged one can).
            row.setdefault("src", "hud-route-only" if _ROUTE_ONLY else "live")
        with open(TRAINING_QUEUE, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(row, ensure_ascii=True) + "\n")
    except Exception:
        pass


def _posterior_backstop(q: str, term) -> bool:
    """Called at a would-be-GREP point (comp-which found no vetted rich route). Runs the surface-aware
    posterior ONCE; ALWAYS emits its training_row to the flywheel (fire-and-forget); if the margin gate
    returns a genuine NEAR-TIE, surfaces BOTH rich candidates with their concern (a rich disambiguation
    instead of a bare search -- never-silent-argmax) + logs the rail, and returns True (handled). Else
    returns False -> the caller runs comp-grep/comp-glob (the never-dead-end is preserved). FAIL-SAFE:
    a None posterior (import/route error) -> False -> today's grep behavior, the LIVE rail untouched.
    Positioned AFTER every rich route (curated/surface-first/fuzzy/weak-curated), so ZERO regression."""
    pr = _posterior_route(q)
    if pr is None:
        return False
    _emit_training_row(getattr(pr, "training_row", {}))
    if getattr(pr, "kind", "") != "disambiguation":
        return False
    cands = [s.cap for s in pr.within_margin]
    if len(cands) < 2:
        return False
    print("  no single vetted route -- the surface-aware router surfaces these near-tie rich tools")
    print("  (pick by concern; a margin-disambiguation, never a silent guess):\n")
    for cap in cands[:4]:
        print("  -> %-18s [%s]" % (cap.id, getattr(cap, "concern", "")))
    print("")
    print("  (COMPROUTE posterior: a rich alternative to a bare search -- still never a dead-end;")
    print("   comp-find remains the fallback.)")
    _log_rail("ROUTE-POSTERIOR-DISAMBIG", "+".join(c.id for c in cands[:4]), term, q)
    return True


