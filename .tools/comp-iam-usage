#!/bin/bash
# comp-iam-usage -- the ACCESS-PLANE coldness + reach signal comp-iam lacks (decommission lifecycle).
# comp-iam answers deploy-time CORRECTNESS (does this role have the perms this call needs); this
# SIBLING answers the LIFECYCLE question: is this role/grant still USED, and who still REACHES a
# resource. Modes: role-cold (comp_debris.classify on the identity plane -- RoleLastUsed coldness),
# who-can-reach <arn> (APPLIED resource-policy principals), reach-check <role> <action> <arn>
# (a (principal,action,resource) verdict on the live simulate primitive), permission-cold --role
# <name> --lookback <days> (PERMISSION grain: which GRANTED permissions were never used, over IAM
# Access Advisor ACTION_LEVEL telemetry -- NOT AWS Access Analyzer, which stays HELD), limits (the
# Rule-22a statement). RULE-22a FIX-OR-CARRY is NAMED in the output, never silently inherited: (a)
# reach-check is (action,resource)-precise; (b) ONE --resource-arns per call + a SEPARATE positive
# control; (c) --context-entries for conditioned statements, else UNKNOWN (never a false deny); (+)
# reads LIVE (APPLIED), an unreadable policy is UNKNOWN not 'no reach'. Access Analyzer enable HELD
# (alert-suspension) -- this computes coldness without it. ADVISORY, read-only, NEVER deletes.
#   comp-iam-usage {role-cold [--days 90] [--limit N] | who-can-reach <arn> | reach-check <role> <action> <arn> [--context k=v] | permission-cold --role <name> [--lookback 90] | limits | self-test}
WORKSPACE="$(cd "$(dirname "$0")/.." && pwd)"
python "$WORKSPACE/org/modules/graph/comp_iam_usage.py" "$@"
_exit=$?
python "$WORKSPACE/org/modules/graph/comp_log_auto.py" "comp-iam-usage" "$*" $_exit 2>/dev/null
exit $_exit
