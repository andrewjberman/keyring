#!/usr/bin/env python3
"""comp-kit-striplist-gate <kit_root> -- NFRA_COMPTEAM.A1 req#2 fail-closed strip-list build-gate.

Scans a standalone shipped kit tree (agent_org_blueprint_vN, no git index of its own)
for the 3 CTO-ruled STRIP categories (CTO arch-gate 2026-07-07, relayed via COO):

  1. Credentials/secrets     -- unambiguous secret-file types + content-shaped hits
                                 (AWS access-key/account-id/ARN, assigned secret/token/
                                 key values). Vocabulary reused from the commit-gate's
                                 SINGLE SOURCE OF TRUTH (.tools/commit_gate_lib.sh
                                 CG_LEAK_* pattern classes) per CTO's explicit ruling
                                 ("reuse the existing commit-gate secret-scan regex
                                 set, don't hand-roll new") -- adapted from path+gitignore
                                 gating (that gate's model) to content-line matching
                                 (a shipped kit has no git index to gate on).
  2. Incident-prose          -- a date co-occurring with incident-language, or a named
                                 agent-serial + error-language (CTO's heuristic verbatim).
  3. Partner-firm specifics  -- a real partner name (49F/Cottonwood/Inflection, not the
                                 bare pipeline codes bd/cot/inf which are KEEP-listed
                                 labels) co-occurring with a commercial-terms word or a
                                 dollar-figure -- proximity-gated so generic architecture
                                 vocabulary (e.g. the word "AUM" alone) is never flagged.

Fail-closed on ambiguity within these 3 categories (CTO ruling): a category-1/2/3 hit
strips + flags for manual pass. Everything else defaults to KEEP (macro/project codes,
pipeline short-codes as labels, comp-tool names, bucket/resource naming PATTERNS,
architecture vocabulary, CLAUDE.md-style imperative+gate rules) -- over-stripping breaks
the onboarding value (COO ruling).

Usage:
  comp-kit-striplist-gate <kit_root>      # scan a real kit tree; exit 1 on any hit
  comp-kit-striplist-gate --selftest      # built-in fixture test (no kit tree needed):
                                           # FAILS a planted-secret fixture, PASSES a
                                           # clean-kit-shaped fixture (req#2's own AC).
"""
from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path

# --------------------------------------------------------------------------------
# Category 1: credentials/secrets. File-type half mirrors CG_LEAK_ALWAYS_RE verbatim
# (.tools/commit_gate_lib.sh) -- unambiguous regardless of context. The content half
# reuses that file's CONTEXTUAL WORD VOCABULARY (secret/credential/password/apikey/
# api_key/private_key/access_token/auth_token) but requires an assignment-shaped value
# after it (no git-ignore signal exists for a standalone kit, so an assigned-looking
# value is the substitute precision gate) + adds AWS-shape patterns the word-list alone
# would miss (access-key id, ARN, this estate's literal account id).
# --------------------------------------------------------------------------------
_SECRET_FILE_RE = re.compile(
    r'\.(har|pem|p12|pfx|jks|keystore|ppk|env)$|(^|/)id_(rsa|dsa|ecdsa|ed25519)([./]|$)|(^|/)\.(netrc|pgpass)$',
    re.IGNORECASE,
)
_SECRET_FILE_EXCLUDE_RE = re.compile(r'\.env\.(template|example|sample|dist)$', re.IGNORECASE)

_SECRET_CONTENT_RE = re.compile(
    r'(?i)\b(secret|credential|password|api[_-]?key|private[_-]?key|access[_-]?token|auth[_-]?token)\b'
    r'\s*[:=]\s*["\']?[A-Za-z0-9/_+.\-]{8,}'
    r'|AKIA[0-9A-Z]{16}'
    r'|arn:aws:[a-z0-9-]+:[a-z0-9-]*:\d{12}:'
    r'|-----BEGIN [A-Z ]*PRIVATE KEY-----'
    r'|\b313476888478\b'  # this estate's literal AWS account id
)

# --------------------------------------------------------------------------------
# Category 2: incident-prose. CTO heuristic verbatim: a date co-occurring with
# incident-language, OR a named-agent-serial + error-language combo.
# --------------------------------------------------------------------------------
_DATE_RE = re.compile(r'\b20\d{2}-\d{2}-\d{2}\b')
# CTO's word list VERBATIM (relayed heuristic) -- deliberately NOT extended with adjacent
# engineering vocabulary like "regression"/"stranded": those are standard architecture/QA
# TERMS-OF-ART in this estate (regression-testing, stranded-deploy as a named failure
# CLASS discussed generically), not incident-narrative signals -- broadening the list past
# CTO's literal words pulled routine feature-provenance notes ("X landed <date>, regression-
# clean") into false positives on the real kit (verified against graph-call-manifest.yaml).
_INCIDENT_WORD_RE = re.compile(r'(?i)\b(incident|bug|caused|root[- ]cause|blame)\b')
_AGENT_SERIAL_RE = re.compile(r'\b\d\.\d\.\d_[A-Za-z]{2,4}(_[A-Za-z]+)?(~[A-Z])?\b')
_ERROR_WORD_RE = re.compile(r'(?i)\b(error|exception|traceback|crash(ed)?|fail(ed|ure)?)\b')

# --------------------------------------------------------------------------------
# Category 3: partner-firm proprietary specifics. Proximity-gated (name + commercial
# signal on the SAME line) so bare architecture vocabulary is never flagged.
# --------------------------------------------------------------------------------
_PARTNER_NAME_RE = re.compile(r'(?i)\b(49\s?financial|cottonwood|inflection)\b')
_COMMERCIAL_WORD_RE = re.compile(
    r'(?i)\b(AUM|fee schedule|commission|basis points?|bps|contract value|'
    r'client name|account (id|number))\b'
)
_DOLLAR_FIGURE_RE = re.compile(r'\$\s?\d[\d,]*(\.\d+)?\s?([MBK]\b|million|billion)', re.IGNORECASE)

# Text-file extensions worth scanning; binary/asset noise skipped.
_SCAN_EXTENSIONS = {
    '.md', '.py', '.sh', '.yaml', '.yml', '.json', '.txt', '.cfg', '.toml', '.ini', '.js', '.ts',
}
# Directories never worth descending into (VCS metadata, dependency trees).
_SKIP_DIRS = {'.git', 'node_modules', '__pycache__', '.venv', 'venv'}


def _classify_line(line: str) -> list[str]:
    """Return the STRIP category labels (0+) a single line trips."""
    hits = []
    if _SECRET_CONTENT_RE.search(line):
        hits.append('secrets')
    if _DATE_RE.search(line) and (
        _INCIDENT_WORD_RE.search(line)
        or (_AGENT_SERIAL_RE.search(line) and _ERROR_WORD_RE.search(line))
    ):
        hits.append('incident-prose')
    if _PARTNER_NAME_RE.search(line) and (
        _COMMERCIAL_WORD_RE.search(line) or _DOLLAR_FIGURE_RE.search(line)
    ):
        hits.append('partner-specifics')
    return hits


def scan_file(path: Path, rel: str) -> list[tuple[str, int, str, str]]:
    """Return [(rel_path, line_no, category, line_text)] findings for one file."""
    findings: list[tuple[str, int, str, str]] = []
    if _SECRET_FILE_RE.search(rel) and not _SECRET_FILE_EXCLUDE_RE.search(rel):
        findings.append((rel, 0, 'secrets', '(unambiguous secret-shaped file type)'))
    try:
        text = path.read_text(encoding='utf-8', errors='replace')
    except (OSError, UnicodeDecodeError):
        return findings
    for i, line in enumerate(text.splitlines(), start=1):
        for cat in _classify_line(line):
            findings.append((rel, i, cat, line.strip()[:160]))
    return findings


def scan_tree(root: Path) -> list[tuple[str, int, str, str]]:
    findings: list[tuple[str, int, str, str]] = []
    for path in sorted(root.rglob('*')):
        if not path.is_file():
            continue
        if any(part in _SKIP_DIRS for part in path.parts):
            continue
        rel = str(path.relative_to(root)).replace('\\', '/')
        if path.suffix.lower() not in _SCAN_EXTENSIONS and not _SECRET_FILE_RE.search(rel):
            continue
        findings.extend(scan_file(path, rel))
    return findings


def render(findings: list[tuple[str, int, str, str]]) -> str:
    if not findings:
        return 'PASS: 0 strip-list hits (secrets/incident-prose/partner-specifics)'
    lines = [f'FAIL: {len(findings)} strip-list hit(s) -- fail-closed, gate BLOCKS shipping this kit:']
    for rel, lineno, cat, snippet in findings:
        loc = f'{rel}:{lineno}' if lineno else rel
        lines.append(f'  [{cat}] {loc} :: {snippet}')
    return '\n'.join(lines)


# ------------------------------------------------------------------------------------
# Self-test: req#2's own acceptance criteria ("FAILS a planted-secret fixture, PASSES a
# clean kit"). Uses in-memory fixtures so it never depends on a real kit tree existing.
# ------------------------------------------------------------------------------------
def _selftest() -> int:
    import tempfile

    ok = True

    # --- Fixture 1: a planted secret -- gate MUST fail (fixture per STRIP category) ---
    with tempfile.TemporaryDirectory() as td:
        root = Path(td)
        (root / 'config.py').write_text(
            'api_key = "AKIAABCDEFGHIJKLMNOP"\n'
            'DB_PASSWORD = "hunter2-not-a-real-secret-but-shaped-like-one"\n'
        )
        (root / 'notes.md').write_text(
            '2026-06-22 incident: the COTETL canonical-seal mis-inference caused a false alarm.\n'
        )
        (root / 'client.md').write_text(
            'Cottonwood AUM is $412M as of this quarter, commission 25bps.\n'
        )
        (root / 'id_rsa').write_text('-----BEGIN OPENSSH PRIVATE KEY-----\nfakekeymaterial\n-----END OPENSSH PRIVATE KEY-----\n')
        hits = scan_tree(root)
        cats = {c for _, _, c, _ in hits}
        if cats != {'secrets', 'incident-prose', 'partner-specifics'}:
            print(f'FAIL: planted-secret fixture did not trip all 3 categories (got {cats})')
            ok = False
        else:
            print(f'PASS: planted-secret fixture correctly FAILED the gate ({len(hits)} hits, all 3 categories)')

    # --- Fixture 2: a clean kit -- gate MUST pass (KEEP-listed content only) ---
    with tempfile.TemporaryDirectory() as td:
        root = Path(td)
        (root / 'CLAUDE.md').write_text(
            '## NEVER\n'
            '- NEVER run bare terraform apply (use safe-apply); bare git commit (use safe-commit.sh).\n'
            '- NEVER reference another firm bucket from a pipeline tree (bd/cot/inf gate-blocked).\n'
        )
        (root / 'comp-coverage-map.yaml').write_text(
            'surfaces:\n'
            '  - name: ms-cloud\n'
            '    tool: comp-aws\n'
            '  - name: bd-pipeline\n'
            '    bucket_pattern: opal-data-bd\n'
            'architecture: silver/gold/bronze tiering; C0-C3 CSE; tier/role taxonomy.\n'
        )
        (root / 'docs' / 'ARCHITECTURE.md').parent.mkdir(parents=True, exist_ok=True)
        (root / 'docs' / 'ARCHITECTURE.md').write_text(
            'The router scores query_match + surface_prior; AUM is a domain concept the '
            'portal surfaces generically, with no partner-specific figures shipped here.\n'
        )
        hits = scan_tree(root)
        if hits:
            print(f'FAIL: clean-kit fixture tripped the gate ({len(hits)} false-positive hit(s)):')
            print(render(hits))
            ok = False
        else:
            print('PASS: clean-kit fixture correctly PASSED the gate (0 hits)')

    return 0 if ok else 1


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('kit_root', nargs='?', help='Path to the kit source tree to scan')
    ap.add_argument('--selftest', action='store_true', help='Run the built-in fixture test, no kit tree needed')
    args = ap.parse_args()

    if args.selftest:
        return _selftest()

    if not args.kit_root:
        ap.error('kit_root is required unless --selftest')

    root = Path(args.kit_root)
    if not root.is_dir():
        print(f'ERROR: not a directory: {root}')
        return 2

    findings = scan_tree(root)
    print(render(findings))
    return 1 if findings else 0


if __name__ == '__main__':
    sys.exit(main())
