# --------------------------------------------------------------------------- qualifier lexicon
# The load-bearing panel. These are the shapes that INVERT, LIMIT, or RETRACT a nearby claim -- the
# text that, unread, turns a correct file into a wrong conclusion. Compiled once; one pass.
_QUAL = re.compile(
    r"(?i)(?:^|[\s(\[*_`>-])("
    r"never|not\s+a\b|not\s+the\b|does\s+not|do\s+not|cannot|can\s+not|must\s+not|no\s+longer|"
    r"except\b|unless\b|only\s+(?:if|when|for)|but\s+not|however\b|caveat\b|warning\b|"
    r"corrected\b|correction\b|superseded\b|supersedes\b|deprecated\b|retired\b|obsolete\b|"
    r"prohibited\b|banned\b|forbidden\b|refus\w+|invalid\b|wrong\b|false\b|stale\b|"
    r"out\s+of\s+scope|not\s+in\s+scope|scoped\s+to|limited\s+to|does\s+not\s+cover|"
    r"todo\b|fixme\b|xxx\b|hack\b|known\s+issue|blind\s*spot"
    r")")
_STRONG = {"never", "corrected", "correction", "superseded", "supersedes", "deprecated", "retired",
           "obsolete", "prohibited", "banned", "forbidden", "must not", "cannot", "no longer"}

# argparse/CLI help strings + docstring-vs-signature are the AUTHORITATIVE behavior statements that
# the WRONG-AUTHORITY specimens both missed.
_HELP_RX = re.compile(r"""help\s*=\s*["'](.+?)["']""")
_SIGREF_RX = re.compile(r"`([A-Za-z_][A-Za-z0-9_]*)\(([^`)]*)\)`")


_TREE_CACHE = {}


def _tree(src):
    """ONE ast.parse per run, shared by SHAPE + docstring-authority + CONTRADICTIONS.

    MEASURED, and it is the whole latency story: ast.parse costs 64.9ms on a 3,734-line module, and
    the first cut called it THREE TIMES (once per consumer) -- ~195ms of a 225ms run, against a
    stated millisecond requirement. Profiled rather than guessed: the first optimization I tried
    (tokenization) was 5.1ms and made no difference, because I had assumed the bottleneck instead of
    measuring it.

    KEYED ON CONTENT, NEVER ON id(). The first cut used `id(src)`, and CPython reuses the id of a
    freed object: DEMONSTRATED 2026-08-06 in 10 trials -- scan file A, drop it, scan file B, and B
    received A's sections. In a one-shot CLI only one file is ever read, so the defect is invisible
    in production and fires the moment anything reads two files in one process (a battery, a batch
    mode, an import-as-library). A cache that can serve ANOTHER FILE'S SHAPE is this tool's own
    thesis failing inside the tool: right question, wrong file, no error. Content-keying costs one
    str hash (cached by CPython after the first)."""
    key = src
    if key not in _TREE_CACHE:
        try:
            _TREE_CACHE[key] = ast.parse(src)
        except SyntaxError:
            _TREE_CACHE[key] = None
    return _TREE_CACHE[key]


_SCAN_CACHE = {}


def _scan_tree(src):
    """ONE ast.walk, three collectors: section spans + docstring ranges + def arities.

    MEASURED TWICE, because I guessed wrong the first time. Round 1 I assumed tokenization was the
    cost (it is 5.1ms) and optimized it -- no change. Round 2 profiled: ast.parse x3 = ~195ms.
    Fixed by caching the parse; still 181ms. Round 3 profiled AGAIN: ast.walk, 66,966 calls,
    174ms cumulative -- THREE FULL TREE WALKS, one per consumer. One walk serves all three.
    The lesson is the tool's own: I read the symptom (slow) and twice acted before reading the
    mechanism.

    CONTENT-KEYED, never id()-keyed -- see _tree() for the demonstrated cross-file collision."""
    key = src
    if key in _SCAN_CACHE:
        return _SCAN_CACHE[key]
    tree = _tree(src)
    sections, docs, defs = [], [], {}
    if tree is not None:
        for node in ast.walk(tree):
            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
                end = getattr(node, "end_lineno", None) or node.lineno
                sections.append({"name": node.name,
                                 "kind": "class" if isinstance(node, ast.ClassDef) else "def",
                                 "start": node.lineno, "end": end})
                if not isinstance(node, ast.ClassDef):
                    a = node.args
                    n = len(a.posonlyargs) + len(a.args) + len(a.kwonlyargs)
                    defs[node.name] = (n, node.lineno, len(a.defaults) + len(a.kw_defaults or []))
            if isinstance(node, (ast.Module, ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
                body = getattr(node, "body", None)
                if body and isinstance(body[0], ast.Expr)                         and isinstance(body[0].value, ast.Constant)                         and isinstance(body[0].value.value, str):
                    d = body[0]
                    docs.append((d.lineno, getattr(d, "end_lineno", d.lineno)))
        sections.sort(key=lambda x: x["start"])
    _SCAN_CACHE[key] = (sections, docs, defs)
    return _SCAN_CACHE[key]


def _read(path):
    with open(path, "r", encoding="utf-8", errors="replace") as fh:
        return fh.read()


# --------------------------------------------------------------------------- SHAPE
def _sections_py(src, lines):
    """def/class spans PLUS the module-level gaps between them.

    DEFECT FOUND BY THE TRIAL (0.8.0_AE_CloudComp~A, 2026-08-06, TRIAL-1 @541f73019), and it is the
    adverse finding the whole trial turned on. This returned ONLY def/class spans, so on a .py file
    EVERY MODULE-LEVEL LINE WAS IN NO SECTION AT ALL -- the import block above the first def was
    unreachable by --for, unreachable by --at, unreachable by any rephrasing. Measured on their
    specimen: SHAPE's first section began at line 26 while the import naming the file's engine sat
    at line 23, permanently invisible.

    THAT IS A HOLE EXACTLY WHERE THIS TOOL IS MOST USED. "What does this file exercise / import /
    depend on" is an IMPORT question, and comp-read could not answer it once, let alone across a
    79-file census. The trial's verdict -- comp-find PASS, comp-read FAIL on the engine question --
    rests on this, and the verdict was correct.

    THE FIX IS THE GENERAL ONE, not a patch for imports. Any top-level span not covered by a
    def/class becomes its own section, which reaches three distinct blind regions with one change:
    the import/constant header, module-level code BETWEEN defs, and the trailing
    `if __name__ == "__main__":` block -- that last one being how their F1 specimen
    (test_comp_system_metrics.py) runs its entire body, so the narrow import-only fix would have
    left that file just as unreadable.

    Coverage is computed from tree.body (TOP-LEVEL only), never from the walked node list: nested
    defs are emitted as their own overlapping sections by design, and subtracting them would carve
    false gaps out of a class body.
    """
    sections, _docs, _defs = _scan_tree(src)
    if not sections:
        return None
    tree = _tree(src)
    covered = []
    for node in getattr(tree, "body", []) or []:
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
            covered.append((node.lineno, getattr(node, "end_lineno", None) or node.lineno))
    covered.sort()
    gaps, cur = [], 1
    for a, b in covered:
        if a > cur:
            gaps.append((cur, a - 1))
        cur = max(cur, b + 1)
    if cur <= len(lines):
        gaps.append((cur, len(lines)))

    out = list(sections)
    for a, b in gaps:
        body = [lines[i - 1] for i in range(a, min(b, len(lines)) + 1)]
        if not any(ln.strip() for ln in body):
            continue                                  # whitespace-only gap is not a section
        joined = "\n".join(body)
        if re.search(r"^\s*(?:import |from \w[\w.]* import)", joined, re.M):
            name = "module header -- imports + module-level"
        elif re.search(r"^\s*if\s+__name__\s*==", joined, re.M):
            name = "__main__ entry -- module-level execution"
        else:
            name = "module-level code"
        out.append({"name": name, "kind": "module", "start": a, "end": b})
    out.sort(key=lambda s: (s["start"], s["end"]))
    return out


_MD_HEAD = re.compile(r"^(#{1,6})\s+(.*)")
# A BOLD LINE IS A HEADING IN THIS ESTATE'S PROSE. Measured on the postmortem corpus: CLAUDE.md has
# 10 `#` headings and 46 bold-led rule lines; docs/references/INCIDENTS_2026-07-13.md has ONE `#`
# heading and 10 bold pseudo-headings. Recognising only `#` collapsed that incident file to a SINGLE
# section, so SALIENT rendered "top 1 of 1" and comp-read added nothing on exactly the corpus it
# would most be used against (found by the run-0 mechanical A/B).
_MD_BOLD = re.compile(r"^\s{0,3}(?:[-*+]\s+|\d+[.)]\s+|>\s+)?\*\*(.{2,90}?)\*\*")


def _sections_md(lines):
    """Sections from `#` headings AND bold-led lines, each tagged with its own kind.

    Finer granularity is the POINT, not a side effect: in this estate a numbered rule ("14a. **Commit
    via ...**") is the semantic unit a reader wants, and lumping 46 of them under one h2 is what let a
    query rank the right SECTION while the answering line sat 20 lines away.
    """
    out = []
    for i, ln in enumerate(lines, 1):
        m = _MD_HEAD.match(ln)
        if m:
            out.append({"name": m.group(2).strip()[:70], "kind": "h%d" % len(m.group(1)),
                        "start": i, "end": None})
            continue
        b = _MD_BOLD.match(ln)
        if b:
            out.append({"name": b.group(1).strip()[:70], "kind": "bold", "start": i, "end": None})
    for i, sec in enumerate(out):
        sec["end"] = (out[i + 1]["start"] - 1) if i + 1 < len(out) else len(lines)
    return out


def _sections_generic(lines):
    """Top-level keys / blank-line blocks. The fallback that keeps the SHAPE panel honest for
    yaml/json/sh/ts -- a file we cannot parse still gets a real denominator, never a blank map."""
    out = []
    for i, ln in enumerate(lines, 1):
        if re.match(r"^[A-Za-z_\"'\[][^\s:=]*\s*[:=]", ln) and not ln.startswith((" ", "\t")):
            out.append({"name": ln.strip()[:70], "kind": "key", "start": i, "end": None})
    for i, s in enumerate(out):
        s["end"] = (out[i + 1]["start"] - 1) if i + 1 < len(out) else len(lines)
    return out


def _shape(path, src, lines):
    """Returns (sections, how). `how` PREFIXED with UNPARSEABLE when a .py did not parse.

    THE GAP THIS CLOSES (found by the acceptance battery, 2026-08-06): a .py with a syntax error
    silently fell through to the generic/whole-file fallback and rendered `via whole-file` -- BYTE
    IDENTICAL to a valid module that simply defines nothing. So a reader whose file failed to parse
    was told the file HAS NO STRUCTURE rather than THE TOOL COULD NOT SEE IT, and every downstream
    panel that depends on the AST (docstring AUTHORITY tagging, CONTRADICTIONS) degraded to silence
    with no marker. Rule 2 of this tool is NEVER TRUNCATE SILENTLY; a degraded parse is a truncated
    view of the file, so it prints its own name."""
    ext = os.path.splitext(path)[1].lower()
    # Q4 (2026-09-02): route on WHAT THE FILE IS, not only on what its NAME ends with.
    # RULED 1.0.0_SA_CTO 90547; re-homed both halves to this seat by 2.0.0_SA_COO 92538.
    # The ~100 comp-* tools in .tools/ are python with NO extension, so `ext == ".py"` sent the
    # estate's own instruments to the generic backend: they rendered "via top-level-keys" and
    # enumerated UNBANDED. Banding was WEAKEST on exactly the files agents read most -- and
    # CLAUDE.md Rule 21 now routes single-file reads TOWARD comp-read, so the miss compounds.
    # Detected on the SHEBANG, which is a fact about the file, not about its name. Scoped
    # deliberately: a shebang naming python only. A bash/sh shebang (.tools/aws, the hooks) is
    # NOT python and must keep the generic backend -- routing it to the AST would produce
    # UNPARSEABLE on a perfectly valid shell script, which is worse than an honest generic read.
    if not ext and src[:2] == "#!":
        _first = src.split("\n", 1)[0].lower()
        if "python" in _first:
            ext = ".py"
    if ext == ".py":
        s = _sections_py(src, lines)
        if s:
            return s, "python-ast"
        if _tree(src) is None:
            g = _sections_generic(lines)
            if not g:
                g = [{"name": os.path.basename(path), "kind": "file",
                      "start": 1, "end": len(lines)}]
            return g, "UNPARSEABLE-python (syntax error) -- fell back to top-level-keys"
    if ext in (".md", ".rst", ".txt"):
        s = _sections_md(lines)
        if s:
            return s, "markdown-headings"
    s = _sections_generic(lines)
    return (s, "top-level-keys") if s else ([{"name": os.path.basename(path), "kind": "file",
                                              "start": 1, "end": len(lines)}], "whole-file")


# --------------------------------------------------------------------------- ENUMERATE (--enumerate)
# Andrew-direct 2026-09-01: "It should enumerate ... the same efficacy as comp-find just at the
# file-content level." comp-find answers WHERE ACROSS THE REPO; this answers WHERE INSIDE ONE FILE.
#
# THE BAND SET IS A SCHEMA (CLAUDE.md Rule 24 TAXONOMY LAW), recorded here in full:
#
#   AXIS (one, and only one): WHAT KIND OF REGION does this hit sit in? Not importance, not
#   recency, not salience -- those are other axes and the digest already serves them. Mixing any
#   of them in here would be the intent-coherence defect.
#
#   (i) MECE over a DECLARED domain. Domain = every line-level occurrence of the pattern in ONE
#       file. Bands are evaluated FIRST-MATCH-WINS in the order listed per backend, so every hit
#       lands in exactly one band and the bands SUM to the total -- asserted by the battery, not
#       asserted here.
#   (ii) SAME GRAIN. Every band is a LINE-level region type. No band is a file or a symbol.
#   (iii) INTENT COHERENCE. One question: where does this occurrence live?
#   (iv) STATE COHERENCE -- which bands one remedy does NOT move:
#         * Editing a docstring moves DOCSTRING only.
#         * Renaming a symbol moves DEF and CODE together, and moves COMMENT only if a human
#           also updated the prose -- which is precisely the drift this banding makes visible.
#         * Reformatting (black/ruff) can move CODE<->DEF boundaries; it moves neither DOCSTRING
#           nor COMMENT counts.
#
# BANDS ARE BACKEND-DEPENDENT AND THAT IS DELIBERATE. A python AST can distinguish a docstring
# from a comment; a top-level-keys scan of a .json cannot, and pretending otherwise would be a
# band that CANNOT FAIL. Where the backend cannot type regions, we emit ONE band (UNBANDED) and
# say UNAVAILABLE -- never four rows of 0, which would claim the distinction was tested.
_BANDS_PY = ("DOCSTRING", "COMMENT", "DEF", "CODE")
_BANDS_MD = ("HEADING", "FENCE", "PROSE")
_DEFLINE_RX = re.compile(r"^\s*(?:async\s+)?(?:def|class)\s")
_FENCE_RX = re.compile(r"^\s*(?:```|~~~)")
# Value delimiters for the WHOLE-VALUE test. A "value" is the maximal run of characters around the
# match that is not broken by one of these. Chosen so a JSON string value, a bare token and a YAML
# scalar all resolve the same way.
_VALUE_DELIM = set("\"',[]{}()<>|= \t\r\n")


def _band_ctx(how, src, lines):
    """Precompute, ONCE, whatever the backend needs to type a line. Returns (bandset, ctx)."""
    if how == "python-ast":
        _sections, docs, _defs = _scan_tree(src)
        doc_lines = set()
        for a, b in docs:
            doc_lines.update(range(a, b + 1))
        return _BANDS_PY, {"docs": doc_lines}
    if how == "markdown-headings":
        fence, inside = set(), False
        for i, ln in enumerate(lines, 1):
            if _FENCE_RX.match(ln):
                fence.add(i)
                inside = not inside
                continue
            if inside:
                fence.add(i)
        return _BANDS_MD, {"fence": fence}
    return None, {}


def _band_of(lineno, line, bandset, ctx):
    """FIRST-MATCH-WINS -- the ordering IS the MECE guarantee, so it is written as one chain.

    DOCSTRING is tested BEFORE COMMENT on purpose: a line inside a docstring that happens to begin
    with '#' is prose, not a comment, and the reverse order would silently mis-band every hashed
    line in every module docstring in the estate."""
    if bandset is _BANDS_PY:
        if lineno in ctx["docs"]:
            return "DOCSTRING"
        if line.lstrip().startswith("#"):
            return "COMMENT"
        if _DEFLINE_RX.match(line):
            return "DEF"
        return "CODE"
    if bandset is _BANDS_MD:
        if lineno in ctx["fence"]:
            return "FENCE"
        if _MD_HEAD.match(line) or _MD_BOLD.match(line):
            return "HEADING"
        return "PROSE"
    return "UNBANDED"


def _enclosing_value(src, start, end):
    """The token this code CONSIDERS to be the value around a match.

    WARN: WHY THIS IS RETURNED AND PRINTED, NOT JUST TESTED: "whole-value vs substring" needs a notion
    of where a value ENDS, and that is a DELIMITER JUDGEMENT, not a token fact. `:` is deliberately
    NOT a delimiter, so a compound id reads as ONE value -- which is what makes the anchor arm
    correct on the measured specimen. The same choice makes a YAML key `name:` read as a SUBSTRING.
    That trade pulls opposite ways depending on the file, so the rule must not be trusted silently:
    printing the enclosing token makes a wrong delimiter call FALSIFIABLE ON SIGHT instead of
    buried in a label the reader cannot check."""
    i = start
    while i > 0 and src[i - 1] not in _VALUE_DELIM:
        i -= 1
    j = end
    while j < len(src) and src[j] not in _VALUE_DELIM:
        j += 1
    return src[i:j]


def _whole_value(src, start, end):
    """Is the match the ENTIRE value, or a fragment of a longer one?

    NOTE: THE HIGHEST-VALUE LINE IN THIS MODE, paid for by a measured incident -- a control
    using rel.startswith('UNMAPPED-RELATIONSHIP') reported 0 while 132 rows carried values reading
    UNLABELLED-RELATIONSHIP:UNMAPPED-RELATIONSHIP:0017633210. Anchor-sensitivity is the file-grain
    twin of comp-find's case/substring trap: the count is right and the CLAIM is wrong."""
    i = start
    while i > 0 and src[i - 1] not in _VALUE_DELIM:
        i -= 1
    j = end
    while j < len(src) and src[j] not in _VALUE_DELIM:
        j += 1
    return src[i:j] == src[start:end]


def _enumerate(path, src, lines, sections, how, pattern, limit, page, width=160,
               band_filter=None, json_mode=False):
    """Enumerate file-local hits without letting a downstream filter erase the claim.

    Every text row carries match-kind and ordinal/denominator.  Synthetic ABSENT and ERROR rows use
    line 0 because the incident's exact receiver (``^\\s+[0-9]+ ``) cannot retain a negative line
    number.  The tag, rather than an unfilterable sign, distinguishes the two outcomes.
    """
    starts, off = [], 0
    for ln in lines:
        starts.append(off)
        off += len(ln) + 1
    bandset, ctx = _band_ctx(how, src, lines)
    counts = {b: 0 for b in (bandset or ("UNBANDED",))}
    hits, whole, sub, enclosing, warnings = [], 0, 0, [], []
    try:
        rx = re.compile(pattern)
    except re.error as exc:
        summary = {
            "hits": 0,
            "lines": len(lines),
            "sections": len(sections),
            "whole": 0,
            "sub": 0,
            "bands": {"ERROR": 1},
            "warn": ["bad --enumerate pattern: %s" % exc],
        }
        row = {
            "line": 0,
            "band": "ERROR",
            "match": "ERROR",
            "hit": {"index": 0, "total": 0},
            "text": "bad --enumerate pattern: %s" % exc,
        }
        if json_mode:
            print(json.dumps({"summary": summary, "rows": [row]}, sort_keys=True))
        else:
            print("comp-read: %s" % path)
            print("  SOURCE: %d lines | %d section(s) via %s | enumerate: %r"
                  % (len(lines), len(sections), how, pattern))
            print()
            print("  ENUMERATE: 0 hit(s) across %d lines / %d section(s) scanned"
                  % (len(lines), len(sections)))
            print("    whole-value matches: 0   |   substring matches: 0")
            print()
            print("    %6d  %-11s %-6s hit %d/%d %s"
                  % (0, "ERROR", "ERROR", 0, 0, row["text"][:width]))
            _BUDGET_STATE["trailer"] = (
                "ENUMERATE-END: 0 hit(s) | 0 whole | 0 sub | ERROR=1")
        return 2
    for m in rx.finditer(src):
        i = bisect.bisect_right(starts, m.start()) - 1
        if i < 0:
            i = 0
        lineno = i + 1
        line = lines[i] if i < len(lines) else ""
        band = _band_of(lineno, line, bandset, ctx)
        counts[band] = counts.get(band, 0) + 1
        if _whole_value(src, m.start(), m.end()):
            whole += 1
            kind = "WHOLE"
        else:
            sub += 1
            kind = "SUB"
            tok = _enclosing_value(src, m.start(), m.end())
            if len(enclosing) < 3 and tok not in enclosing:
                enclosing.append(tok)
        hits.append((lineno, band, kind, line.strip()))
    total = len(hits)

    if total and whole == 0 and sub:
        warnings.append("every hit is a fragment of a longer value")
    if not bandset:
        warnings.append("banding unavailable for backend %s" % how)
    summary = {
        "hits": total,
        "lines": len(lines),
        "sections": len(sections),
        "whole": whole,
        "sub": sub,
        "bands": {b: counts.get(b, 0) for b in (bandset or ("UNBANDED",))},
        "warn": warnings,
    }
    indexed = [(idx, hit) for idx, hit in enumerate(hits, 1)
               if band_filter is None or hit[1] == band_filter]
    pages = max(1, (len(indexed) + limit - 1) // limit)
    page = max(1, min(page, pages))
    lo = (page - 1) * limit
    shown = indexed[lo:lo + limit]
    rows = [
        {
            "line": hit[0],
            "band": hit[1],
            "match": hit[2],
            "hit": {"index": idx, "total": total},
            "text": hit[3][:width],
        }
        for idx, hit in shown
    ]
    if not total:
        rows = [{
            "line": 0,
            "band": "ENUMERATE",
            "match": "ABSENT",
            "hit": {"index": 0, "total": 0},
            "text": "scanned %d lines / %d sections; pattern absent from this file"
                    % (len(lines), len(sections)),
        }]

    if json_mode:
        print(json.dumps({"summary": summary, "rows": rows}, sort_keys=True))
        return 0

    print("comp-read: %s" % path)
    # The SOURCE prefix is load-bearing: the incident's numeric-row grep retained the old bare
    # ``N lines`` metadata line, creating one surviving line that still lacked the claim.
    print("  SOURCE: %d lines | %d section(s) via %s | enumerate: %r"
          % (len(lines), len(sections), how, pattern))
    print()
    print("  ENUMERATE: %d hit(s) across %d lines / %d section(s) scanned"
          % (total, len(lines), len(sections)))
    print("    whole-value matches: %d   |   substring matches: %d" % (whole, sub))
    if enclosing:
        # The delimiter rule is a JUDGEMENT. Show what it treated as the value so a wrong call is
        # visible rather than trusted -- ':' is not a delimiter, so a compound id stays one value.
        print("    value boundary = whitespace/quote/bracket/comma/equals (NOT ':' or '-')")
        for t in enclosing:
            print("      substring inside: %s" % (t[:96] + ("..." if len(t) > 96 else "")))
    if total and whole == 0 and sub:
        print("    WARN: every hit is a FRAGMENT of a longer value. An anchored probe")
        print("          (startswith / == / fullmatch) would report ZERO against this file.")
    if bandset:
        print("    BANDS (sum to %d):" % total)
        for b in bandset:
            print("      %-11s %d" % (b, counts.get(b, 0)))
    else:
        print("    BANDS: UNAVAILABLE for this backend (%s) -- region typing needs a parsed" % how)
        print("           structure this file does not provide. ONE band is printed rather than")
        print("           typed rows of 0, which would claim the distinction was tested.")
        print("      %-11s %d" % ("UNBANDED", total))
    print()
    if not total:
        row = rows[0]
        print("    %6d  %-11s %-6s hit %d/%d %s"
              % (row["line"], row["band"], row["match"], row["hit"]["index"],
                 row["hit"]["total"], row["text"][:width]))
    else:
        suffix = " in band %s" % band_filter if band_filter else ""
        print("  PAGE %d of %d  (showing %d of %d%s)"
              % (page, pages, len(shown), len(indexed), suffix))
        for row in rows:
            print("    %6d  %-11s %-6s hit %d/%d %s"
                  % (row["line"], row["band"], row["match"], row["hit"]["index"],
                     row["hit"]["total"], row["text"]))
    if len(indexed) > limit:
        rest = len(indexed) - len(shown)
        print()
        print("  MORE: %d hit(s) not shown. Next: --page %d   (a PAGE IS NOT AN ANSWER)"
              % (rest, min(page + 1, pages)))
    band_tail = " | ".join("%s=%d" % (b, summary["bands"][b]) for b in summary["bands"])
    _BUDGET_STATE["trailer"] = (
        "ENUMERATE-END: %d hit(s) | %d whole | %d sub | %s"
        % (total, whole, sub, band_tail))
    return 0


# --------------------------------------------------------------------------- SALIENCE (BM25-lite)
def _toks(s):
    """Emit the whole identifier AND its underscore/camel parts.

    WHY BOTH (measured on the first acceptance run): splitting only on non-word chars makes
    `test_multi_pipeline` a SINGLE token, so the question "which TEST FILES does this gate run"
    scored the WATCH_GLOBS block -- the literal answer -- at 0.66 and left it out of SALIENT. The
    file's own vocabulary is underscore-joined; a reader's question never is. Keeping the whole
    token preserves exact-identifier matching; adding the parts is what lets a plain-English
    question reach code."""
    out = []
    for t in re.split(r"[^A-Za-z0-9_]+", s.lower()):
        if len(t) > 2:
            out.append(t)
            if "_" in t:
                out.extend(p for p in t.split("_") if len(p) > 2)
            # PLURAL FOLDING. A question is asked in the plural ("why did our DETECTORS miss the
            # DEFECTS") and a finding is written in the singular ("every DETECTOR we own ... this
            # DEFECT class"). Without this the overlap is literally ZERO and the answering section
            # does not rank at all -- measured on the run-1 neutral corpus (MDPF postmortem, the
            # one-sentence finding at line 18 went unranked). Deterministic suffix strip, no stemmer.
            if len(t) > 3 and t.endswith("s") and not t.endswith("ss"):
                out.append(t[:-1])
                if t.endswith("es") and len(t) > 4:
                    out.append(t[:-2])
    return out


def _score_sections(sections, lines, question, line_toks=None):
    """Deterministic overlap scoring, ONE tokenization pass over the file.

    PERF NOTE, measured not assumed: the first cut re-tokenized each section's BODY, so a 3.7k-line
    file with 52 defs tokenized the text ~52 times and ran 205ms -- over the millisecond bar this
    tool exists to meet (Andrew-direct: "it is important that it functions in milliseconds for it to
    be practical"). Tokenizing each LINE once and aggregating per section is the same arithmetic at
    O(lines) instead of O(lines x sections)."""
    q = set(_toks(question))
    if not q:
        return {}
    if line_toks is None:
        line_toks = [_toks(ln) for ln in lines]
    scores = {}
    for idx, s in enumerate(sections):
        hits = 0
        n = 0
        for i in range(s["start"] - 1, min(s["end"] or s["start"], len(lines))):
            lt = line_toks[i]
            n += len(lt)
            for t in lt:
                if t in q:
                    hits += 1
        if not n:
            continue
        # NAME match is a WEAK hint, not the signal. A DOCUMENT TITLE is pure keywords -- "MDPF
        # Postmortem -- OPAL_CONSOLIDATION / MDPF_REVAMP / MDPF_3FIRMS" matches "mdpf" three times in
        # a TWO-LINE section, so a 3.0 name weight made the title outrank every section that could
        # actually contain an answer. Found by the run-1 neutral corpus (postmortems I did not pick):
        # the title won at 9.90 while the one-sentence finding sat unranked at line 18.
        # DISTINCT query tokens matched, NOT occurrences. "MDPF Postmortem -- MDPF_REVAMP /
        # MDPF_3FIRMS / MDPF_CANRTE" contains `mdpf` four times, which is ONE fact about the
        # section, not four. Counting occurrences multiplied a title's single subject word by its
        # own repetition, and the damping added below was sized against the un-multiplied value --
        # so the moment a question NAMED THE DOCUMENT'S SUBJECT (the most natural thing an agent
        # asks) the title returned to rank 1: measured 2026-08-06, title 2.18 vs the answering
        # section 1.46, on a query differing from the passing one only by the word "mdpf".
        # THIS IS A DOUBLE-COUNT REMOVAL, NOT A RELEVANCE HEURISTIC. It encodes nothing about what
        # an answer looks like.
        #
        # >> ANDREW-DIRECT 2026-08-06 ~2041Z, VERBATIM: "No we do not tune the tool to the last 2
        #    of the 5, i do not want to overfit like that."  THE CALL IS CLOSED, NOT OPEN. <<
        #
        # The conclusion-boost (rank sections whose headings look like findings) would take the
        # neutral A/B corpus from 3/5 to 5/5 and is PROHIBITED. comp-read scores 3/5; that is its
        # honest measured performance and it stays in the record beside its cause -- term frequency
        # under-ranks the terse one-sentence finding. A successor must NOT re-raise this as an open
        # design question and must NOT re-attempt the boost under another name.
        #
        # THE LINE BETWEEN A FIX AND A TUNE, because it is the only thing keeping this comment
        # honest: the change on the next line is defensible WITHOUT reference to any eval case -- a
        # title repeating its subject scored it once per repetition, a double-count with a stated
        # mechanism. If you cannot say why a scoring change is right without pointing at your test
        # cases, IT IS A TUNE. Widening the corpus is the legal way to move the number; a heavier
        # thumb is not. A scorer fitted until its own eval passes has destroyed the instrument that
        # would have told you it got worse.
        # Record: memory/feedback_no_overfitting_a_scorer_to_its_own_eval_cases.md
        name_hit = 0.8 * len(set(_toks(s["name"])) & q)
        # SHORT-SECTION DAMPING: a heading/title with almost no body cannot hold the answer, and
        # hits/sqrt(tokens) rewards exactly that shape. Damp until a section has real content.
        span = (s["end"] or s["start"]) - s["start"] + 1
        damp = min(1.0, span / 4.0)
        sc = ((hits / (n ** 0.5)) + name_hit) * damp
        # A ZERO-OVERLAP SECTION IS NOT A RESULT. Keeping score-0.00 entries meant every non-empty
        # file rendered a full SALIENT panel for a question NOTHING in it matched -- four ranked
        # rows at score=0.00 read as findings, and the "MEASURED zero" branch below became
        # unreachable for any file with tokens in it. An honest-zero message that can never print
        # is the same as not having one.
        if sc > 0:
            scores[idx] = sc
    return scores


# --------------------------------------------------------------------------- AUTHORITY
def _doc_ranges(src):
    """Docstring line ranges from the single shared tree scan. A docstring's BODY was tagged
    AUTHORITATIVE because the check only looked at the OPENING quotes -- prose about the code
    reading as the code, i.e. the WRONG-AUTHORITY failure occurring inside the tool built to
    prevent it."""
    _sections, docs, _defs = _scan_tree(src)
    return docs



def _window(line, qtoks, width=200):
    """Excerpt AROUND the match, not from the start of the line.

    THE BREAK THIS FIXES (found by the first mechanical A/B run, 3 of 3 case studies): comp-read
    located the RIGHT FILE and the RIGHT LINE and then truncated at a fixed offset -- so on CLAUDE.md's
    ~1500-char rule lines the answer was cut off. Asked what goes wrong calling aws from a
    bash-spawned PowerShell, it returned line 105 sliced BEFORE "HANG ... REPORTS SUCCESS". Asked if
    comp-iam suffices for a new bucket, it cut at "NECES" -- one character before "NECESSARY, NOT
    SUFFICIENT".
    RIGHT FILE, RIGHT LINE, WRONG PART OF THE LINE: the tool committing its own thesis failure one
    level down, and the SAME positional-heuristic class as the first-match-not-best-match bug it
    already carries a comment about. A fixed offset is a statement about where text sits, not about
    where meaning sits."""
    t = line.strip()
    if len(t) <= width or not qtoks:
        return t[:width]
    low = t.lower()
    best, bestpos = -1, 0
    step = 20
    for start in range(0, max(1, len(t) - width + 1), step):
        seg = low[start:start + width]
        score = sum(seg.count(q) for q in qtoks)
        if score > best:
            best, bestpos = score, start
    if best <= 0:
        return t[:width]
    lead = "..." if bestpos > 0 else ""
    tail = "..." if bestpos + width < len(t) else ""
    return lead + t[bestpos:bestpos + width] + tail


def _authority(path, line_text, lineno=None, doc_ranges=()):
    """AUTHORITATIVE = the thing itself (code, signature, help=, assertion).
    DESCRIPTIVE = something ABOUT the thing (comment, prose, docstring) -- drifts, and both
    WRONG-AUTHORITY specimens were exactly this."""
    t = line_text.strip()
    ext = os.path.splitext(path)[1].lower()
    if lineno is not None and any(a <= lineno <= b for a, b in doc_ranges):
        return "DESCRIPTIVE"
    if ext == ".py":
        if t.startswith("#"):
            return "DESCRIPTIVE"
        if re.match(r"^(def |class |async def )", t) or "help=" in t or t.startswith("assert"):
            return "AUTHORITATIVE"
        if t.startswith(('"""', "'''")):
            return "DESCRIPTIVE"
        return "AUTHORITATIVE"
    if ext in (".md", ".rst", ".txt"):
        return "DESCRIPTIVE"
    return "AUTHORITATIVE"


# --------------------------------------------------------------------------- HUD (selective)
def _hud(path, full, src, lines, sections, how, quals, contras):
    """SELECTIVE HUD MODE -- fire only when there is something worth saying, else SILENT.

    ANDREW-DIRECT 2026-08-07, choosing option 3 of three ("I like 3") after reading the MEASURED
    crowding of the full query-less report: 35 lines / 2,265 B on a typical .py, 96 lines / 6,858 B
    on CLAUDE.md (a 133-line file), and 917 B on an EMPTY __init__.py. That report is a CLI product
    for someone who typed the command; as an ambient panel on every Read it taxes the reader most on
    the files they read most.

    THE FIRING SET IS DELIBERATELY NARROW -- three conditions, each one a thing that CHANGES A
    CONCLUSION rather than describes a file:
      1. a STRONG qualifier   -- never / deprecated / superseded / must not / corrected / retired /
                                 prohibited. The "claim gets read, the retraction does not" class
                                 this tool was built for.
      2. an intra-file CONTRADICTION -- the file disagrees with itself.
      3. an UNPARSEABLE .py   -- the tool is BLIND here and silence would be indistinguishable from
                                 a clean read.
    SHAPE, SALIENT, the soft qualifiers and the UNREAD LEDGER are NOT emitted: on a query-less call
    SALIENT can only say "no question given", and SHAPE is the single largest panel by measurement.

    >> THE COST OF THIS CHOICE, STATED HERE BECAUSE IT PARTLY UNDOES THIS TOOL'S OWN THESIS: the
    UNREAD LEDGER exists to remove the ability to NOT NOTICE, making a skip attributable. A HUD that
    stays SILENT restores exactly that invisibility on every file it declines to fire on -- and a
    SOFT qualifier ("only if", "except", "scoped to") is load-bearing surprisingly often and does
    NOT trigger. This mode trades RECALL for the right to be ambient. It is a floor, never a
    substitute for a deliberate `comp-read <file> --for "<question>"`, and the fired panel says so
    on its last line. Do not let a silent HUD be read as "this file is clean." <<
    """
    strong = [(n, w, ln) for (n, w, ln) in quals if w in _STRONG]
    unparseable = how.startswith("UNPARSEABLE")
    if not strong and not contras and not unparseable:
        return 0                                   # SILENT -- the whole point of the mode

    out = ["comp-read HUD: %s  (%d lines, %d section(s))" % (path, len(lines), len(sections))]
    if unparseable:
        out.append("  !! UNPARSEABLE .py -- structure is a TEXT fallback; the AST panels are BLIND,")
        out.append("     so 'no contradictions' here would mean 'could not look', not 'none'.")
    if contras:
        out.append("  !! %d CONTRADICTION(S) -- this file disagrees with ITSELF:" % len(contras))
        for c in contras[:2]:
            out.append("     :%d documents %s() with %d arg(s); the def at :%d takes %d."
                       % (c["line"], c["name"], c["claimed"], c["def_line"], c["actual"]))
    if strong:
        out.append("  !! %d STRONG qualifier(s) -- text that LIMITS / NEGATES / RETRACTS a nearby claim:"
                   % len(strong))
        for n, _w, ln in strong[:3]:
            out.append("     :%d %s" % (n, _window(ln, set(), width=110)))
        if len(strong) > 3:
            out.append("     ... %d more" % (len(strong) - 3))
    # THE FLOOR DISCLAIMER IS NOT OPTIONAL -- see the docstring. A fired panel that does not say
    # what it omitted becomes the thing agents satisfice on, which is failure mode 4 in a new coat.
    out.append("  ^ FLOOR, not a review: soft qualifiers, SHAPE and the UNREAD LEDGER are NOT shown."
               " Full: comp-read %s --for \"<question>\"" % path)
    for ln in out:
        print(_comprail.ascii_safe(ln) if _comprail else ln)
    return len(out)


# --------------------------------------------------------------------------- CONTRADICTIONS
def _contradictions(path, src, lines):
    """CHEAP + INTRA-FILE ONLY (the millisecond budget forbids a repo walk).

    Catches the specimen shape: PROSE DOCUMENTS A CALL, THE CODE DEFINES IT DIFFERENTLY. That is
    `.owned-paths.yaml`'s note documenting a 2-arg `check_agent(...)` against a 4-arg def -- the
    disproof and the claim in one place, and nobody read both.
    """
    out = []
    defs = {}
    if os.path.splitext(path)[1].lower() == ".py":
        _sections, _docs, defs = _scan_tree(src)
    for i, ln in enumerate(lines, 1):
        for m in _SIGREF_RX.finditer(ln):
            name, argstr = m.group(1), m.group(2).strip()
            if name not in defs:
                continue
            claimed = 0 if not argstr else len([a for a in argstr.split(",") if a.strip()])
            actual, dline, ndef = defs[name]
            if claimed and not (actual - ndef <= claimed <= actual):
                out.append({"line": i, "text": ln.strip()[:150], "name": name,
                            "claimed": claimed, "actual": actual, "def_line": dline})
    return out


# --------------------------------------------------------------------------- render
def main() -> int:
    if _comprail:
        _comprail.harden_stdout()
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help"):
        print("comp-read <file> [--for \"<question>\"] [--at LINE] [--top N] [--all-quals] [--budget N]")
        print("comp-read <file> --enumerate '<regex>' [--limit N] [--page N] [--width N]")
        print("               [--band BAND] [--json] [--budget N]")
        print("  --enumerate is a DISTINCT MODE, not part of the digest: where does this token")
        print("  occur in this file, how many times, and in what KIND of region. Prints its")
        print("  denominator, grades hits into bands, and reports whole-value vs substring.")
        print("  SINGLE FILE ONLY -- for a corpus or a pathspec the answer is comp-find.")
        print("  Shows the file's SHAPE, the regions salient to your question (tagged")
        print("  AUTHORITATIVE vs DESCRIPTIVE), every QUALIFIER that limits/negates/corrects a")
        print("  nearby claim, intra-file CONTRADICTIONS, and an UNREAD LEDGER.")
        print("  Excerpts are VERBATIM with line numbers -- this indexes the file, never replaces it.")
        print("  --budget N    RULE T (PRD s.4.4, shared .tools/_compbudget): ceiling in seconds for")
        print("               comp-read's ONE timeout-carrying subprocess (the self-report telemetry")
        print("               sink, fired after every run; carrier: --budget > env COMP_BUDGET_S >")
        print("               default %s s, kept under this box's ~120s outer harness ceiling);"
              % _compbudget.fmt(_compbudget.DEFAULT_BUDGET_S))
        print("               --budget 0 = unbounded. comp-read has NO corpus-width loop, so a")
        print("               BUDGET REACHED line is reachable only by a deliberately tiny value")
        print("               (e.g. --budget 0.001) -- an ordinary run always prints WITHIN BUDGET.")
        return 0

    t0 = time.perf_counter()
    question, at_line, top, all_quals = "", None, 6, False
    enum_pat, enum_limit, enum_page = None, 40, 1
    enum_width, enum_band, enum_json = 160, None, False
    hud_mode = False
    budget_flag = None
    positional = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--for":
            i += 1
            question = argv[i] if i < len(argv) else ""
        elif a == "--at":
            i += 1
            at_line = int(argv[i]) if i < len(argv) and argv[i].isdigit() else None
        elif a == "--top":
            i += 1
            top = int(argv[i]) if i < len(argv) and argv[i].isdigit() else 6
        elif a == "--enumerate":
            i += 1
            enum_pat = argv[i] if i < len(argv) else ""
        elif a == "--limit":
            i += 1
            enum_limit = int(argv[i]) if i < len(argv) and argv[i].isdigit() else 40
        elif a == "--page":
            i += 1
            enum_page = int(argv[i]) if i < len(argv) and argv[i].isdigit() else 1
        elif a == "--width":
            i += 1
            enum_width = int(argv[i]) if i < len(argv) and argv[i].isdigit() else 160
            enum_width = max(1, enum_width)
        elif a == "--band":
            i += 1
            enum_band = argv[i].upper() if i < len(argv) else ""
        elif a == "--json":
            enum_json = True
        elif a == "--all-quals":
            all_quals = True
        elif a == "--hud":
            hud_mode = True
        elif a == "--budget":
            i += 1
            budget_flag = argv[i] if i < len(argv) else None
            if budget_flag is None:
                print("comp-read: ERROR: --budget wants a number of seconds (0 = unbounded)")
                return 2
        else:
            positional.append(a)
        i += 1

    # RULE T (PRD s.4.4): resolved for EVERY code path from here down, including a usage error
    # below (no file / not a file) -- so the ONE timeout-carrying subprocess in _self_report()
    # applies the same carrier whether or not this run went on to read anything. Only --help/-h
    # (which returns above, before this line) skips it -- a declared non-application, not a gap:
    # a help call does zero read-work, so the ceiling it guards against does not apply there, and
    # _self_report() falls back to its pre-Rule-T fixed 20s in that one narrow case.
    try:
        budget_s, budget_source = _compbudget.resolve_budget(budget_flag)
    except ValueError as exc:
        print("comp-read: ERROR: --budget %s" % exc)
        return 2
    _BUDGET_STATE["s"], _BUDGET_STATE["source"] = budget_s, budget_source
    _BUDGET_STATE["quiet"] = hud_mode or enum_json
    _BUDGET_STATE["clock"] = _compbudget.Clock(budget_s)   # starts NOW, before any read work

    if not positional:
        print("comp-read: ERROR: no file given.")
        return 2
    path = positional[0].replace("\\", "/")
    full = path if os.path.isfile(path) else os.path.join(_CORPUS, path)
    if not os.path.isfile(full):
        print("comp-read: ERROR: not a file: %s" % path)
        return 2

    src = _read(full)
    lines = src.splitlines()
    sections, how = _shape(full, src, lines)

    # ---- ENUMERATE MODE: a DISTINCT mode, and it RETURNS before any digest panel renders.
    # Rule 24 (iii): enumeration and summarisation are different intents on different axes. It
    # also has a LIVE CONSUMER -- comp-adversary's stage-4 packet shells out to the default
    # digest, so folding enumeration into that output would silently alter every
    # validation_context_declaration the estate emits.
    if enum_pat is not None:
        return _enumerate(path, src, lines, sections, how, enum_pat, enum_limit, enum_page,
                          enum_width, enum_band, enum_json)
    doc_ranges = _doc_ranges(src) if full.endswith(".py") else []
    _line_toks = [_toks(ln) for ln in lines]
    scores = _score_sections(sections, lines, question, _line_toks) if question else {}
    ranked = sorted(scores.items(), key=lambda kv: -kv[1])[:top] if scores else []
    pinned = None
    if at_line:
        for idx, s in enumerate(sections):
            if s["start"] <= at_line <= (s["end"] or s["start"]):
                if idx not in [r[0] for r in ranked]:
                    ranked.insert(0, (idx, 999.0))
                    pinned = idx
                break

    # ---- SELECTIVE HUD MODE: fire-or-silent, and it RETURNS -- no other panel renders.
    # Placed before every print so the silent path costs exactly one qualifier sweep and emits
    # ZERO bytes. An ambient panel that prints a header before deciding it has nothing to say is
    # not silent, it is quiet, and the whole ruling turns on the difference.
    if hud_mode:
        _quals = []
        for _n, _ln in enumerate(lines, 1):
            _m = _QUAL.search(_ln)
            if _m:
                _quals.append((_n, _m.group(1).lower(), _ln.strip()))
        _hud(path, full, src, lines, sections, how, _quals,
             _contradictions(full, src, lines))
        return 0

    print("comp-read: %s" % path)
    print("  %d lines | %d section(s) via %s | question: %s"
          % (len(lines), len(sections), how, ("%r" % question) if question else "(none given)"))
    if how.startswith("UNPARSEABLE"):
        print("  !! UNPARSEABLE: this .py did NOT parse. The SHAPE below is a TEXT fallback, not the")
        print("     module's real structure, and the AST-backed panels are BLIND here: docstring")
        print("     AUTHORITY tagging degrades to AUTHORITATIVE and CONTRADICTIONS reports none")
        print("     because it could not look, NOT because there are none. Read the file directly.")

    # ---- SHAPE (the denominator; never truncated)
    print()
    print("  SHAPE (all %d, never truncated):" % len(sections))
    for idx, s in enumerate(sections):
        mark = " <<" if idx in [r[0] for r in ranked] else ""
        _ind = "  " if s["kind"] == "bold" else ""
        print("    %5d-%-5d %-6s %s%s%s" % (s["start"], s["end"] or s["start"], s["kind"],
                                            _ind, s["name"][:60], mark))

    # ---- SALIENT
    shown_lines = set()
    print()
    if not question and not ranked:
        print("  SALIENT: (no --for question given; pass one to rank regions)")
    elif not ranked:
        print("  SALIENT: NO region matched the question. That is a MEASURED zero over %d section(s)"
              % len(sections))
        print("    -- the file may still contain the answer under different words. Do not read this")
        print("    as 'the file does not say'.")
    else:
        print("  SALIENT (top %d of %d scored)%s:"
              % (len(ranked), len(scores),
                 (" -- section at line %d PINNED by --at, it did NOT rank on its own"
                  % at_line) if pinned is not None else ""))
        for idx, sc in ranked:
            s = sections[idx]
            print("    [%s:%d-%d] %s   score=%.2f"
                  % (s["kind"], s["start"], s["end"] or s["start"], s["name"][:52], sc))
            body = lines[s["start"] - 1:(s["end"] or s["start"])]
            q = set(_toks(question))
            # RANK lines by overlap, do NOT take the first matches.
            # CAUGHT ON THE CLAUDE.md SPECIMEN: asked "does --force bypass a gate failure", this
            # ranked the right SECTION first and then showed lines 24/29/31 while the answer -- the
            # Rule 14a clause "--force does NOT bypass a gate FAILURE" -- sat at line 37. RIGHT
            # SECTION, WRONG LINES: the tool committing, one level down, the exact failure it exists
            # to prevent. First-match is a positional heuristic masquerading as relevance.
            _scored = []
            for n, ln in enumerate(body, s["start"]):
                lt = set(_toks(ln))
                ov = len(q & lt)
                if ov:
                    _scored.append((ov, -abs(len(ln) - 90), n, ln))
            _scored.sort(key=lambda t: (-t[0], t[1]))
            best = [(n, ln) for _o, _l, n, ln in _scored[:3]]
            # ZERO-OVERLAP SECTIONS STILL RENDER THEIR OPENING LINES.
            # DEFECT FOUND BY TRIAL-1 (0.8.0_AE_CloudComp~A, 2026-08-06): this loop emitted only
            # lines sharing a query token, and a --at PINNED section is BY DEFINITION the case where
            # that overlap is zero -- so the pin printed a header with NOTHING beneath it, exactly
            # when the user had told the tool where to look. --help promises "Excerpts are VERBATIM
            # with line numbers"; a section rendering no excerpt breaks that promise at the one
            # moment the user was most explicit.
            # Falling back to the section's first non-blank lines is honest: it is still verbatim,
            # still line-numbered, and the reader can see the pin resolved to real text.
            if not best:
                for n in range(s["start"], (s["end"] or s["start"]) + 1):
                    if n - 1 < len(lines) and lines[n - 1].strip():
                        best.append((n, lines[n - 1]))
                    if len(best) >= 3:
                        break
            # THE PINNED LINE ITSELF IS ALWAYS SHOWN, AND FIRST.
            # RESIDUAL FOUND BY TRIAL-1's POST-FIX RE-VERIFICATION (0.8.0_AE_CloudComp~A,
            # 2026-08-07): `--at 23` on a file whose line 23 IS the answer pinned the right section
            # and then excerpted lines 1/3/4 -- the section's opening DOCSTRING. Defect B was "a pin
            # renders nothing"; this is its sibling, "a pin renders the WRONG lines", and it is
            # arguably worse: nothing is visibly empty, whereas wrong prose reads as an answer.
            # --at is not a ranking hint, it is the user stating WHICH LINE THEY MEAN. Honouring the
            # section but not the line answers a question adjacent to the one asked -- the
            # ADJACENT-QUESTION failure in this tool's own docstring, committed by the tool.
            # NOT a relevance heuristic and NOT scorer tuning: it encodes nothing about what an
            # answer looks like, it obeys an explicit instruction.
            if at_line is not None and s["start"] <= at_line <= (s["end"] or s["start"]):
                if at_line - 1 < len(lines):
                    best = [(n, ln) for n, ln in best if n != at_line]
                    best.insert(0, (at_line, lines[at_line - 1]))
                    best = best[:3]
            best.sort(key=lambda t: t[0])
            for n, ln in best:
                shown_lines.add(n)
                print("        %-13s %d: %s"
                      % (_authority(full, ln, n, doc_ranges), n, _window(ln, q)))

    # ---- QUALIFIERS (the load-bearing panel)
    quals = []
    for n, ln in enumerate(lines, 1):
        m = _QUAL.search(ln)
        if m:
            quals.append((n, m.group(1).lower(), ln.strip()))
    near = quals
    if ranked and not all_quals:
        spans = [(sections[i]["start"], sections[i]["end"] or sections[i]["start"]) for i, _ in ranked]
        near = [q for q in quals if any(a - 3 <= q[0] <= b + 3 for a, b in spans)]
    print()
    print("  QUALIFIERS: %d in file | %d near your regions%s"
          % (len(quals), len(near), " (--all-quals for every one)" if not all_quals else ""))
    print("    ^ text that LIMITS / NEGATES / RETRACTS a nearby claim. This is where the")
    print("      right-file-wrong-conclusion lives: the claim gets read, this does not.")
    for n, word, ln in near[:12]:
        flag = "!!" if word in _STRONG else "  "
        shown_lines.add(n)
        print("    %s %d: %s" % (flag, n, _window(ln, set(_toks(question)) or {word})))
    if len(near) > 12:
        print("    ... %d more (--all-quals)" % (len(near) - 12))

    # ---- CONTRADICTIONS
    contras = _contradictions(full, src, lines)
    print()
    if contras:
        print("  CONTRADICTIONS (%d) -- this file disagrees with ITSELF:" % len(contras))
        for c in contras:
            shown_lines.add(c["line"])
            print("    !! %d: %s" % (c["line"], c["text"]))
            print("       documents %s() with %d arg(s); the def at :%d takes %d."
                  % (c["name"], c["claimed"], c["def_line"], c["actual"]))
    elif how.startswith("UNPARSEABLE"):
        # NOT "none detected" -- the detector needs the AST it never got. A clean-looking zero from
        # a blind instrument is the anti-correlated pass this estate keeps paying for.
        print("  CONTRADICTIONS: NOT CHECKED -- the file did not parse, so the signature detector")
        print("    could not run. This is a BLIND zero, not a measured one.")
    else:
        print("  CONTRADICTIONS: none detected (intra-file signature claims only -- a doc that")
        print("    contradicts a DIFFERENT file is out of this tool's millisecond budget).")

    # ---- UNREAD LEDGER (the behavioral forcing function)
    seen_sections = {i for i, _ in ranked}
    for n in shown_lines:
        for idx, s in enumerate(sections):
            if s["start"] <= n <= (s["end"] or s["start"]):
                seen_sections.add(idx)
    unread = [(idx, sections[idx]) for idx in range(len(sections)) if idx not in seen_sections]
    unread_ranked = sorted(unread, key=lambda t: -scores.get(t[0], 0.0))
    print()
    print("  UNREAD LEDGER: you have been shown %d of %d line(s) and %d of %d section(s)."
          % (len(shown_lines), len(lines), len(seen_sections), len(sections)))
    if unread_ranked:
        print("    NOT shown (highest-salience first) -- skipping these is now YOUR stated choice:")
        for idx, s in unread_ranked[:8]:
            print("      %5d-%-5d %s%s" % (s["start"], s["end"] or s["start"], s["name"][:56],
                                           ("   score=%.2f" % scores[idx]) if idx in scores else ""))
        if len(unread_ranked) > 8:
            print("      ... %d more section(s) unread" % (len(unread_ranked) - 8))
    else:
        print("    Every section was surfaced.")

    ms = (time.perf_counter() - t0) * 1000.0
    print()
    print("  (%.1f ms | no model, no network, no cache -- so no vintage to be stale)" % ms)
    if _comprail and _RAIL:
        try:
            _comprail.log_rail(_RAIL, "RUN-READ", "comp-read", path,
                               "sections=%d quals=%d contras=%d ms=%.1f"
                               % (len(sections), len(quals), len(contras), ms))
        except Exception:
            pass
    return 0


def _self_report(rc: int) -> None:
    """comp-read SELF-REPORTS into org/mcp/comp-tool-runs.jsonl -- the same shape comp-which uses.

    MEASURED 2026-09-02 (3.0.0_SA_CVO audit, delegated unit 1; verified here at source): comp-read
    made ZERO comp_log_auto calls and wrote ONLY the rail log. Last 30 days: 2,401 rail rows /
    0 runs.jsonl rows, so comp-pulse (reads comp-tool-runs.jsonl, comp_pulse.py:66) could not see
    the instrument CLAUDE.md Rule 21 now routes every single-file read toward.

    ADDITIVE. The RUN-READ rail writer is UNTOUCHED -- it carries serial= and attributes; this
    feeds the traffic sink only. SURFACED, NOT CHANGED HERE (out of unit-1 scope): the rail writer
    fires on the DIGEST path only -- an --enumerate run writes NO rail row (all-time 0 rows for the
    file probed). This telemetry row fires on EVERY mode, so the two sinks now disagree for
    --enumerate until the rail writer is widened by whoever owns that change.
    Never raises: a telemetry sink must never break the tool it measures.

    RULE T (PRD v0.4 s.4.4, NFRA_COMPEFFICACY CE-t-2): the subprocess.run() below is comp-read's
    ONE timeout-carrying subprocess -- the tool's own s.4 audit measured it hard-coded at
    timeout=20, invisible to a caller. comp-read carries NO corpus-width loop, so there is exactly
    ONE unit ("telemetry_call") per run; the same carrier/Clock machinery comp-find applies over a
    per-node_type loop is applied here over that single unit unchanged. The Clock is read from
    _BUDGET_STATE, NOT created fresh here -- it was started in main() before any read work, so
    remaining() below reflects the WHOLE run's elapsed time. Starting it here instead (adjacent to
    its own check, with no elapsed time between) would make the pre-flight SKIP branch below
    structurally unreachable: for a --budget as small as 0.001s, remaining() checked immediately
    after Clock() is still ~budget_s (not yet exceeded), so only subprocess.run's own
    TimeoutExpired could ever fire -- MEASURED during this cell's own build, before this fix.
    NON-APPLICATION, STATED HONESTLY: at the DEFAULT 90s budget this line is essentially
    unreachable in practice -- a comp-read run's own runtime is milliseconds, so remaining() is
    still ~90s by the time this fires; BUDGET REACHED is exercised only by a deliberately tiny
    --budget (e.g. 0.001s). ALSO NON-APPLICATION: this print happens AFTER the digest/enumerate/hud
    panels have already been printed (this subprocess is a post-hoc telemetry sink, not part of the
    answer-producing read path the way comp-find's aws pull is), so unlike comp-find's Rule T
    status it cannot print ABOVE the metrics block -- it is always the LAST thing this tool prints."""
    import subprocess
    budget_s, budget_source = _BUDGET_STATE["s"], _BUDGET_STATE["source"]
    clock = _BUDGET_STATE.get("clock")
    if budget_s is None or clock is None:
        # main() returned before resolving a budget (the --help/-h path only -- every other exit,
        # including a usage error, resolves it above). Fall back to the pre-Rule-T fixed ceiling
        # rather than invent a budget for a call that did zero read-work.
        try:
            subprocess.run(
                [sys.executable, os.path.join(_WS, "org", "modules", "graph", "comp_log_auto.py"),
                 "comp-read", " ".join(sys.argv[1:])[:200], str(rc)],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=20)
        except Exception:
            pass
        return

    quiet = _BUDGET_STATE.get("quiet")
    trailer = _BUDGET_STATE.get("trailer")
    remaining = clock.remaining()          # every timeout= derives from remaining()
    if remaining is not None and remaining <= 0:
        if not quiet:
            try:
                print("  BUDGET REACHED: %s s (%s); scanned 0 of 1 telemetry_call; results are a "
                      "PREFIX, not the answer; the self-report subprocess was SKIPPED, not run; NO "
                      "CURSOR: this is comp-read's one indivisible timeout-carrying subprocess -- "
                      "nothing to resume, only to re-run with a larger --budget."
                      % (_compbudget.fmt(budget_s), budget_source))
            except Exception:
                pass
            if trailer:
                print(trailer)
        return
    try:
        subprocess.run(
            [sys.executable, os.path.join(_WS, "org", "modules", "graph", "comp_log_auto.py"),
             "comp-read", " ".join(sys.argv[1:])[:200], str(rc)],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=remaining)
        if not quiet:
            used_s = round(clock.elapsed(), 2)
            print("  " + _compbudget.within_budget_line(1, 1, "telemetry_call", budget_s,
                                                         budget_source, used_s))
    except subprocess.TimeoutExpired:
        if not quiet:
            try:
                print("  BUDGET REACHED: %s s (%s); scanned 0 of 1 telemetry_call; results are a "
                      "PREFIX, not the answer; the self-report subprocess did not return within the "
                      "remaining budget (TimeoutExpired); NO CURSOR: this is comp-read's one "
                      "indivisible timeout-carrying subprocess -- nothing to resume, only to re-run "
                      "with a larger --budget." % (_compbudget.fmt(budget_s), budget_source))
            except Exception:
                pass
    except Exception:
        pass
    if trailer and not quiet:
        print(trailer)


if __name__ == "__main__":
    _rc = main()
    _self_report(_rc)
    raise SystemExit(_rc)
